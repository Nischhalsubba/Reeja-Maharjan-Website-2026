{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Reeja Design System",
  "version": "1.0.0",
  "description": "Token export for Figma Tokens/variables handoff. Site CSS variables remain canonical; this file is checked in CI.",
  "tokens": {
    "color": {
      "slate": {
        "800": {
          "$type": "color",
          "$value": "#304354",
          "$extensions": {
            "reeja/css-variable": "--ds-slate-800"
          }
        },
        "900": {
          "$type": "color",
          "$value": "#1C2C3A",
          "$extensions": {
            "reeja/css-variable": "--ds-slate-900"
          }
        },
        "950": {
          "$type": "color",
          "$value": "#101C29",
          "$extensions": {
            "reeja/css-variable": "--ds-slate-950"
          }
        }
      },
      "teal": {
        "600": {
          "$type": "color",
          "$value": "#2F7368",
          "$extensions": {
            "reeja/css-variable": "--ds-teal-600"
          }
        },
        "700": {
          "$type": "color",
          "$value": "#205950",
          "$extensions": {
            "reeja/css-variable": "--ds-teal-700"
          }
        }
      },
      "seafoam": {
        "100": {
          "$type": "color",
          "$value": "#EAF0F5",
          "$extensions": {
            "reeja/css-variable": "--ds-seafoam-100"
          }
        },
        "300": {
          "$type": "color",
          "$value": "#B2E9DB",
          "$extensions": {
            "reeja/css-variable": "--ds-seafoam-300"
          }
        }
      },
      "neutral": {
        "paper": {
          "$type": "color",
          "$value": "#FFFFFF",
          "$extensions": {
            "reeja/css-variable": "--ds-paper"
          }
        },
        "canvas": {
          "$type": "color",
          "$value": "#F5F8FA",
          "$extensions": {
            "reeja/css-variable": "--ds-canvas"
          }
        },
        "border": {
          "$type": "color",
          "$value": "#DAE2E8",
          "$extensions": {
            "reeja/css-variable": "--ds-border"
          }
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "#202D3D",
          "$extensions": {
            "reeja/css-variable": "--ds-ink"
          }
        },
        "secondary": {
          "$type": "color",
          "$value": "#56697B",
          "$extensions": {
            "reeja/css-variable": "--ds-muted"
          }
        },
        "inverse": {
          "$type": "color",
          "$value": "#FFFFFF",
          "$extensions": {
            "reeja/css-variable": "--ds-ink-inverse"
          }
        }
      },
      "status": {
        "success": {
          "$type": "color",
          "$value": "#206049",
          "$extensions": {
            "reeja/css-variable": "--ds-status-success"
          }
        },
        "warning": {
          "$type": "color",
          "$value": "#7D5418",
          "$extensions": {
            "reeja/css-variable": "--ds-status-warning"
          }
        },
        "error": {
          "$type": "color",
          "$value": "#A03535",
          "$extensions": {
            "reeja/css-variable": "--ds-status-error"
          }
        }
      }
    },
    "spacing": {
      "1": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "reeja/css-variable": "--s1"
        }
      },
      "2": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "reeja/css-variable": "--s2"
        }
      },
      "3": {
        "$type": "dimension",
        "$value": "24px",
        "$extensions": {
          "reeja/css-variable": "--s3"
        }
      },
      "4": {
        "$type": "dimension",
        "$value": "32px",
        "$extensions": {
          "reeja/css-variable": "--s4"
        }
      },
      "6": {
        "$type": "dimension",
        "$value": "48px",
        "$extensions": {
          "reeja/css-variable": "--s6"
        }
      },
      "8": {
        "$type": "dimension",
        "$value": "64px",
        "$extensions": {
          "reeja/css-variable": "--s8"
        }
      }
    },
    "radius": {
      "action": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "reeja/css-variable": "--ds-radius-action"
        }
      },
      "surface": {
        "$type": "dimension",
        "$value": "6px",
        "$extensions": {
          "reeja/css-variable": "--ds-radius-surface"
        }
      }
    },
    "size": {
      "targetMinimum": {
        "$type": "dimension",
        "$value": "44px",
        "$extensions": {
          "reeja/css-variable": "--ds-target-min"
        }
      }
    },
    "motion": {
      "fast": {
        "$type": "duration",
        "$value": "160ms",
        "$extensions": {
          "reeja/css-variable": "--ds-motion-fast"
        }
      },
      "standard": {
        "$type": "duration",
        "$value": "260ms",
        "$extensions": {
          "reeja/css-variable": "--ds-motion-standard"
        }
      }
    }
  }
}
