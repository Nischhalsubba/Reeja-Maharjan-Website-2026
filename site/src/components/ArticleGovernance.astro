---
import { editorialPolicy, formatEditorialDate } from '../content/editorial-policy';
import type { BlogGovernance } from '../content/blog/governance';

type Props = {
  publishedAt: string;
  updatedAt: string;
  governance: BlogGovernance;
};

const { publishedAt, updatedAt, governance } = Astro.props;
---

<section class="site-note" aria-labelledby="article-governance-title">
  <p class="site-eyebrow">About this article</p>
  <h2 id="article-governance-title">Written by Reeja, with sources and review dates shown clearly</h2>
  <dl>
    <div><dt>Author</dt><dd><a href={editorialPolicy.authorProfileUrl}>{editorialPolicy.authorName}, {editorialPolicy.authorQualification}</a></dd></div>
    <div><dt>Written for</dt><dd>{governance.audience}</dd></div>
    <div><dt>Reader goal</dt><dd>{governance.userNeed}</dd></div>
    <div><dt>Published</dt><dd>{formatEditorialDate(publishedAt)}</dd></div>
    <div><dt>Last edited</dt><dd>{formatEditorialDate(updatedAt)}</dd></div>
    <div><dt>Sources checked</dt><dd>{formatEditorialDate(governance.sourcesAccessedAt)}</dd></div>
    <div><dt>Next source review due</dt><dd>{formatEditorialDate(governance.reviewDueAt)}</dd></div>
    {governance.reviewer && (
      <div>
        <dt>Clinical reviewer</dt>
        <dd>{governance.reviewer.name}, {governance.reviewer.qualification}, {governance.reviewer.role} · {formatEditorialDate(governance.reviewer.reviewedAt)}</dd>
      </div>
    )}
  </dl>
  {!governance.reviewer && <p><strong>Clinical review status:</strong> no named independent clinical reviewer is claimed for this article.</p>}
  <p><strong>Reeja’s nursing lens:</strong> {governance.practiceLens}</p>
  <p>{editorialPolicy.safetyNote}</p>
  <p>Questions or corrections: <a href={`mailto:${editorialPolicy.correctionEmail}`}>{editorialPolicy.correctionEmail}</a></p>
</section>
