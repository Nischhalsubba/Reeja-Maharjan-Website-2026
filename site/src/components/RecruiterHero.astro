---
import { professionalFacts } from '../content/professional-facts';
import { recruiterCopy } from '../content/recruiter-copy';

const copy = recruiterCopy.hero;
---

<section class="fj-hero" id="home" aria-labelledby="home-title">
  <div class="container fj-hero__grid">
    <div class="fj-hero__content">
      <p class="fj-kicker" data-fj-hero>{copy.kicker}</p>

      <h1 id="home-title" class="fj-hero__title" data-fj-hero>
        {copy.titleBefore} <em>{copy.titleEmphasis}</em>{copy.titleAfter && ` ${copy.titleAfter}`}
      </h1>

      <p class="fj-hero__intro" data-fj-hero>{copy.intro}</p>

      <div class="fj-hero__actions" aria-label="Primary actions" data-fj-hero>
        <a class="fj-button fj-button--primary" href="/contact/" data-track="home-contact">{copy.primaryCta}</a>
        <a class="fj-button" href={professionalFacts.publicCvPath} data-track="home-cv">{copy.secondaryCta}</a>
      </div>

      <div class="fj-hero__ribbon" aria-label="Reeja Maharjan professional credentials" data-fj-hero>
        <span>{professionalFacts.nepalLicenseShort}</span>
        <span>{professionalFacts.texasLicenseShort}</span>
        <span>Open to suitable opportunities</span>
      </div>
    </div>

    <figure class="fj-portrait" data-fj-portrait>
      <div class="fj-portrait__paper" aria-hidden="true"></div>
      <div class="fj-portrait__frame">
        <img
          src="/reeja-headshot.jpg"
          alt="Reeja Maharjan, Registered Nurse and maternal-health Research Assistant, standing outdoors in Nepal"
          width="800"
          height="1000"
          sizes="(max-width: 640px) calc(100vw - 48px), (max-width: 1024px) 56vw, 410px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <span class="fj-portrait__tag" aria-hidden="true">{copy.portraitTag}</span>
      <figcaption>
        {professionalFacts.currentRole}, {professionalFacts.currentEmployerShort}<br />{professionalFacts.currentLocation}
      </figcaption>
    </figure>
  </div>
</section>
