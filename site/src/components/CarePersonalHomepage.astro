---
import { professionalFacts as facts } from '../content/professional-facts';
import BrandIcon from './BrandIcon.astro';
import { profile } from '../content/profile';
import { blogPosts } from '../content/blog';
import { getBlogImage, getBlogImageSrcSet } from '../content/blog/imagery';

const featuredSlugs = [
  'kangaroo-mother-care-who-2025-guide-parents-nurses',
  'gestational-diabetes-in-pregnancy-2026-monitoring-care',
  'mastering-nursing-documentation-sbar-handover',
];
const articles = featuredSlugs
  .map(slug => blogPosts.find(post => post.slug === slug))
  .filter((post): post is (typeof blogPosts)[number] => Boolean(post));

const experience = profile.experience;
const timeline = experience.map((item, index) => ({
  item,
  number: String(index + 1).padStart(2,'0'),
  category: index === 0 ? 'Research · maternal health' : index === 1 ? 'Maternal & newborn nursing' : index === 2 ? 'General ward nursing' : 'Maternity & theatre support',
}));
const dateLabel = (value: string) => new Date(value + 'T00:00:00Z')
  .toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric', timeZone:'UTC' });
---

<div class="cip-home rv5-home rv6-home rv7-home">
  <section class="cip-hero rv5-hero rv6-hero" id="home" aria-labelledby="cip-title">
    <div class="rv6-hero__ambient" aria-hidden="true"></div>
    <div class="cip-wrap rv5-hero__grid rv6-hero__grid">
      <div class="rv5-hero__copy rv6-hero__copy">
        <p class="rv5-eyebrow rv6-eyebrow">REGISTERED NURSE <span aria-hidden="true">/</span> MATERNAL-HEALTH RESEARCH</p>
        <h1 id="cip-title">Care is<br /><span>personal.</span></h1>
        <p class="rv6-hero__identity">Hello, I’m <strong>Reeja Maharjan.</strong></p>
        <p class="cip-hero__lead">I bring bedside nursing, family education and maternal-health research together — with a focus on clear communication and respectful care.</p>
        <div class="rv5-hero__actions rv6-hero__actions">
          <a class="rv5-button rv5-button--solid" href="#experience" data-track="home-experience">Explore my work <BrandIcon name="arrow-up-right" size={18} /></a>
          <a class="rv5-button rv5-button--outline" href="/contact/" data-track="home-contact">Get in touch <BrandIcon name="arrow-up-right" size={18} /></a>
        </div>
        <div class="rv6-hero__secondary">
          <span class="rv6-hero__place"><BrandIcon name="map-pin" size={18} /> Biratnagar, Nepal</span>
          <a href={facts.publicCvPath} class="rv6-hero__cv">View professional CV <BrandIcon name="arrow-up-right" size={18} /></a>
        </div>
      </div>
      <figure class="cip-hero__portrait rv5-hero__portrait rv6-hero__portrait">
        <div class="rv5-hero__portrait-backdrop" aria-hidden="true"></div>
        <picture>
          <source type="image/webp" srcset="/reeja-headshot-360.webp 360w, /reeja-headshot-720.webp 720w, /reeja-headshot-960.webp 960w" sizes="(max-width: 790px) 92vw, 550px" />
          <img src="/reeja-headshot.jpg" alt="Reeja Maharjan, registered nurse and research assistant" width="800" height="1000" fetchpriority="high" loading="eager" decoding="async" />
        </picture>
        <figcaption class="rv6-hero__caption"><span class="rv6-hero__caption-mark"><BrandIcon name="heart-pulse" size={23} /></span><span><strong>People first.</strong><small>Evidence-informed care.</small></span></figcaption>
      </figure>
    </div>
  </section>

  <section class="rv6-trust" aria-label="Professional background">
    <div class="cip-wrap rv6-trust__grid">
      <div><span class="rv6-trust__icon"><BrandIcon name="shield-check" size={24} /></span><p><strong>Nepal Nursing Council</strong><span>Registered Nurse · credential summary</span></p></div>
      <div><span class="rv6-trust__icon"><BrandIcon name="graduation-cap" size={24} /></span><p><strong>B.Sc. Nursing</strong><span>Tribhuvan University affiliation</span></p></div>
      <div><span class="rv6-trust__icon"><BrandIcon name="clipboard-check" size={24} /></span><p><strong>IISH · MOM-HD</strong><span>Current maternal-health research role</span></p></div>
      <a class="rv6-trust__link" href="/cv/" aria-label="View Reeja's credentials and experience">Credentials <BrandIcon name="arrow-up-right" size={18} /></a>
    </div>
  </section>

  <section class="rv6-pillars rv5-section" id="practice" aria-labelledby="rv6-practice-heading">
    <div class="cip-wrap">
      <div class="rv6-section-intro">
        <p class="rv5-eyebrow">WHAT I DO</p>
        <h2 id="rv6-practice-heading">Grounded in care.<br /><span>Driven by evidence.</span></h2>
        <p>Two connected sides of my work — practical nursing support and research that helps families navigate maternal health.</p>
      </div>
      <div class="rv6-pillars__grid">
        <article class="rv6-pillar rv6-pillar--nursing">
          <div class="rv6-pillar__symbol"><BrandIcon name="heart-pulse" size={28} /></div>
          <span class="rv6-pillar__index">01 / CLINICAL PRACTICE</span>
          <h3>Care at the bedside.</h3>
          <p>Maternal and newborn nursing, documentation, monitoring and practical counselling for patients and families.</p>
          <a href="/nursing-practice/" class="rv5-text-link">Explore nursing practice <BrandIcon name="arrow-up-right" size={18} /></a>
        </article>
        <article class="rv6-pillar rv6-pillar--research">
          <div class="rv6-pillar__symbol"><BrandIcon name="chart" size={28} /></div>
          <span class="rv6-pillar__index">02 / CLINICAL RESEARCH</span>
          <h3>Research beyond the ward.</h3>
          <p>Participant education, blood-pressure and glucose monitoring, tele-follow-up and careful study documentation.</p>
          <a href="/clinical-research/" class="rv5-text-link">Explore research work <BrandIcon name="arrow-up-right" size={18} /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="rv5-section rv5-career rv6-career" id="experience" aria-labelledby="rv5-career-heading">
    <div class="cip-wrap">
      <div class="rv5-section-header rv5-section-header--split rv6-section-head">
        <div><p class="rv5-eyebrow">THE JOURNEY SO FAR</p><h2 id="rv5-career-heading">Experience that<br />shapes my practice.</h2></div>
        <div class="rv5-section-header__aside"><p>Hospital and research roles, shown in reverse chronological order. Each experience has helped shape a more thoughtful approach to care.</p><a class="rv5-text-link" href="/cv/">Read the complete CV <BrandIcon name="arrow-up-right" size={18} /></a></div>
      </div>
      <ol class="rv6-career__timeline">
        {timeline.map(({item,number,category}) => (
          <li class="rv5-career-card rv6-career__entry">
            <div class="rv6-career__index" aria-hidden="true">{number}</div>
            <div class="rv6-career__main"><span class="rv6-career__category">{category}</span><h3>{item.role}</h3><p class="rv6-career__org">{item.organization}</p><p class="rv6-career__summary">{item.bullets[0]}</p></div>
            <div class="rv6-career__meta"><time>{item.period}</time><span>{item.location}</span></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="rv5-focus rv6-focus" id="research" aria-labelledby="rv5-focus-heading">
    <div class="rv5-focus__image rv6-focus__image">
      <img src="https://images.unsplash.com/photo-1631815587646-b85a1bb027e1?auto=format&fit=crop&w=1200&q=80" alt="Illustrative blood-pressure check, not a MOM-HD study participant" width="1200" height="900" loading="lazy" decoding="async" data-editorial-image data-fallback-src="/images/research-monitoring.svg" />
      <span class="rv5-focus__photo-credit">Illustrative photo · <a href="https://unsplash.com/photos/a-doctor-checking-the-blood-pressure-of-a-patient-XdErxxR6Xog" target="_blank" rel="noopener noreferrer">CDC / Unsplash</a></span>
      <div class="rv6-focus__photo-fallback" aria-hidden="true"><svg viewBox="0 0 160 110" fill="none" stroke="currentColor" stroke-width="2"><rect x="18" y="40" width="124" height="47" rx="6"/><path d="M27 64h23l8-14 9 31 10-20 9 3h46"/><path d="M80 40V15"/></svg></div>
    </div>
    <div class="rv5-focus__content">
      <div class="rv5-focus__inner">
        <p class="rv5-eyebrow">CURRENT RESEARCH · IISH</p>
        <h2 id="rv5-focus-heading">Turning information into better follow-up.</h2>
        <p>As a Research Assistant on the MOM-HD maternal-health telemonitoring trial, I support the processes that connect participants, home readings and the wider clinical team.</p>
        <ul class="rv5-focus__bullets">
          <li><BrandIcon name="check" size={17} /> <span>Participant screening, education and consent-workflow support</span></li>
          <li><BrandIcon name="check" size={17} /> <span>Home blood-pressure and blood-glucose monitoring guidance</span></li>
          <li><BrandIcon name="check" size={17} /> <span>Scheduled tele-follow-up and escalation within study protocols</span></li>
          <li><BrandIcon name="check" size={17} /> <span>Study documentation, device logistics and data-quality checks</span></li>
        </ul>
        <p class="rv6-focus__disclaimer">Role description, not a claim about trial outcomes.</p>
        <a class="rv5-button rv5-button--solid" href="/clinical-research/">Read about the research <BrandIcon name="arrow-up-right" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="rv5-section rv5-writing rv6-writing" id="writing" aria-labelledby="rv5-writing-heading">
    <div class="cip-wrap">
      <div class="rv5-section-header rv5-section-header--inline rv6-section-head">
        <div><p class="rv5-eyebrow">FROM MY WRITING DESK</p><h2 id="rv5-writing-heading">Care, explained clearly.</h2><p>Source-linked articles for families, nurses and learners.</p></div>
        <a class="rv5-text-link" href="/blog/">Explore all {blogPosts.length} guides <BrandIcon name="arrow-up-right" size={18} /></a>
      </div>
      <div class="rv5-writing__grid">
        {articles.map((post,index) => {
          const image=getBlogImage(post.slug);
          return <article class="rv5-writing-card rv6-writing__card">
            <div class="rv6-writing__image">
              <a href={'/blog/'+post.slug+'/'} class="rv5-writing-card__photo" aria-label={'Read '+post.title}>
                <img src={image.src} srcset={getBlogImageSrcSet(image)} sizes="(max-width: 700px) 92vw, (max-width: 1000px) 45vw, 380px" alt={image.alt} width="700" height="475" loading="lazy" decoding="async" data-editorial-image data-fallback-src={index === 0 ? "/images/newborn-care.svg" : index === 1 ? "/images/glucose-monitor.svg" : "/images/research-monitoring.svg"} />
                <span class="rv6-writing__image-fallback" aria-hidden="true">{post.tags[0] ?? 'Nursing'}</span>
              </a>
              <a class="rv5-writing-card__photo-credit" href={image.sourceUrl} target="_blank" rel="noopener noreferrer">Photo: {image.photographer} / Unsplash</a>
            </div>
            <div class="rv5-writing-card__content">
              <p class:list={['rv5-writing-card__category','rv5-writing-card__category--'+index]}>{post.tags[0] ?? 'Nursing'}</p>
              <h3><a href={'/blog/'+post.slug+'/'}>{post.title}</a></h3>
              <p class="rv6-writing__summary">{post.excerpt}</p>
              <p class="rv5-writing-card__meta">{dateLabel(post.updatedAt)} <span aria-hidden="true">·</span> {post.readMinutes} min read</p>
            </div>
          </article>;
        })}
      </div>
    </div>
  </section>

  <section class="rv5-personal rv6-personal rv7-personal" id="about" aria-labelledby="rv5-personal-heading">
    <div class="cip-wrap rv5-personal__grid rv6-personal__grid rv7-personal__grid">
      <div class="rv5-personal__copy rv7-personal__copy">
        <p class="rv5-eyebrow">A MORE PERSONAL SIDE</p>
        <h2 id="rv5-personal-heading">Behind every reading, <span>there’s a person.</span></h2>
        <p>Outside the ward and research setting, I value the quieter moments that bring perspective. They remind me why listening carefully, communicating clearly and treating people with respect matters so much in my work.</p>
        <div class="rv7-personal__signoff">
          <span class="rv7-personal__signoff-rule" aria-hidden="true"></span>
          <span><strong>Reeja Maharjan</strong><small>Registered Nurse · Research Assistant</small></span>
        </div>
        <div class="rv7-personal__actions">
          <a class="rv5-button rv5-button--solid" href="/contact/">Get in touch <BrandIcon name="arrow-up-right" size={18} /></a>
          <a class="rv5-text-link" href="/cv/">My professional journey <BrandIcon name="arrow-up-right" size={18} /></a>
        </div>
      </div>
      <figure class="rv7-personal__photo">
        <img
          src="/images/reeja-lakeside.webp"
          width="720"
          height="405"
          loading="lazy"
          decoding="async"
          alt="Reeja sitting on a balcony with a warm drink, looking towards a lake and tree-covered hills"
        />
        <figcaption>
          <span class="rv7-personal__photo-mark" aria-hidden="true">R.</span>
          <span>A moment beyond the ward<small>From Reeja’s personal collection</small></span>
        </figcaption>
      </figure>
    </div>
  </section>
</div>

<script>
  // Use locally hosted, credited-as-illustrative artwork if a remote photograph fails.
  document.querySelectorAll<HTMLImageElement>('[data-editorial-image]').forEach(img => {
    const container=img.parentElement;
    if (!container) return;
    const handleError=() => {
      const localImage=img.dataset.fallbackSrc;
      if (!localImage || img.dataset.fallbackAttempted === 'true') {
        container.classList.add('is-image-unavailable');
        return;
      }
      img.dataset.fallbackAttempted='true';
      img.removeAttribute('srcset');
      img.removeAttribute('sizes');
      img.alt='Illustration: ' + img.alt;
      img.src=localImage;
      container.classList.add('is-fallback-loaded');
    };
    img.addEventListener('error',handleError);
    if (img.complete && img.naturalWidth === 0) handleError();
  });
</script>
