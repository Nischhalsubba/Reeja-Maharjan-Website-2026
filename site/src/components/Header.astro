---
import { siteCopy } from '../content/site-copy';
import ReejaBrandMark from './ReejaBrandMark.astro';

type Props = { name: string };
const { name } = Astro.props;
const path = Astro.url.pathname;
const current = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const links = [
  { href: '/', label: 'Home' },
  { href: '/experience/', label: 'Experience' },
  { href: '/clinical-research/', label: 'Research' },
  { href: '/nursing-practice/', label: 'Nursing' },
  { href: '/blog/', label: 'Writing' },
  { href: '/cv/', label: 'CV' },
  { href: '/education/', label: 'Education' }
];
---

<header class="site-header" aria-label="Primary navigation" data-site-header>
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${name} homepage`}>
      <ReejaBrandMark />
    </a>

    <nav class="desktop-nav navlinks" aria-label="Main navigation">
      <details class="menupop"><summary>Experience <span class="menu-sign" aria-hidden="true">+</span></summary><div class="reference-mega"><p class="mega-kicker">Featured experience</p><div class="mega-grid"><a href="/clinical-research/"><img src="/images/cinematic/4c6c586bf16b.jpg" width="800" height="1204" alt="" /><strong>Clinical research</strong><small>Maternal-health telemonitoring</small></a><a href="/maternal-health/"><img src="/images/cinematic/4123471de1d5.jpg" width="1100" height="734" alt="" /><strong>Maternal health</strong><small>Maternal and newborn care</small></a><a href="/nursing-practice/"><img src="/images/cinematic/64358b3119c9.jpg" width="1100" height="753" alt="" /><strong>Nursing practice</strong><small>Hospital and general care</small></a></div><div class="mega-footer"><a href="/blog/">Journal</a><a href="/hire-reeja/">For employers</a><a class="btn" href="/experience/"><span>All experience</span><i aria-hidden="true">＋</i></a></div></div></details>
      <a href="/about/" aria-current={current('/about/') ? 'page' : undefined}>About</a>
      <a class="btn" href="/contact/" aria-current={current('/contact/') ? 'page' : undefined} data-track="contact-nav"><span>Contact</span><i aria-hidden="true">＋</i></a>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-haspopup="dialog"
      aria-label="Menu"
    >
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

</header>

<div
    class="mobile-nav"
    id="mobile-nav"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mobile-nav-title"
    aria-hidden="true"
  >
    <span
      id="mobile-nav-title"
      style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0"
    >Mobile navigation</span>
    <nav class="mobile-nav__panel" aria-label="Mobile navigation links">
      <div class="mobile-nav__head">
        <div>
          <span class="mobile-nav__eyebrow">{name}</span>
          <strong>Professional profile</strong>
          <small>{siteCopy.siteDescriptor}</small>
        </div>
        <button class="mobile-nav__close" type="button" data-mobile-nav-close aria-label="Close menu">
          <span aria-hidden="true"></span>
        </button>
      </div>
      {links.map((link) => (
        <a href={link.href} aria-current={link.href !== '/#experience' && current(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a href="/about/" aria-current={current('/about/') ? 'page' : undefined}>About</a>
      <a href="/maternal-health/" aria-current={current('/maternal-health/') ? 'page' : undefined}>Maternal health</a>
      <a href="/contact/" aria-current={current('/contact/') ? 'page' : undefined}>Contact</a>
      <a class="mobile-nav__cta" href="/hire-reeja/" aria-current={current('/hire-reeja/') ? 'page' : undefined} data-track="hire-mobile-nav">
        Hire Reeja
      </a>
    </nav>
  </div>
