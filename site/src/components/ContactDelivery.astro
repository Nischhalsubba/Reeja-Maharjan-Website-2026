---
import { professionalFacts } from '../content/professional-facts';
---
<div class="contact-delivery" data-contact-delivery>
  <p class="form-status contact-delivery-status" data-delivery-status role="status" aria-live="polite" hidden></p>
  <a class="contact-fallback-link" data-delivery-fallback href={`mailto:${professionalFacts.professionalEmail}`} hidden>Email this completed message directly</a>
  <noscript><p>Enable JavaScript to send this form, or <a href={`mailto:${professionalFacts.professionalEmail}`}>email Reeja directly</a>.</p></noscript>
</div>
<script>
  import { initContactDelivery } from '../lib/contactDelivery';
  initContactDelivery();
</script>
