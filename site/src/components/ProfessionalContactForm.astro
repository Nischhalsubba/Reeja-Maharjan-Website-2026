---
import { professionalFacts } from '../content/professional-facts';

const directEmailHref = `mailto:${professionalFacts.professionalEmail}?subject=${encodeURIComponent(`Professional opportunity for ${professionalFacts.name}`)}`;
const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
---

<form
  class="professional-contact-form"
  id="professional-contact-form"
  method="POST"
  action={turnstileSitekey ? '/api/contact' : professionalFacts.contactFormEndpoint}
  data-secure={turnstileSitekey ? 'true' : 'false'}
  data-contact-form
  aria-labelledby="contact-form-title"
>
  <div class="professional-contact-form__heading">
    <p class="site-eyebrow">Professional inquiry</p>
    <h2 id="contact-form-title">Send a message to Reeja.</h2>
    <p>Share the opportunity and your contact details. Required fields are marked with an asterisk.</p>
  </div>

  <div class="professional-contact-form__grid">
    <div class="form-field">
      <label for="contact-name">Your name <span aria-hidden="true">*</span></label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="120" aria-describedby="contact-name-error" />
      <p class="form-field__error" id="contact-name-error" data-error-for="contact-name" role="alert" hidden></p>
    </div>

    <div class="form-field">
      <label for="contact-email">Your email <span aria-hidden="true">*</span></label>
      <input id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" required maxlength="254" aria-describedby="contact-email-error" />
      <p class="form-field__error" id="contact-email-error" data-error-for="contact-email" role="alert" hidden></p>
    </div>

    <div class="form-field">
      <label for="contact-organisation">Organisation / hospital</label>
      <input id="contact-organisation" name="organization" type="text" maxlength="160" autocomplete="organization" placeholder="Organisation, hospital, university, NGO, or INGO" />
    </div>

    <div class="form-field">
      <label for="contact-role">Role / opportunity</label>
      <input id="contact-role" name="role_type" type="text" maxlength="160" placeholder="Staff nurse role, research project, health programme…" />
    </div>

    <div class="form-field professional-contact-form__full">
      <label for="contact-location">Location</label>
      <input id="contact-location" name="location" type="text" maxlength="160" autocomplete="address-level2" placeholder="City, country, or remote/hybrid" />
    </div>

    <div class="form-field professional-contact-form__full">
      <label for="contact-message">Message <span aria-hidden="true">*</span></label>
      <textarea
        id="contact-message"
        name="message"
        rows="7"
        required
        minlength="20"
        maxlength="5000"
        aria-describedby="contact-message-help contact-message-error"
        placeholder="Role or project, responsibilities, timing, and preferred next step."
      ></textarea>
      <p class="form-field__help" id="contact-message-help">A short opportunity summary is enough.</p>
      <p class="form-field__error" id="contact-message-error" data-error-for="contact-message" role="alert" hidden></p>
    </div>
  </div>

  <input type="hidden" name="_subject" value="Professional inquiry for Reeja Maharjan from reejamaharjan.com.np" />
  <input type="hidden" name="_template" value="table" />
  {!turnstileSitekey && <input type="hidden" name="_captcha" value="false" />}
  <input type="hidden" name="_url" value="https://reejamaharjan.com.np/contact/" />
  <input class="form-honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

  {turnstileSitekey && (
    <div class="professional-contact-form__full" data-contact-verification>
      <p class="form-field__help">Spam protection</p>
      <div class="cf-turnstile" data-sitekey={turnstileSitekey} data-action="professional_contact"></div>
      <p class="form-field__help">Please complete verification before sending your message.</p>
    </div>
  )}
  <div class="professional-contact-form__privacy">
    <strong>Privacy</strong>
    {turnstileSitekey ? (
      <p>This inquiry is checked by Cloudflare Turnstile and submitted to an email delivery provider. An accepted submission is not a guarantee of inbox receipt. Do not send patient records, identity documents, licence scans or sensitive health information.</p>
    ) : (
      <p>This message is processed by <a href="https://formsubmit.co/" target="_blank" rel="noopener noreferrer">FormSubmit</a>, an external delivery service. Messages are sent through its form API without leaving this page. Delivery is subject to spam protections and service limits. Please do not share patient records, identity documents, licence scans or other sensitive information.</p>
    )}
  </div>

  <div class="professional-contact-form__actions">
    <button class="care-button care-button--primary" type="submit" data-submit-button>
      <span data-submit-label>Send to Reeja</span>
      <span class="form-spinner" aria-hidden="true" hidden data-submit-spinner></span>
    </button>
    <a class="care-button care-button--secondary" href={directEmailHref} data-track="contact-email-fallback">Email Reeja</a>
  </div>

  <div class="professional-contact-form__status" aria-live="polite" aria-atomic="true">
    <p class="form-status form-status--loading" role="status" hidden data-form-loading>Sending…</p>
    <div class="form-status form-status--success" role="status" tabindex="-1" hidden data-form-success>
      <strong>Your message was accepted for delivery.</strong>
      <p>Reeja can reply by email when appropriate. Please don't resend unless you need to add information.</p>
    </div>
    <div class="form-status form-status--error" role="alert" tabindex="-1" hidden data-form-error>
      <strong>We couldn't confirm your message was delivered.</strong>
      <p>The service may have accepted it even if confirmation was interrupted. Please check by <a href={directEmailHref}>emailing Reeja</a> before retrying to avoid duplicates. Your details are still in the form.</p>
    </div>
  </div>
  <noscript><p class="form-status">JavaScript is required to send this form without leaving the website. You can instead use <a href={directEmailHref}>Email Reeja</a>.</p></noscript>
</form>

{turnstileSitekey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit-button]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const submitSpinner = form.querySelector<HTMLElement>('[data-submit-spinner]');
    const loadingStatus = form.querySelector<HTMLElement>('[data-form-loading]');
    const successStatus = form.querySelector<HTMLElement>('[data-form-success]');
    const errorStatus = form.querySelector<HTMLElement>('[data-form-error]');
    let submitting = false;
    const secureMode = form.dataset.secure === 'true';
    const resetChallenge = () => {
      if (secureMode) (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
    };

    const fieldMessage = (field: HTMLInputElement | HTMLTextAreaElement): string => {
      if (field.validity.valueMissing) return 'Please complete this field.';
      if (field.validity.typeMismatch && field.type === 'email') return 'Enter a valid email address.';
      if (field.validity.tooShort) {
        return 'Please enter at least ' + field.minLength + ' characters.';
      }
      return 'Please check this field.';
    };

    const showFieldError = (field: HTMLInputElement | HTMLTextAreaElement): boolean => {
      const error = form.querySelector<HTMLElement>('[data-error-for="' + field.id + '"]');
      const valid = field.validity.valid;
      if (error) {
        error.hidden = valid;
        error.textContent = valid ? '' : fieldMessage(field);
      }
      if (valid) field.removeAttribute('aria-invalid');
      else field.setAttribute('aria-invalid', 'true');
      return valid;
    };

    const validatedFields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]')
    );

    validatedFields.forEach((field) => {
      field.addEventListener('invalid', () => showFieldError(field));
      field.addEventListener('blur', () => showFieldError(field));
      field.addEventListener('input', () => {
        if (field.hasAttribute('aria-invalid')) showFieldError(field);
      });
    });

    const setStatus = (state: 'idle' | 'loading' | 'success' | 'error') => {
      [loadingStatus, successStatus, errorStatus].forEach((element) => {
        if (element) element.hidden = true;
      });
      if (state === 'loading' && loadingStatus) loadingStatus.hidden = false;
      if (state === 'success' && successStatus) {
        successStatus.hidden = false;
        successStatus.focus();
      }
      if (state === 'error' && errorStatus) {
        errorStatus.hidden = false;
        errorStatus.focus();
      }
    };

    const setSubmitting = (active: boolean) => {
      submitting = active;
      if (!submitButton) return;
      submitButton.disabled = active;
      submitButton.toggleAttribute('aria-busy', active);
      if (submitLabel) submitLabel.textContent = active ? 'Sending…' : 'Send to Reeja';
      if (submitSpinner) submitSpinner.hidden = !active;
    };

    form.addEventListener('submit', async (event) => {
      // Never navigate to the third-party CAPTCHA or thank-you page.
      event.preventDefault();
      if (submitting) return;
      setStatus('idle');

      const firstInvalid = validatedFields.find((field) => !showFieldError(field));
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }
      const honeypot = form.elements.namedItem('_honey');
      if (honeypot instanceof HTMLInputElement && honeypot.value) {
        setStatus('error');
        return;
      }

      const payload = Object.fromEntries(new FormData(form).entries());
      // The provider documents a dedicated JSON AJAX endpoint and _captcha=false.
      // Retain the honeypot and never mistake its JSON string "false" for success.
      delete payload._next;
      const endpoint = new URL(form.action);
      if (secureMode) {
        if (!payload['cf-turnstile-response']) {
          setStatus('error');
          return;
        }
      } else {
        endpoint.pathname = '/ajax' + endpoint.pathname;
      }
      setSubmitting(true);
      setStatus('loading');
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 15000);
      try {
        const response = await fetch(endpoint.toString(), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload),
          signal: controller.signal
        });
        if (!response.ok) throw new Error('Form service unavailable');
        const result: unknown = await response.json();
        const confirmed = typeof result === 'object' && result !== null &&
          'success' in result && (result.success === true || result.success === 'true');
        if (!confirmed) throw new Error('Provider did not confirm submission');
        form.reset();
        validatedFields.forEach((field) => field.removeAttribute('aria-invalid'));
        setStatus('success');
        resetChallenge();
      } catch {
        // Keep entered data for a retry or the direct-email fallback.
        setStatus('error');
        resetChallenge();
      } finally {
        window.clearTimeout(timeout);
        setSubmitting(false);
      }
    });

    window.addEventListener('pageshow', () => setSubmitting(false));
  }
</script>
