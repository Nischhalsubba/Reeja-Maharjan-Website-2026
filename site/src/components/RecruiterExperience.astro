---
import { profile } from '../content/profile';
import { professionalFacts } from '../content/professional-facts';
import { recruiterCopy } from '../content/recruiter-copy';

const selectedExperience = profile.experience.slice(0, 3);
const copy = recruiterCopy.experience;
---

<section class="fj-section fj-section--indigo" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <header class="fj-section__head" data-fj-reveal>
      <p class="fj-kicker">{copy.kicker}</p>
      <div>
        <h2 id="experience-title">{copy.title}</h2>
        <p>{copy.summary}</p>
      </div>
    </header>

    <ol class="fj-log" data-fj-group>
      {selectedExperience.map((item) => (
        <li class="fj-log__entry" data-fj-reveal>
          <div class="fj-log__date"><time>{item.period}</time></div>
          <div class="fj-log__role">
            <p>{item.organization}</p>
            <h3>{item.role}</h3>
            <span>{item.location}</span>
          </div>
          <div class="fj-log__copy">
            <p>{item.bullets[0]}</p>
            {item.tags && <p class="fj-log__terms">{item.tags.slice(0, 3).join(' · ')}</p>}
          </div>
        </li>
      ))}
    </ol>

    <div style="margin-top: var(--fj-space-5)" data-fj-reveal>
      <a class="fj-link" style="color: var(--fj-surface)" href={professionalFacts.publicCvPath}>{copy.cta}</a>
    </div>
  </div>
</section>
