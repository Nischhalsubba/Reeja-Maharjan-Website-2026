---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts } from '../../content/blog';
import { siteCopy } from '../../content/site-copy';
import { articleMatchesBlogTopic, blogTopics } from '../../content/blog/topics';

const copy = siteCopy.blog;
const formatDate = (value: string) =>
  new Date(value).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const featuredPost = blogPosts[0];
const articleList = featuredPost ? blogPosts.filter((post) => post.slug !== featuredPost.slug) : blogPosts;
const topicGroups = blogTopics.map((topic) => ({
  ...topic,
  href: `/blog/topics/${topic.slug}/`,
  count: blogPosts.filter((post) => articleMatchesBlogTopic(post, topic)).length
}));
import EditorialPhoto from '../../components/EditorialPhoto.astro';
import BlogPhoto from '../../components/BlogPhoto.astro';
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="site-page blog-index">
    <section class="site-page__hero blog-index__hero">
      <div class="container site-page__hero-grid blog-index__hero-grid">
        <div class="blog-index__hero-copy">
          <p class="site-eyebrow">{copy.eyebrow}</p>
          <h1>{copy.heading}</h1>
          <p class="site-page__lede">{copy.lede}</p>
          <div class="blog-index__hero-actions">
            <a class="site-button site-button--primary" href="#featured-writing">Explore featured writing <span aria-hidden="true">↗</span></a>
            <a class="blog-index__hero-link" href="#all-writing">Browse every article <span aria-hidden="true">↓</span></a>
          </div>
          <p class="blog-index__hero-kicker">Maternal health <span aria-hidden="true">·</span> Nursing practice <span aria-hidden="true">·</span> Research</p>
        </div>
        <div class="blog-index__hero-visual">
          <EditorialPhoto kind="writing" label="Stories grounded in care" compact />
          <div class="blog-index__hero-counter"><strong>{blogPosts.length}</strong><span>Evidence-informed guides<br/>Written by Reeja</span></div>
        </div>
      </div>
    </section>

    <section class="site-section blog-index__content" id="featured-writing">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">{copy.hubEyebrow}</p><h2>{copy.hubHeading}</h2></div>
          <p>{copy.hubSummary}</p>
        </div>

        <div class="blog-index__featured" data-ledger-group>
          {featuredPost && (
            <article class="blog-index__lead-card" data-ledger-reveal>
              <BlogPhoto slug={featuredPost.slug} variant="featured" />
              <div class="blog-index__lead-content">
                <p class="site-eyebrow">Featured article by Reeja</p>
                <h3><a href={`/blog/${featuredPost.slug}/`}>{featuredPost.title}</a></h3>
                <p>{featuredPost.excerpt}</p>
                <div class="blog-index__lead-bottom">
                  <p class="blog-card__meta"><span>Updated {formatDate(featuredPost.updatedAt)}</span><span>{featuredPost.readMinutes} min read</span></p>
                  <a class="blog-index__read-link" href={`/blog/${featuredPost.slug}/`}>Read the article <span aria-hidden="true">↗</span></a>
                </div>
              </div>
            </article>
          )}

          <aside class="blog-topic-panel" aria-labelledby="blog-topic-title" data-ledger-reveal>
            <p class="site-eyebrow">Browse by topic</p>
            <h3 id="blog-topic-title">Explore Reeja’s writing.</h3>
            {topicGroups.map((topic) => (
              <div class="blog-topic-panel__item">
                <span class="blog-topic-panel__count">{String(topic.count).padStart(2, '0')}</span>
                <div>
                  <h4><a href={topic.href}>{topic.label}</a></h4>
                  <p>{topic.summary}</p>
                </div>
              </div>
            ))}
          </aside>
        </div>

        <div class="site-section__head" id="all-writing">
          <div><p class="site-eyebrow">{copy.allEyebrow}</p><h2>{copy.allHeading}</h2></div>
          <p>Every article identifies Reeja as the author and keeps sources, update dates, audience, and safety information visible.</p>
        </div>

        <div class="blog-grid" data-ledger-group>
          {articleList.map((post) => (
            <article class="blog-card" data-ledger-reveal>
              <BlogPhoto slug={post.slug} variant="card" />
              <div class="blog-card__content">
                <p class="site-eyebrow">{post.tags[0]} · By Reeja Maharjan</p>
                <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
                <p>{post.excerpt}</p>
              </div>
              <p class="blog-card__meta"><span>Updated {formatDate(post.updatedAt)}</span><span>{post.readMinutes} min read</span></p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
