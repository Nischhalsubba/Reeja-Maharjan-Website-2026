---
import BaseLayout from '../layouts/BaseLayout.astro';
import { professionalFacts as facts } from '../content/professional-facts';
---
<BaseLayout title="Nursing Education & MA Rural Development | Reeja Maharjan" description="Explore Reeja Maharjan’s B.Sc. Nursing background and ongoing MA Rural Development studies at Tribhuvan University, Degree Campus, Biratnagar, Nepal.">
  <div class="site-page reference-education">
    <section class="site-page__hero"><div class="container site-page__split"><div><p class="site-eyebrow">Education and lifelong learning</p><h1>From nursing<br />to rural development.</h1><p class="site-page__lede">Reeja Maharjan is a registered nurse pursuing postgraduate studies in rural development in Biratnagar, Nepal.</p></div><dl class="site-page__summary"><div><dt>Completed</dt><dd>B.Sc. Nursing</dd></div><div><dt>Current studies</dt><dd>{facts.currentStudy}</dd></div><div><dt>Campus</dt><dd>{facts.studyCampus}</dd></div><div><dt>Status</dt><dd>{facts.studyStatus}</dd></div></dl></div></section>
    <section class="site-section reference-story"><div class="container reference-story-grid"><div><p class="site-eyebrow">Academic journey</p><h2>Two disciplines.<br />One public-service focus.</h2></div><ol class="reference-timeline"><li><h3>B.Sc. Nursing</h3><p>My completed nursing education provides the foundation for hospital nursing, patient communication and professional development.</p><a href="/cv/">View my professional qualifications →</a></li><li><h3>MA Rural Development</h3><p>I am studying at Degree Campus, Tribhuvan University. I passed the first semester and am currently in the second semester. The master's degree is in progress.</p><a href={facts.studyProgramUrl} rel="noopener">Official programme information →</a></li><li><h3>Connecting the disciplines</h3><p>My interest is in understanding how geography, access to services, local institutions and community needs shape the experience of healthcare. My clinical and research roles offer a practical perspective on these questions.</p></li></ol></div></section>
    <section class="site-section"><div class="container"><div class="site-section__head"><div><p class="site-eyebrow">Professional context</p><h2>Learning with purpose.</h2></div><p>These are areas of interest, not claims of completed research or independent specialist expertise.</p></div><div class="site-grid"><a class="site-card" href="/nursing-practice/"><h3>Nursing practice</h3><p>Patient communication, hospital experience and continuity of care.</p></a><a class="site-card" href="/clinical-research/"><h3>Maternal-health research</h3><p>Participant education, follow-up and study documentation.</p></a><a class="site-card" href="/hire-reeja/"><h3>Community-oriented opportunities</h3><p>Explore my professional background and discuss suitable roles.</p></a></div></div></section>
  </div>
</BaseLayout>
