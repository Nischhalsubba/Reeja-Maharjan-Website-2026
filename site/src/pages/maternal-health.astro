---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPosts } from '../content/blog';
import { siteCopy } from '../content/site-copy';

const copy = siteCopy.maternalHealth;
const posts = blogPosts.filter((post) =>
  [post.primaryKeyword, ...post.supportingKeywords, ...post.tags]
    .join(' ')
    .toLowerCase()
    .match(/maternal|newborn|postnatal|breastfeeding|pregnan|mother/)
).slice(0, 3);
import EditorialPhoto from '../components/EditorialPhoto.astro';
import BrandAction from '../components/design-system/BrandAction.astro';
import BrandCard from '../components/design-system/BrandCard.astro';
import EvidenceList from '../components/design-system/EvidenceList.astro';
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">Maternal health</p>
          <h1>Maternal &amp; newborn <em>nursing in Nepal.</em></h1>
          <p class="site-page__lede">From maternal-newborn care in hospital to pregnancy telemonitoring research, my work connects patient and family education, monitoring support and follow-up.</p>
        </div>
        <EvidenceList items={copy.summary.map(([label, value]) => ({ label, value }))} />
      </div>
    </section>
    <EditorialPhoto kind="nepal" label="Maternal health and community care in Nepal" />

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Selected writing</p><h2>Pregnancy, postnatal and newborn-care articles.</h2></div>
          <p>Three practical, source-linked reads from Reeja.</p>
        </div>
        <div class="site-grid">
          {posts.map((post) => (
            <BrandCard>
              <p class="site-eyebrow">By Reeja Maharjan · {post.readMinutes} min read</p>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <p><a href={`/blog/${post.slug}/`}>Read article</a></p>
            </BrandCard>
          ))}
        </div>
        <p><a href="/blog/">View all writing by Reeja</a></p>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Professional work</p><h2>Explore Reeja’s maternal-health research.</h2><p>Review her current research role, clinical background, and credentials.</p></div>
        <div class="site-actions"><BrandAction href="/clinical-research/">Research experience</BrandAction><BrandAction href="/contact/">Contact Reeja</BrandAction></div>
      </div>
    </section>
  </div>
</BaseLayout>
