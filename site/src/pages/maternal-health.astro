---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPosts } from '../content/blog';
import { siteCopy } from '../content/site-copy';

const copy = siteCopy.maternalHealth;
const posts = blogPosts.filter((post) =>
  [post.primaryKeyword, ...post.supportingKeywords, ...post.tags]
    .join(' ')
    .toLowerCase()
    .match(/maternal|newborn|postnatal|breastfeeding|pregnan|mother/)
).slice(0, 3);
import EditorialPhoto from '../components/EditorialPhoto.astro';
import BrandAction from '../components/design-system/BrandAction.astro';
import BrandCard from '../components/design-system/BrandCard.astro';
import EvidenceList from '../components/design-system/EvidenceList.astro';
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="site-page">
    <section class="site-page__hero reference-case-hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">Maternal health</p>
          <h1>Maternal and newborn <em>nursing in Nepal.</em></h1>
          <p class="reference-case-tags">Hospital nursing · Family education · Follow-up</p>
          <p class="site-page__lede">My work spans maternal-newborn hospital care and pregnancy telemonitoring research. I support clear education for families, home-monitoring guidance and structured follow-up within my assigned roles.</p>
        </div>

      </div>
    </section>
    <section class="site-section site-section--dark reference-case-overview" id="overview" aria-labelledby="overview-heading">
      <div class="container reference-case-overview-grid">
        <div><p class="site-eyebrow">Overview</p><h2 id="overview-heading">Supporting mothers and families.</h2><p>My experience in the birthing ward at Tribhuvan University Teaching Hospital and maternity care at Sindhuli Hospital informs my interest in family education, continuity of care and respectful communication.</p><p><a href="/clinical-research/">Explore my maternal-health research role →</a></p></div>
        <EvidenceList items={copy.summary.map(([label, value]) => ({ label, value }))} />
      </div>
    </section>
    <EditorialPhoto kind="maternal" label="Maternal health and newborn care" />

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Selected writing</p><h2>Pregnancy, postnatal care and newborn health.</h2></div>
          <p>Explore source-linked articles about maternal health and caring for newborns. These resources support learning, not individual medical decisions.</p>
        </div>
        <div class="site-grid">
          {posts.map((post) => (
            <BrandCard>
              <p class="site-eyebrow">By Reeja Maharjan · {post.readMinutes} min read</p>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <p><a href={`/blog/${post.slug}/`}>Read article</a></p>
            </BrandCard>
          ))}
        </div>
        <p><a href="/blog/">View all writing by Reeja</a></p>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Professional work</p><h2>My maternal-health research experience.</h2><p>Review her current research role, clinical background, and credentials.</p></div>
        <div class="site-actions"><BrandAction href="/clinical-research/">Explore research role</BrandAction><BrandAction href="/contact/">Contact Reeja</BrandAction></div>
      </div>
    </section>
  </div>
</BaseLayout>
