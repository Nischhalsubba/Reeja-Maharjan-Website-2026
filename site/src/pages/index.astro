---
import BaseLayout from '../layouts/BaseLayout.astro';
import homepage from '../components/CinematicHomepage.html?raw';
import { siteCopy } from '../content/site-copy';
---

<BaseLayout title={siteCopy.home.title} description={siteCopy.home.description}>
  <Fragment set:html={homepage} />
  <section class="section light" id="education"><div class="wrap split"><div class="sticky"><div class="kicker">Continuing education</div><h2>Care meets<br />community development.</h2><a class="btn yellow" href="/education/"><span>Explore my education</span><i aria-hidden="true">+</i></a></div><div><h3>MA Rural Development · Tribhuvan University</h3><p>I am studying at Degree Campus, Biratnagar. I passed my first semester and am now in semester two. My postgraduate studies complement my nursing background and interest in how communities access healthcare.</p><p>My completed qualification is B.Sc. Nursing. My MA is still in progress.</p><a href="/cv/">View my full professional profile →</a></div></div></section>
</BaseLayout>
