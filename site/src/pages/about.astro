---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../content/profile';
import { professionalFacts } from '../content/professional-facts';
const practiceAreas = [
  { title: 'Nursing practice', description: 'Hospital nursing and patient support.', href: '/nursing-practice/', image: '/images/cinematic/64358b3119c9.jpg' },
  { title: 'Maternal health', description: 'Care for mothers and newborns.', href: '/maternal-health/', image: '/images/cinematic/4123471de1d5.jpg' },
  { title: 'Clinical research', description: 'Participant education and study coordination.', href: '/clinical-research/', image: '/images/cinematic/4c6c586bf16b.jpg' }
];
---
<BaseLayout title="About Reeja Maharjan | Registered Nurse in Nepal" description="Meet Reeja Maharjan, her nursing education, hospital experience and maternal-health research journey in Nepal.">
  <div class="site-page reference-about">
    <section class="reference-about-hero site-page__hero">
      <div class="container reference-about-grid">
        <div><p class="site-eyebrow">About Reeja</p><h1>Care, research and<br />patient education.</h1><p class="site-page__lede">I’m Reeja Maharjan, a registered nurse based in Biratnagar, working across hospital nursing and maternal-health research.</p><p>{professionalFacts.currentLocation} · B.Sc. Nursing</p></div>
        <figure class="reference-about-portrait"><img src="/images/reeja-clinical-portrait-2026.jpg" alt="Reeja Maharjan in nursing scrubs with a stethoscope" width="800" height="1600" /></figure>
      </div>
    </section>
    <section class="site-section reference-story" id="journey"><div class="container reference-story-grid"><div class="reference-story-heading"><p class="site-eyebrow">My journey</p><h2>Learning through care.<br />One role at a time.</h2><a class="site-button" href="/cv/">View professional CV</a></div><ol class="reference-timeline">{profile.experience.slice().reverse().map(item=><li><p class="site-eyebrow">{item.period}</p><h3>{item.role}</h3><p>{item.organization}</p><ul>{item.bullets.map(bullet=><li>{bullet}</li>)}</ul></li>)}</ol></div></section>
    <section class="site-section" id="practice">
      <div class="container">
        <div class="site-section__head"><div><p class="site-eyebrow">Areas of practice</p><h2>From the ward to the community.</h2></div></div>
        <div class="site-grid reference-practice-grid">
          {practiceAreas.map((area, index) => <a class="site-card reference-practice-card" href={area.href}>
            <div class="reference-practice-image"><img src={area.image} width="800" height="500" alt="" loading="lazy" /></div>
            <div class="reference-practice-copy"><span class="reference-practice-index">0{index+1} / Practice</span><h3>{area.title}</h3><p>{area.description}</p><span class="reference-practice-link">Explore practice <span aria-hidden="true">＋</span></span></div>
          </a>)}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
