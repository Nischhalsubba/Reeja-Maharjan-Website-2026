---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/design-system-lab.css';
import BrandAction from '../../components/design-system/BrandAction.astro';
import BrandCard from '../../components/design-system/BrandCard.astro';
import EvidenceList from '../../components/design-system/EvidenceList.astro';
import Eyebrow from '../../components/design-system/Eyebrow.astro';

const swatches = [
  { name: 'Ink', hex: '#17191A', token: '--ds-ink' },
  { name: 'Graphite', hex: '#313536', token: '--ds-slate-900' },
  { name: 'Muted', hex: '#505957', token: '--ds-muted' },
  { name: 'Canvas', hex: '#FAFAF8', token: '--ds-canvas' },
  { name: 'Stone', hex: '#ECEBE7', token: '--ds-seafoam-100' },
  { name: 'Border', hex: '#D9DBD7', token: '--ds-border' },
  { name: 'Paper', hex: '#FFFFFF', token: '--ds-paper' },
  { name: 'Soft graphite', hex: '#505957', token: '--ds-slate-800' },
  { name: 'Action', hex: '#313536', token: '--ds-teal-600' },
  { name: 'Action hover', hex: '#202425', token: '--ds-teal-700' },
  { name: 'Success text', hex: '#206049', token: '--ds-status-success' },
  { name: 'Error text', hex: '#A03535', token: '--ds-status-error' }
];
const sectionLinks = [
  ['#colors', 'Colors'], ['#typography', 'Typography'], ['#components', 'Components'],
  ['#forms', 'Forms'], ['#spacing', 'Spacing'], ['#principles', 'Principles']
];
const proofExamples = [
  { label: 'Licensure', value: 'Nepal Nursing Council · Registered Nurse' },
  { label: 'Professional experience', value: 'Hospital nursing & maternal-health research' },
  { label: 'Verification', value: 'Credential documents shared privately on request' }
];
---

<BaseLayout
  title="Reeja Design System v11 | Neutral editorial foundations"
  description="The neutral editorial design system for Reeja Maharjan's professional nursing and maternal-health research website."
  robots="noindex, follow"
>
  <div class="ds-lab">
    <header class="ds-lab__hero">
      <div class="ds-lab__wrap ds-lab__hero-content">
        <p class="ds-lab__eyebrow">REEJA DESIGN SYSTEM / VERSION 11.0.0</p>
        <h1>Care is <em>personal.</em> Design should be, too.</h1>
        <p>A living reference for the typography, color, components and interaction rules behind Reeja Maharjan's nursing and research portfolio. Built as native Astro components.</p>
      </div>
    </header>

    <div class="ds-lab__wrap">
      <nav class="ds-lab__nav" aria-label="Design system sections">
        {sectionLinks.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>

      <section id="colors" class="ds-lab__section" aria-labelledby="ds-colors-title">
        <div class="ds-lab__section-head">
          <h2 id="ds-colors-title">Color with <em>intent.</em></h2>
          <p>Off-white and graphite carry the brand. Stone provides subtle section distinction; dark charcoal defines actions. Color never replaces content hierarchy or accessible contrast.</p>
        </div>
        <div class="ds-lab__swatches">
          {swatches.map(color => (
            <div class="ds-lab__swatch">
              <div class="ds-lab__swatch-color" style={`--swatch:var(${color.token})`} aria-hidden="true"></div>
              <div class="ds-lab__swatch-body">
                <strong>{color.name}</strong>
                <small>{color.hex}</small>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="typography" class="ds-lab__section" aria-labelledby="ds-type-title">
        <div class="ds-lab__section-head">
          <h2 id="ds-type-title">A quiet, editorial <em>voice.</em></h2>
          <p>Use Georgia for expressive, human headlines and self-hosted Public Sans for body copy, metadata and controls. No additional font dependencies.</p>
        </div>
        <div class="ds-lab__type"><span>Display / Georgia</span><p class="ds-lab__type-display">Reeja Maharjan. Registered Nurse.</p></div>
        <div class="ds-lab__type"><span>Section / Georgia</span><p class="ds-lab__type-heading">Experience, evidence and empathy.</p></div>
        <div class="ds-lab__type"><span>Body / Public Sans</span><p class="ds-lab__type-body">Clinical nursing and maternal-health research call for clarity, accurate information and genuine human connection. Design should support these goals without unnecessary decoration.</p></div>
        <div class="ds-lab__type"><span>Eyebrow / Public Sans</span><Eyebrow>Research, education and practice</Eyebrow></div>
      </section>

      <section id="components" class="ds-lab__section" aria-labelledby="ds-components-title">
        <div class="ds-lab__section-head">
          <h2 id="ds-components-title">A small set of <em>dependable pieces.</em></h2>
          <p>Components are semantic, responsive, keyboard-accessible and reused by the live research, nursing, maternal health and hiring pages.</p>
        </div>
        <div class="ds-lab__canvas">
          <h3>Actions · primary, secondary, text and disabled</h3>
          <div class="ds-lab__actions">
            <BrandAction variant="primary" href="/contact/">Discuss an opportunity</BrandAction>
            <BrandAction href="/cv/">View CV</BrandAction>
            <BrandAction variant="text" href="/clinical-research/">Explore research ↗</BrandAction>
            <BrandAction disabled>Not available</BrandAction>
          </div>
        </div>
        <div class="ds-lab__canvas ds-lab__canvas--dark site-section--dark">
          <h3>Actions within a neutral section</h3>
          <div class="ds-lab__actions">
            <BrandAction href="/contact/">Contact Reeja</BrandAction>
            <BrandAction variant="text" href="/cv/">View credentials</BrandAction>
          </div>
        </div>
        <div class="ds-lab__grid">
          <BrandCard>
            <Eyebrow>Nursing</Eyebrow>
            <h3>Clinical practice</h3>
            <p>Compassionate care, clear communication, documentation and structured handover.</p>
            <a href="/nursing-practice/">Explore nursing</a>
          </BrandCard>
          <BrandCard variant="soft">
            <Eyebrow>Research</Eyebrow>
            <h3>Maternal health</h3>
            <p>Supporting screening, education, home-monitoring and protocol follow-up.</p>
            <a href="/clinical-research/">Explore research</a>
          </BrandCard>
          <BrandCard variant="outlined">
            <Eyebrow>Education</Eyebrow>
            <h3>Patient information</h3>
            <p>Accessible explanations and source-linked health education.</p>
            <a href="/maternal-health/">Explore maternal health</a>
          </BrandCard>
        </div>
        <div class="ds-lab__canvas">
          <h3>Verified professional evidence</h3>
          <EvidenceList items={proofExamples} />
        </div>
      </section>

      <section id="forms" class="ds-lab__section" aria-labelledby="ds-forms-title">
        <div class="ds-lab__section-head">
          <h2 id="ds-forms-title">Forms that respect <em>attention.</em></h2>
          <p>Labels are persistent. Required fields and assistance are explicit. Errors live beside the correct input and are announced to assistive technology.</p>
        </div>
        <div class="ds-lab__canvas">
          <div class="ds-lab__field">
            <label for="ds-example-email">Professional email</label>
            <input id="ds-example-email" type="email" placeholder="name@example.com" autocomplete="off" aria-describedby="ds-email-help"/>
            <small id="ds-email-help">Example field only; nothing is submitted from this reference page.</small>
          </div>
        </div>
      </section>

      <section id="spacing" class="ds-lab__section" aria-labelledby="ds-spacing-title">
        <div class="ds-lab__section-head">
          <h2 id="ds-spacing-title">Rhythm, not <em>random gaps.</em></h2>
          <p>Eight-point spacing primitives, fluid page gutters, a readable text measure and generous section pauses keep every screen aligned.</p>
        </div>
        <div class="ds-lab__space">
          {[8,16,24,32,48,64].map(value => (
            <div class="ds-lab__space-item">
              <span style={`--space:${value}px`} aria-hidden="true"></span>
              <span>{value}px</span>
            </div>
          ))}
        </div>
      </section>

      <section id="principles" class="ds-lab__section" aria-labelledby="ds-principles-title">
        <div class="ds-lab__section-head">
          <h2 id="ds-principles-title">Built for <em>trust.</em></h2>
          <p>Inspiration from Webflow brand craft and NHS healthcare usability guidance, adapted to Reeja's distinct identity.</p>
        </div>
        <div class="ds-lab__note">
          Use authentic personal photography, do not invent medical statistics or patient outcomes, keep readable contrast and visible keyboard focus, honour reduced motion, and never suggest affiliation with NHS, Webflow or other design-system providers.
        </div>
      </section>

      <footer class="ds-lab__footer">
        <span>Reeja Design System · v11.0.0 · Internal design reference</span>
        <a href="/">Return to portfolio ↗</a>
      </footer>
    </div>
  </div>
</BaseLayout>
