---
import BaseLayout from '../layouts/BaseLayout.astro';
const areas = [
  {name:'Clinical research',category:'research',image:'4c6c586bf16b.jpg',alt:'Illustrative clinical blood pressure measurement',description:'IISH · Maternal-health telemonitoring research',summary:'Participant education, monitoring guidance, tele-follow-up and study documentation.',tags:['Research support','Participant education','Digital health'],href:'/clinical-research/'},
  {name:'Maternal and newborn care',category:'hospital',image:'4123471de1d5.jpg',alt:'Illustrative maternal and newborn care',description:'Tribhuvan University Teaching Hospital',summary:'Maternal and newborn nursing and practical education for patients and families.',tags:['Birthing ward','Maternal health','Newborn care'],href:'/maternal-health/'},
  {name:'General nursing practice',category:'hospital',image:'64358b3119c9.jpg',alt:'Illustrative healthcare setting',description:'Manmohan Memorial Medical College and Teaching Hospital',summary:'General ward nursing, documentation and communication with clinical teams.',tags:['General care','Patient education','Handover'],href:'/nursing-practice/'},
  {name:'Maternity care',category:'hospital',image:'99f458695911.jpg',alt:'Illustrative clinical documentation',description:'Sindhuli Hospital',summary:'Maternity nursing support, ward coordination and clinical records.',tags:['Maternity care','Nursing officer','Documentation'],href:'/cv/#experience'}
];
---
<BaseLayout title="Nursing experience | Reeja Maharjan" description="Explore Reeja Maharjan’s hospital nursing, maternal and newborn care and maternal-health clinical research experience in Nepal.">
  <div class="site-page reference-experience">
    <section class="site-page__hero"><div class="container reference-index-heading"><div><p class="site-eyebrow">Experience</p><h1>Clinical experience.</h1></div><p>Hospital nursing, maternal health and clinical research.</p></div></section>
    <section class="site-section reference-experience-list"><div class="container"><div class="reference-filters" role="group" aria-label="Filter experience"><button type="button" data-experience-filter="all" aria-pressed="true">All experience</button><button type="button" data-experience-filter="hospital" aria-pressed="false">Hospital nursing</button><button type="button" data-experience-filter="research" aria-pressed="false">Clinical research</button></div><p class="visually-hidden" data-experience-count aria-live="polite">4 experiences</p><div class="reference-experience-cards">{areas.map(area=><article data-experience-category={area.category}><a href={area.href}><div class="reference-experience-image"><img src={`/images/cinematic/${area.image}`} alt={area.alt} width={area.image === '4c6c586bf16b.jpg' ? 800 : 1100} height={area.image === '4c6c586bf16b.jpg' ? 1204 : area.image === '4123471de1d5.jpg' ? 734 : area.image === '64358b3119c9.jpg' ? 753 : 619} loading="lazy" /><span>Illustrative photograph</span></div><div class="reference-experience-caption"><div><p class="site-eyebrow">{area.description}</p><h2>{area.name}</h2><p>{area.summary}</p><ul class="reference-experience-tags" aria-label="Areas of work">{area.tags.map(tag=><li>{tag}</li>)}</ul></div><span class="reference-experience-action" aria-hidden="true"><span>Read about practice</span><span>+</span></span></div></a></article>)}</div></div></section>
  </div>
  <script>
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-experience-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-experience-category]')];
    filters.forEach(button=>button.addEventListener('click',()=>{const selected=button.dataset.experienceFilter;filters.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));cards.forEach((card,index)=>{card.hidden=selected!=='all'&&card.dataset.experienceCategory!==selected;if(!card.hidden&&!matchMedia('(prefers-reduced-motion: reduce)').matches)card.animate([{opacity:.6,transform:'translateY(8px)'},{opacity:1,transform:'translateY(0)'}],{duration:300,delay:index*35,easing:'cubic-bezier(.22,1,.36,1)'});});const count=document.querySelector('[data-experience-count]');if(count)count.textContent=`${cards.filter(card=>!card.hidden).length} experiences`; }));
  </script>
</BaseLayout>
