---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../content/profile';
import { professionalFacts } from '../content/professional-facts';
import { recruiterCopy } from '../content/recruiter-copy';
import { siteCopy } from '../content/site-copy';

const copy = recruiterCopy.hire;
const roleAreas = recruiterCopy.focus.areas;
const credentialTitles = [
  'Registered Nurse (RN), Nepal Nursing Council',
  'Texas RN License - Active, Unencumbered',
  'Comprehensive Newborn Care Level II',
  'Operation Theatre Techniques and Management (OTTM)',
  'CPR Training Participation'
];
const featuredCredentials = credentialTitles.flatMap((title) => {
  const credential = profile.certifications.find((item) => item.title === title);
  return credential ? [credential] : [];
});
const hiringSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: siteCopy.updatedAt,
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://reejamaharjan.com.np/#person',
    name: professionalFacts.name,
    jobTitle: professionalFacts.primaryRole,
    description: siteCopy.profileSummary,
    email: professionalFacts.professionalEmail,
    url: 'https://reejamaharjan.com.np/',
    sameAs: [professionalFacts.linkedin, professionalFacts.instagram].filter(Boolean)
  }
};
import BrandAction from '../components/design-system/BrandAction.astro';
import BrandCard from '../components/design-system/BrandCard.astro';
import EvidenceList from '../components/design-system/EvidenceList.astro';
---

<BaseLayout title={siteCopy.hire.title} description={siteCopy.hire.description}>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">Work with Reeja Maharjan</p>
          <h1>Work with Reeja on <em>nursing and research.</em></h1>
          <p class="site-page__lede">{copy.lede}</p>
          <div class="site-actions">
            <BrandAction variant="primary" href="/contact/" dataTrack="hire-contact">Discuss an opportunity</BrandAction>
            <BrandAction href={professionalFacts.publicCvPath} dataTrack="hire-cv">View CV</BrandAction>
            <BrandAction href={professionalFacts.linkedin} target="_blank" dataTrack="hire-linkedin">LinkedIn</BrandAction>
          </div>
        </div>
        <EvidenceList items={[
          { label: 'Nepal registration', value: professionalFacts.nepalLicenseShort },
          { label: 'Texas license', value: professionalFacts.texasLicenseShort },
          { label: 'Current role', value: `${professionalFacts.currentRole}, ${professionalFacts.currentEmployerShort}` },
          { label: 'Location', value: professionalFacts.currentLocation }
        ]} />
      </div>
    </section>
    <section class="hire-story" aria-labelledby="hire-story-title">
      <div class="container hire-story__grid">
        <figure class="hire-story__portrait">
          <img src="/reeja-headshot.jpg" width="896" height="1200" alt="Reeja Maharjan standing in front of a historic building in Nepal" loading="lazy" decoding="async" />
          <figcaption>Reeja Maharjan · Personal photograph</figcaption>
        </figure>
        <div class="hire-story__copy">
          <p class="site-eyebrow">Professional background</p>
          <h2 id="hire-story-title">Hospital nursing and maternal-health research.</h2>
          <p>My experience includes maternal and newborn care, general nursing, patient education, clinical handover and research support for the IISH MOM-HD study.</p>
          <p>For a hiring conversation, you can review my professional history and training before sharing details about the role or project.</p>
          <a class="site-button site-button--primary" href="/cv/">Review professional CV</a>
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">{copy.roleFitEyebrow}</p><h2>{copy.roleFitHeading}</h2></div>
          <p>{copy.roleFitSummary}</p>
        </div>
        <div class="site-grid">
          {roleAreas.map((item) => (
            <BrandCard>
              <p class="site-eyebrow">{item.label}</p>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <ul>{item.evidence.slice(0, 2).map((evidence) => <li>{evidence}</li>)}</ul>
              <p><a href={item.href}>{item.cta}</a></p>
            </BrandCard>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--soft">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">{copy.experienceEyebrow}</p><h2>{copy.experienceHeading}</h2></div>
          <p>{copy.experienceSummary}</p>
        </div>
        <div class="site-list">
          {profile.experience.map((item) => (
            <article class="site-list__item">
              <div><h3>{item.role}</h3><p>{item.organization}</p></div>
              <p>{item.bullets[0]}</p>
              <p class="site-list__meta">{item.period}<br />{item.location}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">{copy.credentialsEyebrow}</p><h2>{copy.credentialsHeading}</h2></div>
          <p>{copy.credentialsSummary}</p>
        </div>
        <div class="site-grid">
          {featuredCredentials.map((item) => (
            <BrandCard>
              <h3>{item.title}</h3>
              <p><strong>{item.issuer}</strong><br />{item.date}</p>
            </BrandCard>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">{copy.closingEyebrow}</p><h2>{copy.closingHeading}</h2><p>{copy.closingSummary}</p></div>
        <div class="site-actions"><BrandAction href="/contact/" dataTrack="hire-bottom-contact">Contact Reeja</BrandAction><BrandAction href={professionalFacts.publicCvPath}>View CV</BrandAction></div>
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(hiringSchema)}></script>
</BaseLayout>
