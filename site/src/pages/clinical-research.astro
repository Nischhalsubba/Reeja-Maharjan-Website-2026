---
import BaseLayout from '../layouts/BaseLayout.astro';
import { professionalFacts } from '../content/professional-facts';
import { siteCopy } from '../content/site-copy';
import { getBlogPost } from '../content/blog';

const copy = siteCopy.research;
const relatedArticles = [
  'pre-eclampsia-pregnancy-warning-signs-monitoring-2026',
  'gestational-diabetes-in-pregnancy-2026-monitoring-care'
].map((slug) => getBlogPost(slug)).filter((post): post is NonNullable<typeof post> => Boolean(post));
const responsibilities = [
  ['Participant screening', 'ANC screening, eligibility, consent-workflow support, and study records.'],
  ['Home monitoring', 'BP/BG device education and mobile reporting support.'],
  ['Tele-follow-up', 'Reading review, warning-symptom screening, adherence, and protocol escalation.'],
  ['Data quality', 'Digital records, confidentiality, and data-quality checks.'],
  ['Device coordination', 'Distribution, use, tracking, and return workflows.'],
  ['Team communication', 'Coordination with nurses, obstetricians, researchers, and technical teams.']
];
import ResearchJourneyVisual from '../components/ResearchJourneyVisual.astro';
import BrandAction from '../components/design-system/BrandAction.astro';
import BrandCard from '../components/design-system/BrandCard.astro';
import EvidenceList from '../components/design-system/EvidenceList.astro';
import Eyebrow from '../components/design-system/Eyebrow.astro';
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <Eyebrow inverse>Maternal-health research</Eyebrow>
          <h1>Maternal-health research and <em>telemonitoring.</em></h1>
          <p class="site-page__lede">At IISH, I support the MOM-HD maternal-health telemonitoring study in Nepal through participant education, home BP/BG monitoring guidance, tele-follow-up and accurate study documentation.</p>
        </div>
        <EvidenceList items={[
          { label: 'Current role', value: `${professionalFacts.currentRole}, ${professionalFacts.currentEmployerShort}` },
          { label: 'Project', value: professionalFacts.currentProjectShort },
          { label: 'Focus', value: 'Hypertension and diabetes in pregnancy' },
          { label: 'Location', value: professionalFacts.currentLocation }
        ]} />
      </div>
    </section>
    <ResearchJourneyVisual label="Education, monitoring and follow-up in maternal-health research" />

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Research responsibilities</p><h2>Participant education, follow-up and accurate study records.</h2></div>
          <p>An overview of my research-support responsibilities, including consent workflows, home monitoring, documentation and protocol-based escalation.</p>
        </div>
        <div class="site-grid">
          {responsibilities.map(([title, description]) => (
            <BrandCard><h3>{title}</h3><p>{description}</p></BrandCard>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--soft">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Role relevance</p><h2>Skills for maternal-health and digital-health research teams.</h2><p>Best matched to teams needing participant education, digital-health support, reliable follow-up, and coordination.</p></div>
        <EvidenceList items={[
          { label: 'Maternal health', value: 'HDP and GDM research workflows' },
          { label: 'Digital health', value: 'Home monitoring and tele-follow-up' },
          { label: 'Research support', value: 'Records, logistics, and participant communication' }
        ]} />
      </div>
    </section>

    <section class="site-section research-reading" aria-labelledby="research-reading-title">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Related reading</p><h2 id="research-reading-title">Understand pregnancy monitoring.</h2></div>
          <p>Evidence-linked educational writing about blood-pressure and blood-glucose monitoring in pregnancy. These articles do not report MOM-HD trial outcomes.</p>
        </div>
        <ul class="research-reading__list">
          {relatedArticles.map((post) => (
            <li class="research-reading__item">
              <div>
                <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
                <p>{post.excerpt}</p>
              </div>
              <span class="research-reading__meta">{post.readMinutes} min read</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Work with Reeja</p><h2>Discuss a maternal-health research opportunity.</h2><p>Please include the study or programme, location, expected timeline and role responsibilities.</p></div>
        <div class="site-actions"><BrandAction href="/cv/">View CV</BrandAction><BrandAction href="/contact/">Contact Reeja</BrandAction></div>
      </div>
    </section>
  </div>
</BaseLayout>
