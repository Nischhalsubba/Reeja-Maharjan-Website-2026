---
import BaseLayout from '../layouts/BaseLayout.astro';
import PracticeStory from '../components/PracticeStory.astro';
import { blogPosts } from '../content/blog';
import { siteCopy } from '../content/site-copy';

const copy = siteCopy.nursing;
const posts = blogPosts.filter((post) =>
  [post.primaryKeyword, ...post.supportingKeywords, ...post.tags]
    .join(' ')
    .toLowerCase()
    .match(/nursing|documentation|sbar|handover|confidential|licensure|student|general care/)
).slice(0, 3);
import EditorialPhoto from '../components/EditorialPhoto.astro';
import BrandCard from '../components/design-system/BrandCard.astro';
import EvidenceList from '../components/design-system/EvidenceList.astro';
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="site-page">
    <section class="site-page__hero reference-case-hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">Nursing practice</p>
          <h1>Hospital nursing and <em>patient education.</em></h1>
          <p class="reference-case-tags">Patient education · Documentation · Handover</p>
          <p class="site-page__lede">My hospital nursing experience spans maternal-newborn and general wards in Nepal. I focus on patient education, clinical records, clear shift handover and timely communication with care teams.</p>
        </div>

      </div>
    </section>
    <section class="site-section site-section--dark reference-case-overview" id="overview" aria-labelledby="overview-heading">
      <div class="container reference-case-overview-grid">
        <div><p class="site-eyebrow">Overview</p><h2 id="overview-heading">Continuity of care, one shift at a time.</h2><p>My hospital background includes general nursing at Manmohan Memorial Medical College and Teaching Hospital alongside maternity-related roles. I value clear communication, accurate records and coordinated team-based care.</p><p><a href="/experience/">Explore my clinical experience →</a></p></div>
        <EvidenceList items={copy.summary.map(([label, value]) => ({ label, value }))} />
      </div>
    </section>
    <EditorialPhoto kind="clinical" label="Care, communication and clinical practice" />
    <PracticeStory title="Every shift has a story." intro="An overview of my general ward and hospital nursing experience, grounded in teamwork rather than invented patient stories." chapters={[
      {title:'Working with the care team',text:'My general ward experience at Manmohan Memorial Medical College and Teaching Hospital involved nursing support and coordination across assigned duties.',image:'/images/cinematic/64358b3119c9.jpg',alt:'Illustrative hospital team'},
      {title:'Observation and communication',text:'I value clear communication about observations and concerns within the scope of my role.',image:'/images/cinematic/4c6c586bf16b.jpg',alt:'Illustrative nursing observation'},
      {title:'Documentation and handover',text:'Clear records and structured handover connect one shift to the next and support continuity of care.',image:'/images/cinematic/99f458695911.jpg',alt:'Illustrative clinical documentation'}
    ]} />

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Selected writing</p><h2>Nursing guides on communication, records and patient safety.</h2></div>
          <p>Selected articles on clinical communication, documentation and professional learning, with sources for further reading.</p>
        </div>
        <div class="site-grid">
          {posts.map((post) => (
            <BrandCard>
              <p class="site-eyebrow">By Reeja Maharjan · {post.readMinutes} min read</p>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <p><a href={`/blog/${post.slug}/`}>Read article</a></p>
            </BrandCard>
          ))}
        </div>
        <p><a href="/blog/">View all writing by Reeja</a></p>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Professional profile</p><h2>Explore my hospital nursing experience.</h2><p>See my roles, credentials, training, and current research work.</p></div>
        <div class="site-actions"><a class="site-button" href="/cv/">Professional CV</a><a class="site-button" href="/hire-reeja/">Hire Reeja</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
