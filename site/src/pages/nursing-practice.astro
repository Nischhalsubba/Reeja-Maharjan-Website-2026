---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPosts } from '../content/blog';
import { siteCopy } from '../content/site-copy';

const copy = siteCopy.nursing;
const posts = blogPosts.filter((post) =>
  [post.primaryKeyword, ...post.supportingKeywords, ...post.tags]
    .join(' ')
    .toLowerCase()
    .match(/nursing|documentation|sbar|handover|confidential|licensure|student|general care/)
).slice(0, 3);
import EditorialPhoto from '../components/EditorialPhoto.astro';
import BrandAction from '../components/design-system/BrandAction.astro';
import BrandCard from '../components/design-system/BrandCard.astro';
import EvidenceList from '../components/design-system/EvidenceList.astro';
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">Nursing practice</p>
          <h1>Clinical nursing &amp; <em>patient education.</em></h1>
          <p class="site-page__lede">Hospital nursing experience across maternal-newborn and general-care wards, with a focus on patient education, clinical documentation, structured handover and appropriate escalation.</p>
        </div>
        <EvidenceList items={copy.summary.map(([label, value]) => ({ label, value }))} />
      </div>
    </section>
    <EditorialPhoto kind="clinical" label="Care, communication and clinical practice" />

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Selected writing</p><h2>Guides on nursing practice and patient safety.</h2></div>
          <p>Three practical reads on communication, documentation, safety, and professional development.</p>
        </div>
        <div class="site-grid">
          {posts.map((post) => (
            <BrandCard>
              <p class="site-eyebrow">By Reeja Maharjan · {post.readMinutes} min read</p>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <p><a href={`/blog/${post.slug}/`}>Read article</a></p>
            </BrandCard>
          ))}
        </div>
        <p><a href="/blog/">View all writing by Reeja</a></p>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Professional profile</p><h2>Review Reeja’s nursing experience.</h2><p>See her roles, credentials, training, and current research work.</p></div>
        <div class="site-actions"><a class="site-button" href="/cv/">View CV</a><a class="site-button" href="/hire-reeja/">Hire Reeja</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
