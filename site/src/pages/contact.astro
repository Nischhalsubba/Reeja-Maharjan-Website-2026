---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfessionalContactForm from '../components/ProfessionalContactForm.astro';
import { professionalFacts } from '../content/professional-facts';
import { siteCopy } from '../content/site-copy';

const copy = siteCopy.contact;
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="contact-page">
    <section class="contact-hero" aria-labelledby="contact-page-title">
      <div class="container contact-hero__grid">
        <div class="contact-hero__copy" data-motion-reveal>
          <p class="site-eyebrow">Work with Reeja</p>
          <h1 id="contact-page-title">Contact Reeja Maharjan.</h1>
          <p>Share the role or project, location, timeline, and main responsibilities.</p>
        </div>
        <div class="contact-hero__details" data-motion-reveal>
          <div><span>Email</span><a href={`mailto:${professionalFacts.professionalEmail}`}>{professionalFacts.professionalEmail}</a></div>
          <div><span>Based in</span><strong>{professionalFacts.currentLocation}</strong></div>
          <div><span>Current role</span><strong>{professionalFacts.currentRole}, {professionalFacts.currentEmployerShort}</strong></div>
          <div><span>Project</span><strong>{professionalFacts.currentProjectShort}</strong></div>
        </div>
      </div>
    </section>

    <section class="contact-section">
      <div class="container contact-layout">
        <ProfessionalContactForm />

        <aside class="contact-sidebar" aria-label="Contact guidance" data-motion-reveal>
          <div class="contact-sidebar__block">
            <p class="site-eyebrow">Helpful details</p>
            <h2>What to include</h2>
            <ul>
              <li>Organisation and role or project</li>
              <li>Location and expected timeline</li>
              <li>Main responsibilities and next step</li>
            </ul>
          </div>

          <div class="contact-sidebar__block contact-sidebar__block--soft">
            <p class="site-eyebrow">Before contacting</p>
            <h2>Review Reeja’s CV</h2>
            <p>Licensure, training, education, hospital experience, and current research work are summarised publicly.</p>
            <a class="care-link" href={professionalFacts.publicCvPath}>View CV</a>
          </div>

          <div class="contact-sidebar__block">
            <p class="site-eyebrow">Direct channels</p>
            <a class="contact-sidebar__social" href={professionalFacts.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a class="contact-sidebar__social" href={`mailto:${professionalFacts.professionalEmail}`}>Email Reeja</a>
          </div>
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>
