---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfessionalContactForm from '../components/ProfessionalContactForm.astro';
import { professionalFacts } from '../content/professional-facts';
import { siteCopy } from '../content/site-copy';

const copy = siteCopy.contact;
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="contact-page reference-contact">
    <section class="contact-hero" aria-labelledby="contact-page-title">
      <div class="container contact-hero__grid">
        <div class="contact-hero__copy">
          <p class="site-eyebrow">Contact</p>
          <h1 id="contact-page-title">Let’s talk.</h1>
          <p>Have a nursing role or research project in mind?<br />Tell me about it.</p>
          <a class="btn reference-outline" href="#arrange-a-call"><span>Arrange a call</span><i aria-hidden="true">+</i></a>
          <div class="contact-hero__direct">
            <p class="site-eyebrow">Prefer email?</p>
            <a href={`mailto:${professionalFacts.professionalEmail}`}>{professionalFacts.professionalEmail}</a>
          </div>
        </div>
        <ProfessionalContactForm />
      </div>
    </section>

    <section class="contact-section reference-call-section" id="arrange-a-call" aria-labelledby="call-heading">
      <div class="container">
        <div class="reference-call-heading"><h2 id="call-heading">Arrange a call.</h2><p>Online · Nepal time (UTC+05:45)</p></div>
        <div class="reference-call-grid">
          <div class="reference-call-availability">
            <p class="site-eyebrow">Professional conversations</p>
            <h3>Find a time that works for both of us.</h3>
            <p>Send a preferred date, time and time zone, along with the nursing or research opportunity. Reeja can confirm a time by email.</p>
            <a class="btn" href={`mailto:${professionalFacts.professionalEmail}?subject=Professional%20call%20request`}><span>Request a time</span><i aria-hidden="true">+</i></a>
          </div>
          <div class="reference-call-details">
            <h3>Your enquiry.</h3>
            <p>Include your organisation, location, role or project, and expected timeline.</p>
            <a class="btn reference-outline" href="#professional-contact-form"><span>Send an enquiry</span><i aria-hidden="true">+</i></a>
            <p class="reference-call-meta">Based in {professionalFacts.currentLocation} · {professionalFacts.currentRole}, {professionalFacts.currentEmployerShort}</p>
            <a href={professionalFacts.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a>
            <a href={professionalFacts.publicCvPath}>Review professional CV</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
