---
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/public-sans/800.css';
import '../styles/reeja-cinematic.css';
import Header from '../components/Header.astro';

import Footer from '../components/Footer.astro';
import { profile } from '../content/profile';
import { professionalFacts } from '../content/professional-facts';
import { siteCopy } from '../content/site-copy';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  publishedAt?: string;
  modifiedAt?: string;
};

const {
  title = siteCopy.defaultTitle,
  description = siteCopy.defaultDescription,
  image = '/og-default.png',
  robots = 'index, follow, max-image-preview:large',
  publishedAt,
  modifiedAt
} = Astro.props;

const pathname = Astro.url.pathname;
const isArticlePage = pathname.startsWith('/blog/') && pathname !== '/blog/' && !pathname.startsWith('/blog/topics/');
const isProfilePage = pathname === '/' || pathname === '/about/' || pathname === '/hire-reeja/' || pathname === '/cv/' || pathname === '/education/';
const canonicalUrl = new URL(pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
const portraitUrl = new URL('/reeja-headshot.jpg', Astro.site ?? Astro.url.origin).toString();
const sameAs = [professionalFacts.linkedin, professionalFacts.instagram].filter(Boolean);
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const searchConsoleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const personSchema = {
  '@type': 'Person',
  '@id': 'https://reejamaharjan.com.np/#person',
  name: professionalFacts.name,
  url: 'https://reejamaharjan.com.np/',
  image: portraitUrl,
  jobTitle: professionalFacts.primaryRole,
  description: siteCopy.profileSummary,
  affiliation: [{ '@type': 'CollegeOrUniversity', name: 'Degree Campus, Tribhuvan University', url: professionalFacts.studyProgramUrl }],
  email: professionalFacts.professionalEmail,
  address: {
    '@type': 'PostalAddress',
    addressLocality: professionalFacts.locationLocality,
    addressRegion: professionalFacts.locationRegion,
    addressCountry: professionalFacts.countryCode
  },
  knowsAbout: [...profile.keywords, 'Registered nursing in Nepal', 'Clinical research nursing', 'Maternal health research'],
  hasCredential: [{
    '@type': 'EducationalOccupationalCredential',
    name: 'Nepal Nursing Council Registered Nurse registration',
    credentialCategory: 'Professional registration',
    description: 'Registration status confirmed by Reeja Maharjan on 24 November 2026; the registration number is not published publicly.',
    recognizedBy: { '@type': 'Organization', name: 'Nepal Nursing Council', url: 'https://nnc.org.np/' }
  }],
  sameAs
};

const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://reejamaharjan.com.np/#website',
      url: 'https://reejamaharjan.com.np/',
      name: siteCopy.websiteName,
      description: siteCopy.defaultDescription,
      inLanguage: 'en',
      publisher: { '@id': 'https://reejamaharjan.com.np/#person' }
    },
    personSchema,
    ...(isProfilePage
      ? [{
          '@type': 'ProfilePage',
          '@id': `${canonicalUrl}#profilepage`,
          url: canonicalUrl,
          name: title,
          description,
          dateModified: siteCopy.updatedAt,
          mainEntity: { '@id': 'https://reejamaharjan.com.np/#person' },
          isPartOf: { '@id': 'https://reejamaharjan.com.np/#website' }
        }]
      : []),
    ...(pathname !== '/' && !isArticlePage ? [{
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://reejamaharjan.com.np/' },
        ...(isArticlePage ? [{ '@type': 'ListItem', position: 2, name: 'Journal', item: 'https://reejamaharjan.com.np/blog/' }] : []),
        { '@type': 'ListItem', position: isArticlePage ? 3 : 2, name: title.split(' | ')[0], item: canonicalUrl }
      ]
    }] : [])
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="design-system" content="Reeja Cinematic Nursing" />
    <meta name="design-release" content="reeja-cinematic-14.0.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF8E9" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={isArticlePage ? 'article' : isProfilePage ? 'profile' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={`${title} — ${professionalFacts.name}`} />
    <meta property="og:site_name" content={siteCopy.websiteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    {isArticlePage && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {isArticlePage && modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${title} — ${professionalFacts.name}`} />
    <meta name="robots" content={robots} />
    {searchConsoleVerification && <meta name="google-site-verification" content={searchConsoleVerification} />}

    <script type="application/ld+json" set:html={JSON.stringify(graphSchema)}></script>
    <link rel="icon" type="image/svg+xml" href="/images/reeja-mark.svg" />
    {pathname === '/' && <link rel="preload" as="image" href="/images/reeja-hero.webp" fetchpriority="high" />}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId, { anonymize_ip: true });
      </script>
    )}
  </head>
  <body id="page-top" class="care-personal-site" data-design-system="reeja-cinematic" data-design-version="14.0.0-cinematic" data-page-route={pathname}>
    <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header name={professionalFacts.name} />
    <main id="main-content" class:list={[pathname === '/' ? 'cinematic-home' : 'inner-page']}>
      {pathname !== '/' && <nav class="container inner-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{isArticlePage && <><a href="/blog/">Journal</a><span aria-hidden="true">/</span></>}<span aria-current="page">{title.split(' | ')[0]}</span></nav>}
      <slot />
    </main>
    <Footer profile={profile} />

    <script>
      import { initMotion } from '../lib/motion';
      import { initMobileNavA11y } from '../lib/mobileNavA11y';
      import { initCinematicMotion } from '../lib/cinematicMotion';

      initMotion();
      initMobileNavA11y();
      initCinematicMotion();

      document.querySelectorAll<HTMLElement>('[data-track]').forEach((element) => {
        element.addEventListener('click', () => {
          const eventName = element.dataset.track ?? 'site_action';
          const gtag = (window as typeof window & { gtag?: (...args: unknown[]) => void }).gtag;
          gtag?.('event', eventName, { page_path: window.location.pathname });
        });
      });
    </script>
  </body>
</html>
