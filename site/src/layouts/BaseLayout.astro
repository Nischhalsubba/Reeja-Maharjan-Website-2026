---
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/public-sans/800.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site-pages.css';
import '../styles/shell.css';
import '../styles/care-shell.css';
import '../styles/care-inner-layout.css';
import '../styles/care-interaction-guards.css';
import '../styles/care-personal-inner.css';
import '../styles/care-article-footer.css';
import '../styles/care-editorial-v4.css';
import '../styles/care-blog-v44.css';
import '../styles/reeja-home-v7.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../content/profile';
import { professionalFacts } from '../content/professional-facts';
import { siteCopy } from '../content/site-copy';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
};

const {
  title = siteCopy.defaultTitle,
  description = siteCopy.defaultDescription,
  image = '/og-default.png',
  robots = 'index, follow, max-image-preview:large'
} = Astro.props;

const pathname = Astro.url.pathname;
const isArticlePage = pathname.startsWith('/blog/') && pathname !== '/blog/';
const isProfilePage = pathname === '/' || pathname === '/hire-reeja/' || pathname === '/cv/';
const canonicalUrl = new URL(pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
const portraitUrl = new URL('/reeja-headshot.jpg', Astro.site ?? Astro.url.origin).toString();
const sameAs = [professionalFacts.linkedin, professionalFacts.instagram].filter(Boolean);
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const searchConsoleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const personSchema = {
  '@type': 'Person',
  '@id': 'https://reejamaharjan.com.np/#person',
  name: professionalFacts.name,
  url: 'https://reejamaharjan.com.np/',
  image: portraitUrl,
  jobTitle: professionalFacts.primaryRole,
  description: siteCopy.profileSummary,
  email: professionalFacts.professionalEmail,
  address: {
    '@type': 'PostalAddress',
    addressLocality: professionalFacts.locationLocality,
    addressRegion: professionalFacts.locationRegion,
    addressCountry: professionalFacts.countryCode
  },
  knowsAbout: profile.keywords,
  sameAs
};

const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://reejamaharjan.com.np/#website',
      url: 'https://reejamaharjan.com.np/',
      name: siteCopy.websiteName,
      description: siteCopy.defaultDescription,
      inLanguage: 'en',
      publisher: { '@id': 'https://reejamaharjan.com.np/#person' }
    },
    personSchema,
    ...(isProfilePage
      ? [{
          '@type': 'ProfilePage',
          '@id': `${canonicalUrl}#profilepage`,
          url: canonicalUrl,
          name: title,
          description,
          dateModified: siteCopy.updatedAt,
          mainEntity: { '@id': 'https://reejamaharjan.com.np/#person' },
          isPartOf: { '@id': 'https://reejamaharjan.com.np/#website' }
        }]
      : [])
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="design-system" content="Care is Personal" />
    <meta name="design-release" content="care-personal-site-7.0.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={isArticlePage ? 'article' : isProfilePage ? 'profile' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={`${title} — ${professionalFacts.name}`} />
    <meta property="og:site_name" content={siteCopy.websiteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="robots" content={robots} />
    {searchConsoleVerification && <meta name="google-site-verification" content={searchConsoleVerification} />}

    <script type="application/ld+json" set:html={JSON.stringify(graphSchema)}></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId, { anonymize_ip: true });
      </script>
    )}
  </head>
  <body id="page-top" class="care-personal-site" data-design-system="care-is-personal" data-design-version="7.0.0-care-personal">
    <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header name={professionalFacts.name} />
    <main id="main-content"><slot /></main>
    <Footer profile={profile} />

    <script>
      import { initMotion } from '../lib/motion';
      import { initMobileNavA11y } from '../lib/mobileNavA11y';
      import { initCareInnerMotion } from '../lib/careInnerMotion';
      import { initCarePersonalMotion } from '../lib/carePersonalMotion';

      initMotion();
      initMobileNavA11y();
      initCareInnerMotion();
      initCarePersonalMotion();

      document.querySelectorAll<HTMLElement>('[data-track]').forEach((element) => {
        element.addEventListener('click', () => {
          const eventName = element.dataset.track ?? 'site_action';
          const gtag = (window as typeof window & { gtag?: (...args: unknown[]) => void }).gtag;
          gtag?.('event', eventName, { page_path: window.location.pathname });
        });
      });
    </script>
  </body>
</html>
