---
import type { HeroData } from '../content/profile';

type Props = { hero: HeroData };
const { hero } = Astro.props;
const currentFocus = hero.proof.slice(0, 3);
---

<section class="hero section" id="home" data-reveal-group>
  <div class="hero__grid container">
    <div class="hero__content">
      {hero.available && <p class="badge">RN Portfolio | Nursing and Maternal Health Research</p>}
      <p class="hero__caption">Clinical care, maternal monitoring, and participant education</p>
      <h1>{hero.title}</h1>
      <p class="hero__role">{hero.role}</p>
      <p class="hero__tagline">{hero.tagline}</p>
      <ul class="chip-list hero__proof" aria-label="Professional proof points">
        {hero.proof.map((item) => <li>{item}</li>)}
      </ul>
      <div class="hero__actions">
        <a class="btn btn--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="btn btn--secondary" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
    </div>
    <div class="hero__media" data-reveal>
      <div class="hero__media-stage">
        <div class="hero__art-frame" aria-hidden="true">
          <img
            class="hero__art"
            src="/nurse-care-editorial-hero.png"
            alt=""
            width="1536"
            height="1024"
            loading="eager"
          />
        </div>
        <div class="hero__signal-card">
          <p class="hero__signal-label">Current care lens</p>
          <h2 class="hero__signal-title">
            Maternal health monitoring with research-grade follow-up
          </h2>
          <p class="hero__signal-text">
            Supports participant screening, device education, BP and BG review, tele-follow-up, and
            safe escalation coordination.
          </p>
          <ul class="chip-list" aria-label="Current focus points">
            {currentFocus.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="hero__portrait-frame">
          <img
            class="hero__portrait"
            src={hero.portrait.src}
            alt={hero.portrait.alt}
            width="720"
            height="860"
            loading="eager"
          />
        </div>
        <ul class="hero-meta">
          {
            hero.meta.map((item) => (
              <li>
                <span>{item.label}</span>
                <strong>{item.value}</strong>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
