---
import { profile } from '../content/profile';
const featuredWriting = [
  { category: 'Maternal care', title: 'Essential maternal and newborn care guide', href: '/blog/essential-maternal-newborn-care-guide-2026/' },
  { category: 'Clinical practice', title: 'SBAR handover and nursing documentation', href: '/blog/mastering-nursing-documentation-sbar-handover/' },
  { category: 'Digital health', title: 'Telehealth and community nursing in Nepal', href: '/blog/future-of-nursing-in-nepal-telehealth-community-care-post-covid/' }
];
---

<section class="ledger-section care-section care-credentials" id="credentials" aria-labelledby="credentials-title">
  <div class="container">
    <header class="ledger-section__header care-section__header" data-motion-reveal>
      <p class="ledger-kicker">Credentials</p>
      <h2 id="credentials-title">Licensure and clinical training, presented for quick verification.</h2>
      <p>Sensitive documents are not published publicly. Verification material can be shared privately with legitimate employers and recruiters.</p>
    </header>

    <div class="credential-registry care-credentials__grid" data-motion-group>
      {profile.certifications.slice(0, 6).map((credential) => (
        <article class="credential-registry__entry care-credentials__card" data-motion-reveal>
          <div>
            <p class="care-credentials__issuer">{credential.issuer}</p>
            <h3>{credential.title}</h3>
          </div>
          <div class="care-credentials__meta">
            <p>{credential.date}</p>
            <span>{credential.credentialLabel ?? 'Verification available on request'}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="ledger-section care-section care-reading" id="writing" aria-labelledby="writing-title">
  <div class="container">
    <header class="ledger-section__header ledger-section__header--split care-section__header care-section__header--split" data-motion-reveal>
      <div>
        <p class="ledger-kicker">Selected writing</p>
        <h2 id="writing-title">Practical nursing notes for real care decisions.</h2>
        <p>Articles translate clinical learning into clear, accessible guidance while keeping scope and safety notes visible.</p>
      </div>
      <a class="ledger-link care-link" href="/blog/">Browse all articles</a>
    </header>

    <div class="reading-index care-reading__grid" data-motion-group>
      {featuredWriting.map((article) => (
        <a class="reading-index__entry care-reading__card" href={article.href} data-motion-reveal>
          <p>{article.category}</p>
          <h3>{article.title}</h3>
          <small>Read article</small>
        </a>
      ))}
    </div>
  </div>
</section>
