---
import { profile } from '../content/profile';
import { siteCopy } from '../content/site-copy';

const featuredWriting = [
  { category: 'Maternal health', title: 'Maternal and newborn care after birth', href: '/blog/essential-maternal-newborn-care-guide-2026/' },
  { category: 'Nursing practice', title: 'Nursing documentation and SBAR handover', href: '/blog/mastering-nursing-documentation-sbar-handover/' },
  { category: 'Digital health', title: 'Nursing in Nepal, telehealth, and community care', href: '/blog/future-of-nursing-in-nepal-telehealth-community-care-post-covid/' }
];

const credentialsCopy = siteCopy.home.credentials;
const writingCopy = siteCopy.home.writing;
---

<section class="fj-section" id="credentials" aria-labelledby="credentials-title">
  <div class="container">
    <header class="fj-section__head" data-fj-reveal>
      <p class="fj-kicker">{credentialsCopy.kicker}</p>
      <div>
        <h2 id="credentials-title">{credentialsCopy.title}</h2>
        <p>{credentialsCopy.summary}</p>
      </div>
    </header>

    <div class="fj-registry" data-fj-group>
      {profile.certifications.slice(0, 6).map((credential) => (
        <article class="fj-registry__entry" data-fj-reveal>
          <div>
            <p class="fj-registry__issuer">{credential.issuer}</p>
            <h3>{credential.title}</h3>
          </div>
          <div class="fj-registry__meta">
            <p>{credential.date}</p>
            <span>{credential.credentialLabel ?? 'Verification available on request'}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="fj-section fj-section--surface" id="writing" aria-labelledby="writing-title">
  <div class="container">
    <header class="fj-section__head" data-fj-reveal>
      <p class="fj-kicker">{writingCopy.kicker}</p>
      <div>
        <h2 id="writing-title">{writingCopy.title}</h2>
        <p>{writingCopy.summary}</p>
      </div>
    </header>

    <div class="fj-reading" data-fj-group>
      {featuredWriting.map((article, index) => (
        <a class="fj-reading__entry" href={article.href} data-fj-reveal>
          <p class="fj-reading__meta">0{index + 1}<br />{article.category}</p>
          <h3>{article.title}</h3>
          <small>Read article</small>
        </a>
      ))}
    </div>

    <div style="margin-top: var(--fj-space-5)" data-fj-reveal>
      <a class="fj-link" href="/blog/">{writingCopy.cta}</a>
    </div>
  </div>
</section>
