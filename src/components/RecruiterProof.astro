---
import { profile } from '../content/profile';
const featuredWriting = [
  { category: 'Maternal care', title: 'Essential maternal and newborn care guide', href: '/blog/essential-maternal-newborn-care-guide-2026/' },
  { category: 'Clinical practice', title: 'SBAR handover and nursing documentation', href: '/blog/mastering-nursing-documentation-sbar-handover/' },
  { category: 'Digital health', title: 'Telehealth and community nursing in Nepal', href: '/blog/future-of-nursing-in-nepal-telehealth-community-care-post-covid/' }
];
---

<section class="fj-section" id="credentials" aria-labelledby="credentials-title">
  <div class="container">
    <header class="fj-section__head" data-fj-reveal>
      <p class="fj-kicker">04 · Verification register</p>
      <div>
        <h2 id="credentials-title">Credentials presented like records, not badges.</h2>
        <p>Sensitive documents stay private. The public portfolio names the credential and issuer; legitimate employers can request verification material directly.</p>
      </div>
    </header>

    <div class="fj-registry" data-fj-group>
      {profile.certifications.slice(0, 6).map((credential) => (
        <article class="fj-registry__entry" data-fj-reveal>
          <div>
            <p class="fj-registry__issuer">{credential.issuer}</p>
            <h3>{credential.title}</h3>
          </div>
          <div class="fj-registry__meta">
            <p>{credential.date}</p>
            <span>{credential.credentialLabel ?? 'Verification available on request'}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="fj-section fj-section--surface" id="writing" aria-labelledby="writing-title">
  <div class="container">
    <header class="fj-section__head" data-fj-reveal>
      <p class="fj-kicker">05 · Reading notes</p>
      <div>
        <h2 id="writing-title">Writing that makes clinical reasoning easier to use.</h2>
        <p>Selected articles translate nursing and maternal-health topics into clear, practical guidance while keeping scope and safety visible.</p>
      </div>
    </header>

    <div class="fj-reading" data-fj-group>
      {featuredWriting.map((article, index) => (
        <a class="fj-reading__entry" href={article.href} data-fj-reveal>
          <p class="fj-reading__meta">0{index + 1}<br />{article.category}</p>
          <h3>{article.title}</h3>
          <small>Open note</small>
        </a>
      ))}
    </div>

    <div class="fj-writing__footer" data-fj-reveal>
      <a class="fj-link" href="/blog/">Browse the complete article library</a>
    </div>
  </div>
</section>
