---
import { profile } from '../content/profile';
const featuredWriting = [
  { category: 'Maternal care', title: 'Essential maternal and newborn care guide', href: '/blog/essential-maternal-newborn-care-guide-2026/' },
  { category: 'Clinical practice', title: 'SBAR handover and nursing documentation', href: '/blog/mastering-nursing-documentation-sbar-handover/' },
  { category: 'Digital health', title: 'Telehealth and community nursing in Nepal', href: '/blog/future-of-nursing-in-nepal-telehealth-community-care-post-covid/' }
];
---

<section class="ledger-section ledger-section--registry" id="credentials" aria-labelledby="credentials-title">
  <div class="container">
    <header class="ledger-section__header" data-ledger-reveal>
      <p class="ledger-kicker">Credential registry</p>
      <h2 id="credentials-title">Licenses and clinical training, indexed.</h2>
      <p>Verification documents are shared privately with legitimate employers and recruiters.</p>
    </header>

    <div class="credential-registry" data-ledger-group>
      {profile.certifications.slice(0, 6).map((credential, index) => (
        <article class="credential-registry__entry" data-ledger-reveal>
          <span class="credential-registry__number">{String(index + 1).padStart(2, '0')}</span>
          <div><p>{credential.issuer}</p><h3>{credential.title}</h3></div>
          <div><p>{credential.date}</p><span>{credential.credentialLabel ?? 'Verification available on request'}</span></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="ledger-section ledger-section--reading" id="writing" aria-labelledby="writing-title">
  <div class="container">
    <header class="ledger-section__header ledger-section__header--split" data-ledger-reveal>
      <div>
        <p class="ledger-kicker">Selected writing / reading file</p>
        <h2 id="writing-title">Practical nursing notes for real decisions.</h2>
      </div>
      <a class="ledger-link" href="/blog/">Open the article index</a>
    </header>

    <div class="reading-index" data-ledger-group>
      {featuredWriting.map((article, index) => (
        <a class={`reading-index__entry ${index === 0 ? 'reading-index__entry--feature' : ''}`} href={article.href} data-ledger-reveal>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{article.category}</p>
          <h3>{article.title}</h3>
          <small>Read guide</small>
        </a>
      ))}
    </div>
  </div>
</section>
