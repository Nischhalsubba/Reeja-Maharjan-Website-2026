---
import { recruiterCopy } from '../content/recruiter-copy';

const copy = recruiterCopy.focus;
const pathways = copy.areas;
---

<section class="fj-section fj-section--surface" id="role-fit" aria-labelledby="role-fit-title">
  <div class="container">
    <header class="fj-section__head" data-fj-reveal>
      <p class="fj-kicker">{copy.kicker}</p>
      <div>
        <h2 id="role-fit-title">{copy.title}</h2>
        <p>{copy.summary}</p>
      </div>
    </header>

    <div class="fj-notes" data-fj-group>
      {pathways.map((pathway, index) => (
        <article class="fj-note" data-fj-reveal>
          <div class="fj-note__number">0{index + 1}<br />{pathway.label}</div>
          <div>
            <h3>{pathway.title}</h3>
          </div>
          <div class="fj-note__copy">
            <p>{pathway.summary}</p>
            <ul>{pathway.evidence.slice(0, 2).map((item) => <li>{item}</li>)}</ul>
          </div>
          <div class="fj-note__aside">
            <a class="fj-link" href={pathway.href}>{pathway.cta}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
