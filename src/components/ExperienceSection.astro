---
import SectionIntro from './SectionIntro.astro';
import SectionIcon from './SectionIcon.astro';
import type { ProfileContent } from '../content/profile';

type Props = { profile: ProfileContent };
const { profile } = Astro.props;
---

<section class="section" id={profile.experienceIntro.id} data-reveal-group>
  <div class="container">
    <article class="section-shell" data-reveal>
      <header class="section-shell__head">
        <span class="section-shell__icon"><SectionIcon name="experience" /></span>
        <SectionIntro
          eyebrow={profile.experienceIntro.eyebrow}
          title={profile.experienceIntro.title}
          summary={profile.experienceIntro.summary}
        />
      </header>

      <div class="section-shell__body">
        <ol class="timeline-list">
          {
            profile.experience.map((item) => (
              <li class="timeline-list__item">
                <span class="timeline-list__dot" aria-hidden="true" />
                <article class="timeline-list__content">
                  <div class="timeline-list__row">
                    <h3>{item.role}</h3>
                    <time class="timeline-list__date">{item.period}</time>
                  </div>

                  <p class="timeline-list__meta">
                    {item.organization} | {item.type}
                  </p>
                  <p class="timeline-list__meta timeline-list__meta--location">{item.location}</p>

                  {item.tags && item.tags.length > 0 && (
                    <ul
                      class="chip-list timeline-list__tags"
                      aria-label={`${item.organization} experience tags`}
                    >
                      {item.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}

                  <ul class="check-list timeline-list__summary">
                    {item.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>

                  <p class="note">
                    Experience verification can be shared privately with recruiters on request.
                  </p>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </article>
  </div>
</section>
