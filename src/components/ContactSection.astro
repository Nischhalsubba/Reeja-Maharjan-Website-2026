---
import SectionIntro from './SectionIntro.astro';
import SectionIcon from './SectionIcon.astro';
import type { ProfileContent } from '../content/profile';

type Props = { profile: ProfileContent };
const { profile } = Astro.props;
---

<section class="section" id={profile.contactIntro.id} data-reveal-group>
  <div class="container section-stack">
    <div class="contact-cta" data-reveal>
      <img src="/reeja-headshot.jpg" alt="Reeja Maharjan profile portrait" width="84" height="84" />
      <p class="section-intro__eyebrow">Available for nursing and research roles</p>
      <h2>{profile.contactIntro.title}</h2>
      <p>{profile.contactIntro.summary}</p>
      <ul class="chip-list contact-availability" aria-label="Opportunity fit">
        <li>Hospitals</li>
        <li>Research projects</li>
        <li>NGOs / INGOs</li>
        <li>Maternal health</li>
        <li>Telemonitoring</li>
        <li>Data documentation</li>
      </ul>
      <div class="contact-form__actions">
        <a class="btn btn--primary" href={`mailto:${profile.contact.email}`}>Email Reeja</a>
        <a class="btn btn--secondary" href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn btn--secondary" href="/cv/">View CV</a>
      </div>
      <p class="note">Preferred contact: email or LinkedIn. Full documents can be shared privately after recruiter screening.</p>
    </div>

    <article class="section-shell" data-reveal>
      <header class="section-shell__head">
        <span class="section-shell__icon"><SectionIcon name="contact" /></span>
        <SectionIntro
          eyebrow={profile.contactIntro.eyebrow}
          title="Send a Role Inquiry"
          summary="Share the role, organization, location, and expected start date so the message is useful from the first email. Revolutionary, I know."
        />
      </header>

      <form
        id="contact-form"
        class="section-shell__body contact-form"
        aria-label="Recruiter contact form"
        method="POST"
        action={profile.contact.formEndpoint ?? 'https://formsubmit.co/ajax/maharjanreeja88@gmail.com'}
        data-endpoint={profile.contact.formEndpoint}
      >
        <div class="contact-form__grid">
          <label>
            Name
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            Organization / Hospital
            <input type="text" name="organization" autocomplete="organization" />
          </label>
          <label>
            Role type
            <input type="text" name="role_type" placeholder="Hospital, research, NGO, INGO, maternal care..." />
          </label>
          <label>
            Location
            <input type="text" name="location" autocomplete="address-level2" />
          </label>
          <label>
            Expected start date
            <input type="text" name="start_date" placeholder="Immediate, month, or flexible" />
          </label>
        </div>
        <label>
          Message
          <textarea name="message" rows="5" required placeholder="Briefly describe the role, care setting, research project, schedule, and next step."></textarea>
        </label>
        <input type="hidden" name="_subject" value="New nursing or research opportunity inquiry from reejamaharjan.com.np" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" hidden />

        <div class="contact-form__actions">
          <button type="submit" class="btn btn--primary">Send Inquiry</button>
          <a class="btn btn--secondary" href={`mailto:${profile.contact.email}`}>Use Email Instead</a>
          <a class="btn btn--secondary" href="/cv/">Open CV</a>
        </div>

        <p class="form-status form-status--success" role="status" aria-live="polite" hidden>
          Message sent successfully. Reeja will reply by email.
        </p>
        <p class="form-status form-status--error" role="alert" aria-live="assertive" hidden>
          Message could not be sent. Please use the email button instead.
        </p>
      </form>
    </article>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');

  if (form instanceof HTMLFormElement) {
    const configuredEndpoint = form.dataset.endpoint;
    const endpoint =
      configuredEndpoint ||
      import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ||
      'https://formsubmit.co/ajax/maharjanreeja88@gmail.com';

    form.action = endpoint;

    const success = form.querySelector('.form-status--success');
    const error = form.querySelector('.form-status--error');
    const submit = form.querySelector('button[type="submit"]');

    if (success instanceof HTMLElement) success.hidden = true;
    if (error instanceof HTMLElement) error.hidden = true;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!(submit instanceof HTMLButtonElement)) return;

      submit.disabled = true;
      submit.textContent = 'Sending...';
      if (success instanceof HTMLElement) success.hidden = true;
      if (error instanceof HTMLElement) error.hidden = true;

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData
        });

        if (!response.ok) throw new Error('Request failed');
        const result = await response.json().catch(() => ({}));
        const sent = String(result?.success ?? '').toLowerCase() === 'true';
        if (!sent) throw new Error('Provider rejected');

        form.reset();
        if (success instanceof HTMLElement) success.hidden = false;
      } catch {
        if (error instanceof HTMLElement) error.hidden = false;
      } finally {
        submit.disabled = false;
        submit.textContent = 'Send Inquiry';
      }
    });
  }
</script>
