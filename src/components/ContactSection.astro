---
import SectionIntro from './SectionIntro.astro';
import SectionIcon from './SectionIcon.astro';
import type { ProfileContent } from '../content/profile';
import '../styles/contact-flow.css';

type Props = { profile: ProfileContent };
const { profile } = Astro.props;
---

<section class="section" id={profile.contactIntro.id} data-reveal-group>
  <div class="container section-stack">
    <div class="contact-cta" data-reveal>
      <img src="/reeja-headshot.jpg" alt="Reeja Maharjan profile portrait" width="84" height="84" />
      <p class="section-intro__eyebrow">Available for nursing and research roles</p>
      <h2>{profile.contactIntro.title}</h2>
      <p>{profile.contactIntro.summary}</p>
      <ul class="chip-list contact-availability" aria-label="Opportunity fit">
        <li>Hospitals</li>
        <li>Research projects</li>
        <li>NGOs / INGOs</li>
        <li>Maternal health</li>
        <li>Telemonitoring</li>
        <li>Data documentation</li>
      </ul>
      <div class="contact-form__actions">
        <a class="btn btn--primary" href={`mailto:${profile.contact.email}`} data-track="contact-direct-email">Email Reeja</a>
        <a class="btn btn--secondary" href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer" data-track="contact-linkedin">LinkedIn</a>
        <a class="btn btn--secondary" href="/cv/" data-track="contact-cv">View CV</a>
      </div>
      <p class="note">Preferred contact: email or LinkedIn. Full documents can be shared privately after recruiter screening.</p>
    </div>

    <article class="section-shell" data-reveal>
      <header class="section-shell__head">
        <span class="section-shell__icon"><SectionIcon name="contact" /></span>
        <SectionIntro
          eyebrow={profile.contactIntro.eyebrow}
          title="Send a Role Inquiry"
          summary="Share the role, organisation, location, expected timing, and responsibilities so the first message is useful for screening."
        />
      </header>

      <form
        id="contact-form"
        class="section-shell__body contact-form"
        aria-label="Recruiter contact form"
        method="POST"
        action={profile.contact.formEndpoint ?? 'https://formsubmit.co/ajax/maharjanreeja88@gmail.com'}
        data-endpoint={profile.contact.formEndpoint}
        novalidate
      >
        <div class="contact-form__grid">
          <label>
            Name
            <input type="text" name="name" autocomplete="name" required minlength="2" />
          </label>
          <label>
            Email
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            Organisation / hospital
            <input type="text" name="organization" autocomplete="organization" />
          </label>
          <label>
            Role type
            <input type="text" name="role_type" placeholder="Hospital, research, NGO, INGO, maternal care..." />
          </label>
          <label>
            Location
            <input type="text" name="location" autocomplete="address-level2" />
          </label>
          <label>
            Expected timing
            <input type="text" name="start_date" placeholder="Month, quarter, or flexible timing" />
          </label>
        </div>
        <label>
          Message
          <textarea name="message" rows="5" required minlength="20" placeholder="Briefly describe the role, care setting, research project, schedule, responsibilities, and next step."></textarea>
        </label>
        <input type="hidden" name="_subject" value="New nursing or research opportunity inquiry from reejamaharjan.com.np" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" hidden aria-hidden="true" />

        <p class="contact-form__privacy-note">Do not send confidential patient information, license documents, transcripts, identity documents, or private health records through this public form.</p>

        <div class="contact-form__actions">
          <button type="submit" class="btn btn--primary" data-default-label="Send Inquiry">Send Inquiry</button>
          <a class="btn btn--secondary" href={`mailto:${profile.contact.email}`} data-track="contact-form-email-fallback">Use Email Instead</a>
          <a class="btn btn--secondary" href="/cv/" data-track="contact-form-cv">Open CV</a>
        </div>

        <p class="form-status form-status--loading" role="status" aria-live="polite" hidden>
          Sending inquiry. Please keep this page open until the result appears.
        </p>
        <p class="form-status form-status--success" role="status" aria-live="polite" hidden tabindex="-1">
          Message sent successfully. Reeja will reply by email when appropriate.
        </p>
        <p class="form-status form-status--error" role="alert" aria-live="assertive" hidden tabindex="-1">
          Message could not be sent. Please use the email button instead and include the same role details.
        </p>
      </form>
    </article>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');

  if (form instanceof HTMLFormElement) {
    const configuredEndpoint = form.dataset.endpoint;
    const endpoint =
      configuredEndpoint ||
      import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ||
      'https://formsubmit.co/ajax/maharjanreeja88@gmail.com';

    form.action = endpoint;

    const loading = form.querySelector('.form-status--loading');
    const success = form.querySelector('.form-status--success');
    const error = form.querySelector('.form-status--error');
    const submit = form.querySelector('button[type="submit"]');
    const defaultLabel = submit instanceof HTMLButtonElement ? submit.dataset.defaultLabel ?? submit.textContent ?? 'Send Inquiry' : 'Send Inquiry';

    const setStatus = (state) => {
      for (const element of [loading, success, error]) {
        if (element instanceof HTMLElement) element.hidden = true;
      }

      const active = state === 'loading' ? loading : state === 'success' ? success : state === 'error' ? error : null;
      if (active instanceof HTMLElement) {
        active.hidden = false;
        if (state !== 'loading') active.focus({ preventScroll: false });
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!(submit instanceof HTMLButtonElement)) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      submit.textContent = 'Sending...';
      setStatus('loading');

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData
        });

        if (!response.ok) throw new Error('Request failed');
        const result = await response.json().catch(() => ({}));
        const sent = String(result?.success ?? response.ok).toLowerCase() !== 'false';
        if (!sent) throw new Error('Provider rejected');

        form.reset();
        setStatus('success');
      } catch {
        setStatus('error');
      } finally {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
        submit.textContent = defaultLabel;
      }
    });
  }
</script>
