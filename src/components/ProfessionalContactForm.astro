---
import { professionalFacts } from '../content/professional-facts';

const directEmailHref = `mailto:${professionalFacts.professionalEmail}?subject=${encodeURIComponent(`Professional opportunity for ${professionalFacts.name}`)}`;
const contactReturnUrl = 'https://reejamaharjan.com.np/contact/?sent=1#professional-contact-form';
---

<form
  class="professional-contact-form"
  id="professional-contact-form"
  method="POST"
  action={professionalFacts.contactFormEndpoint}
  data-contact-form
  aria-labelledby="contact-form-title"
>
  <div class="professional-contact-form__heading">
    <p class="site-eyebrow">Send a message</p>
    <h2 id="contact-form-title">Share the opportunity details.</h2>
    <p>Required fields are marked with an asterisk. Please do not include confidential patient information or private identity documents.</p>
  </div>

  <div class="professional-contact-form__grid">
    <div class="form-field">
      <label for="contact-name">Name <span aria-hidden="true">*</span></label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required minlength="2" aria-describedby="contact-name-error" />
      <p class="form-field__error" id="contact-name-error" data-error-for="contact-name" role="alert" hidden></p>
    </div>

    <div class="form-field">
      <label for="contact-email">Email <span aria-hidden="true">*</span></label>
      <input id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" required aria-describedby="contact-email-error" />
      <p class="form-field__error" id="contact-email-error" data-error-for="contact-email" role="alert" hidden></p>
    </div>

    <div class="form-field">
      <label for="contact-organisation">Organisation / hospital</label>
      <input id="contact-organisation" name="organization" type="text" autocomplete="organization" />
    </div>

    <div class="form-field">
      <label for="contact-role">Role / opportunity type</label>
      <input id="contact-role" name="role_type" type="text" placeholder="Hospital role, research project, NGO programme…" />
    </div>

    <div class="form-field professional-contact-form__full">
      <label for="contact-location">Location</label>
      <input id="contact-location" name="location" type="text" autocomplete="address-level2" placeholder="City, country, or remote/hybrid" />
    </div>

    <div class="form-field professional-contact-form__full">
      <label for="contact-message">Message <span aria-hidden="true">*</span></label>
      <textarea
        id="contact-message"
        name="message"
        rows="7"
        required
        minlength="20"
        aria-describedby="contact-message-help contact-message-error"
        placeholder="Briefly describe the role or project, responsibilities, expected timing, and the best next step."
      ></textarea>
      <p class="form-field__help" id="contact-message-help">A short, specific message is enough. Verification documents can be requested later.</p>
      <p class="form-field__error" id="contact-message-error" data-error-for="contact-message" role="alert" hidden></p>
    </div>
  </div>

  <input type="hidden" name="_subject" value="New professional inquiry from reejamaharjan.com.np" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_next" value={contactReturnUrl} />
  <input type="hidden" name="_url" value="https://reejamaharjan.com.np/contact/" />
  <input class="form-honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="professional-contact-form__privacy">
    <strong>Privacy note</strong>
    <p>Do not send patient information, private health records, identity documents, license scans, transcripts, or other sensitive records through this public form.</p>
  </div>

  <div class="professional-contact-form__actions">
    <button class="care-button care-button--primary" type="submit" data-submit-button>
      <span data-submit-label>Send message</span>
      <span class="form-spinner" aria-hidden="true" hidden data-submit-spinner></span>
    </button>
    <a class="care-button care-button--secondary" href={directEmailHref} data-track="contact-email-fallback">Email directly</a>
  </div>

  <div class="professional-contact-form__status" aria-live="polite" aria-atomic="true">
    <p class="form-status form-status--loading" role="status" hidden data-form-loading>Submitting your message securely…</p>
    <div class="form-status form-status--success" role="status" tabindex="-1" hidden data-form-success>
      <strong>Message submitted.</strong>
      <p>Your inquiry was accepted for delivery to {professionalFacts.professionalEmail}. Reeja can reply by email when appropriate.</p>
    </div>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit-button]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const submitSpinner = form.querySelector<HTMLElement>('[data-submit-spinner]');
    const loadingStatus = form.querySelector<HTMLElement>('[data-form-loading]');
    const successStatus = form.querySelector<HTMLElement>('[data-form-success]');

    const fieldMessage = (field: HTMLInputElement | HTMLTextAreaElement): string => {
      if (field.validity.valueMissing) return 'Please complete this field.';
      if (field.validity.typeMismatch && field.type === 'email') return 'Enter a valid email address.';
      if (field.validity.tooShort) {
        const minimum = field.minLength;
        return minimum > 0 ? `Please enter at least ${minimum} characters.` : 'Please add a little more detail.';
      }
      return 'Please check this field.';
    };

    const showFieldError = (field: HTMLInputElement | HTMLTextAreaElement): boolean => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
      if (!error) return field.validity.valid;
      const valid = field.validity.valid;
      error.hidden = valid;
      error.textContent = valid ? '' : fieldMessage(field);
      if (valid) field.removeAttribute('aria-invalid');
      else field.setAttribute('aria-invalid', 'true');
      return valid;
    };

    const validatedFields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]')
    );

    validatedFields.forEach((field) => {
      field.addEventListener('invalid', () => showFieldError(field));
      field.addEventListener('blur', () => showFieldError(field));
      field.addEventListener('input', () => {
        if (field.hasAttribute('aria-invalid')) showFieldError(field);
      });
    });

    const setStatus = (state: 'idle' | 'loading' | 'success') => {
      [loadingStatus, successStatus].forEach((element) => {
        if (element) element.hidden = true;
      });

      if (state === 'loading' && loadingStatus) loadingStatus.hidden = false;
      if (state === 'success' && successStatus) {
        successStatus.hidden = false;
        successStatus.focus();
      }
    };

    const setSubmitting = (submitting: boolean) => {
      if (!submitButton) return;
      submitButton.disabled = submitting;
      submitButton.toggleAttribute('aria-busy', submitting);
      if (submitLabel) submitLabel.textContent = submitting ? 'Submitting…' : 'Send message';
      if (submitSpinner) submitSpinner.hidden = !submitting;
    };

    const showRedirectSuccess = () => {
      const url = new URL(window.location.href);
      if (url.searchParams.get('sent') !== '1') return;

      form.reset();
      validatedFields.forEach((field) => field.removeAttribute('aria-invalid'));
      setStatus('success');

      url.searchParams.delete('sent');
      const cleanUrl = `${url.pathname}${url.search}${url.hash}`;
      window.history.replaceState({}, '', cleanUrl);
    };

    form.addEventListener('submit', (event) => {
      setStatus('idle');

      const firstInvalid = validatedFields.find((field) => !showFieldError(field));
      if (firstInvalid) {
        event.preventDefault();
        firstInvalid.focus();
        return;
      }

      const honeypot = form.elements.namedItem('_honey');
      if (honeypot instanceof HTMLInputElement && honeypot.value) {
        event.preventDefault();
        return;
      }

      setSubmitting(true);
      setStatus('loading');
    });

    window.addEventListener('pageshow', () => setSubmitting(false));
    showRedirectSuccess();
  }
</script>
