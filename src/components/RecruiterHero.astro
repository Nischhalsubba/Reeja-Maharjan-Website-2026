---
import { profile } from '../content/profile';
import { professionalFacts } from '../content/professional-facts';
import HeroSpatialScene from './HeroSpatialScene.astro';
---

<section class="ledger-hero" id="home" aria-labelledby="home-title">
  <div class="ledger-hero__scene" aria-hidden="true"><HeroSpatialScene /></div>

  <div class="container ledger-hero__grid">
    <aside class="ledger-hero__margin" aria-label="Profile index" data-ledger-stage>
      <span>Profile / 01</span>
      <span>Biratnagar, Nepal</span>
      <span>Verified {professionalFacts.lastVerified}</span>
    </aside>

    <div class="ledger-hero__content">
      <p class="ledger-kicker" data-ledger-stage>Registered Nurse · Maternal-health research</p>
      <p class="ledger-hero__name" data-ledger-stage>{professionalFacts.name}, {professionalFacts.credential}</p>
      <h1 id="home-title" data-ledger-title>
        <span>Clinical care,</span>
        <span>recorded with</span>
        <span>research discipline.</span>
      </h1>
      <p class="ledger-hero__intro" data-ledger-stage>
        {professionalFacts.nepalLicense} and {professionalFacts.texasLicense}, with hospital experience and current maternal-health research work involving participant education, BP/BG telemonitoring, documentation, and care coordination.
      </p>

      <div class="ledger-hero__actions" aria-label="Primary actions" data-ledger-stage>
        <a class="ledger-button ledger-button--ink" href="/hire-reeja/" data-track="home-hire">Discuss an opportunity</a>
        <a class="ledger-link" href={professionalFacts.publicCvPath} data-track="home-cv">Read the CV</a>
      </div>

      <p class="ledger-hero__status" data-ledger-stage>
        <span aria-hidden="true"></span>
        {professionalFacts.availability}
      </p>
    </div>

    <figure class="ledger-portrait" data-ledger-portrait>
      <div class="ledger-portrait__frame">
        <img
          src={profile.hero.portrait.src}
          alt={profile.hero.portrait.alt}
          width="760"
          height="920"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption>
        <span>Fig. 01</span>
        <span>{professionalFacts.currentRole}, {professionalFacts.currentEmployerShort}</span>
      </figcaption>
    </figure>
  </div>

  <div class="container ledger-proof" aria-label="Professional credibility" data-ledger-proof>
    <div><span>Registration</span><strong>{professionalFacts.nepalLicenseShort}</strong></div>
    <div><span>International license</span><strong>{professionalFacts.texasLicenseShort}</strong></div>
    <div><span>Current work</span><strong>{professionalFacts.currentEmployerShort} {professionalFacts.currentProjectShort}</strong></div>
    <div><span>Clinical background</span><strong>Hospital nursing in Nepal</strong></div>
  </div>
</section>
