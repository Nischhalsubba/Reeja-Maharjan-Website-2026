---
import type { ProfileContent } from '../content/profile';

type Props = {
  profile: ProfileContent;
  mode?: 'one-page' | 'blog';
};

const { profile, mode = 'one-page' } = Astro.props;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__eyebrow">Registered Nurse</p>
      <h2>{profile.name}</h2>
      <p>Clinical care, maternal health research, and clear patient communication.</p>
    </div>

    <nav aria-label="Footer quick links" class="site-footer__links">
      <a href={mode === 'blog' ? '/' : '#home'}>Home</a>
      <a href={mode === 'blog' ? '/#experience' : '#experience'}>Experience</a>
      <a href={mode === 'blog' ? '/#credentials' : '#credentials'}>Credentials</a>
      <a href="/cv/">CV</a>
      <a href="/blog/">Writing</a>
    </nav>

    <div class="site-footer__contact">
      <a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
      <a href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <span>{profile.contact.location}</span>
    </div>
  </div>

  <div class="container site-footer__legal">
    <small>(c) {new Date().getFullYear()} {profile.name}</small>
    <a href={mode === 'blog' ? '/#home' : '#home'}>Back to top</a>
  </div>
</footer>
