---
import type { ProfileContent } from '../content/profile';

type Props = {
  profile: ProfileContent;
  mode?: 'one-page' | 'blog';
};

const { profile } = Astro.props;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__eyebrow">Registered Nurse</p>
      <h2>{profile.name}</h2>
      <p>Clinical care, maternal health research, patient education, and careful documentation.</p>
    </div>

    <nav aria-label="Professional resources" class="site-footer__links">
      <a href="/maternal-health/">Maternal health</a>
      <a href="/nursing-practice/">Nursing practice</a>
      <a href="/clinical-research/">Clinical research</a>
      <a href="/blog/">Writing</a>
      <a href="/cv/" data-track="cv-footer">CV</a>
      <a href="/hire-reeja/" data-track="hire-footer">Hire Reeja</a>
    </nav>

    <div class="site-footer__contact">
      <a href={`mailto:${profile.contact.email}`} data-track="email-footer">{profile.contact.email}</a>
      <a href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer" data-track="linkedin-footer">LinkedIn</a>
      <span>{profile.contact.location}</span>
    </div>
  </div>

  <div class="container site-footer__legal">
    <small>(c) {new Date().getFullYear()} {profile.name}</small>
    <a href="#main-content">Back to top</a>
  </div>
</footer>
