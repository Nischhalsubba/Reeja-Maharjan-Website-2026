---
import { profile } from '../content/profile';
import { professionalFacts } from '../content/professional-facts';
const selectedExperience = profile.experience.slice(0, 3);
---

<section class="ledger-section ledger-section--experience" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <header class="ledger-section__header ledger-section__header--split" data-ledger-reveal>
      <div>
        <p class="ledger-kicker">Selected experience / chronology</p>
        <h2 id="experience-title">Care work across hospital and research settings.</h2>
      </div>
      <a class="ledger-link" href={professionalFacts.publicCvPath}>Read the complete CV</a>
    </header>

    <ol class="experience-ledger" data-ledger-group>
      {selectedExperience.map((item, index) => (
        <li class="experience-ledger__entry" data-ledger-reveal>
          <div class="experience-ledger__folio">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <time>{item.period}</time>
          </div>
          <div class="experience-ledger__role">
            <p>{item.organization}</p>
            <h3>{item.role}</h3>
            <span>{item.location}</span>
          </div>
          <div class="experience-ledger__record">
            <p>{item.bullets[0]}</p>
            {item.tags && <p class="experience-ledger__terms">{item.tags.slice(0, 4).join(' · ')}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
