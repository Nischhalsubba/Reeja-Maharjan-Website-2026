---
import { professionalFacts } from '../content/professional-facts';
---

<section class="ledger-contact care-contact-cta" id="contact" aria-labelledby="contact-title">
  <div class="container care-contact-cta__inner" data-motion-reveal>
    <div class="care-contact-cta__copy">
      <p class="ledger-kicker">Professional contact</p>
      <h2 id="contact-title">Start a conversation about a nursing, research, or health-programme opportunity.</h2>
      <p>Share the organisation, role, location, and a short description of the work. Reeja can provide private verification documents where appropriate.</p>
    </div>
    <div class="care-contact-cta__actions">
      <a class="care-button care-button--primary" href="/contact/" data-track="home-contact-final">Contact Reeja</a>
      <a class="care-link" href={professionalFacts.linkedin} target="_blank" rel="noopener noreferrer" data-track="contact-linkedin">LinkedIn profile</a>
      <span>{professionalFacts.professionalEmail}</span>
    </div>
  </div>
</section>
