---
import { professionalFacts } from '../content/professional-facts';
const emailSubject = encodeURIComponent(`Nursing or research opportunity for ${professionalFacts.name}`);
---

<section class="ledger-contact" id="contact" aria-labelledby="contact-title">
  <div class="container ledger-contact__grid">
    <div class="ledger-contact__index" data-ledger-reveal>
      <span>Correspondence / 07</span>
      <p>{professionalFacts.currentLocation}</p>
    </div>
    <div class="ledger-contact__title" data-ledger-reveal>
      <p class="ledger-kicker ledger-kicker--inverse">Professional correspondence</p>
      <h2 id="contact-title">Planning a nursing, research, or health-programme role?</h2>
    </div>
    <div class="ledger-contact__copy" data-ledger-reveal>
      <p>Share the organisation, role title, location, expected start date, and a short description of the responsibilities. Private verification documents can be provided where appropriate.</p>
      <div class="ledger-contact__actions">
        <a class="ledger-button ledger-button--paper" href={`mailto:${professionalFacts.professionalEmail}?subject=${emailSubject}`} data-track="contact-email">Share opportunity details</a>
        <a class="ledger-link ledger-link--inverse" href={professionalFacts.linkedin} target="_blank" rel="noopener noreferrer" data-track="contact-linkedin">LinkedIn profile</a>
      </div>
      <a class="ledger-contact__email" href={`mailto:${professionalFacts.professionalEmail}`}>{professionalFacts.professionalEmail}</a>
    </div>
  </div>
</section>
