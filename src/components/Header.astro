---
type Props = {
  name: string;
  showAwards?: boolean;
  mode?: 'one-page' | 'blog';
};

const { name, mode = 'one-page' } = Astro.props;
---

<header class="site-header" aria-label="Primary">
  <div class="container site-header__inner">
    <a class="brand" href={mode === 'one-page' ? '#home' : '/'} aria-label="Go to Reeja Maharjan homepage">
      <span class="brand__mark">RM</span>
      <span class="brand__text">
        <strong>{name}</strong>
        <small>Registered Nurse</small>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      Menu
    </button>

    <nav class="desktop-nav" aria-label="Site navigation">
      <a href={mode === 'one-page' ? '#experience' : '/#experience'}>Experience</a>
      <a href="/maternal-health/">Maternal health</a>
      <a href="/nursing-practice/">Nursing</a>
      <a href="/clinical-research/">Research</a>
      <a href="/blog/">Writing</a>
      <a href="/cv/">CV</a>
      <a href="/hire-reeja/" data-track="hire-nav">Hire Reeja</a>
    </nav>
  </div>

  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    <nav class="mobile-nav__panel" aria-label="Mobile site navigation">
      <button class="mobile-nav__close" type="button" data-mobile-nav-close>Close</button>
      <a href="/">Home</a>
      <a href="/#experience">Experience</a>
      <a href="/maternal-health/">Maternal health</a>
      <a href="/nursing-practice/">Nursing practice</a>
      <a href="/clinical-research/">Clinical research</a>
      <a href="/blog/">Writing</a>
      <a href="/cv/">CV</a>
      <a href="/hire-reeja/" data-track="hire-mobile-nav">Hire Reeja</a>
    </nav>
  </div>
</header>
