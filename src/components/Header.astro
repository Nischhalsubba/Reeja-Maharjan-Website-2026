---
type Props = {
  name: string;
  showAwards?: boolean;
  mode?: 'one-page' | 'blog';
};

const { name, mode = 'one-page' } = Astro.props;
---

<header class="site-header" aria-label="Primary navigation">
  <div class="container site-header__inner">
    <a class="brand" href={mode === 'one-page' ? '#home' : '/'} aria-label="Reeja Maharjan registered nurse homepage">
      <span class="brand__mark">RM</span>
      <span class="brand__text">
        <strong>{name}</strong>
        <small>Registered Nurse · Research Assistant</small>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      Menu
    </button>

    <nav class="desktop-nav" aria-label="Website navigation">
      <a href={mode === 'one-page' ? '#experience' : '/#experience'}>Experience</a>
      <a href="/maternal-health/">Maternal health</a>
      <a href="/nursing-practice/">Nursing guides</a>
      <a href="/clinical-research/">Clinical research</a>
      <a href="/blog/">Articles</a>
      <a href="/cv/">Nursing CV</a>
      <a href="/hire-reeja/" data-track="hire-nav">Hire Reeja</a>
    </nav>
  </div>

  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    <nav class="mobile-nav__panel" aria-label="Mobile website navigation">
      <button class="mobile-nav__close" type="button" data-mobile-nav-close>Close menu</button>
      <a href="/">Home</a>
      <a href="/#experience">Clinical experience</a>
      <a href="/maternal-health/">Maternal health resources</a>
      <a href="/nursing-practice/">Nursing practice guides</a>
      <a href="/clinical-research/">Clinical research experience</a>
      <a href="/blog/">Nursing articles</a>
      <a href="/cv/">Download nursing CV</a>
      <a href="/hire-reeja/" data-track="hire-mobile-nav">Recruit Reeja</a>
    </nav>
  </div>
</header>
