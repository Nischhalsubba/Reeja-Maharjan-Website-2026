---
import { siteCopy } from '../content/site-copy';

type Props = { name: string };
const { name } = Astro.props;
const path = Astro.url.pathname;
const current = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const links = siteCopy.navigation;
---

<header class="site-header" aria-label="Primary navigation" data-site-header>
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${name} homepage`}>
      <span class="brand__mark" aria-hidden="true">RM</span>
      <span class="brand__text">
        <strong>{name}</strong>
        <small>{siteCopy.siteDescriptor}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={link.href !== '/#experience' && current(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a class="nav-cta" href="/contact/" aria-current={current('/contact/') ? 'page' : undefined} data-track="contact-nav">
        Contact Reeja
      </a>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-haspopup="dialog"
      aria-label="Menu"
    >
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div
    class="mobile-nav"
    id="mobile-nav"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    aria-hidden="true"
  >
    <nav class="mobile-nav__panel" aria-label="Mobile navigation links">
      <div class="mobile-nav__head">
        <div>
          <span class="mobile-nav__eyebrow">{name}</span>
          <strong id="mobile-nav-title">Explore Reeja’s portfolio</strong>
          <small>{siteCopy.siteDescriptor}</small>
        </div>
        <button class="mobile-nav__close" type="button" data-mobile-nav-close aria-label="Close menu">
          <span aria-hidden="true"></span>
        </button>
      </div>
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>About Reeja</a>
      {links.map((link) => (
        <a href={link.href} aria-current={link.href !== '/#experience' && current(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a class="mobile-nav__cta" href="/contact/" aria-current={current('/contact/') ? 'page' : undefined} data-track="contact-mobile-nav">
        Contact Reeja
      </a>
    </nav>
  </div>
</header>
