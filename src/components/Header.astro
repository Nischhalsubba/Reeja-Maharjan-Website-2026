---
type Props = {
  name: string;
  showAwards?: boolean;
  mode?: 'one-page' | 'blog';
};

const { name, mode = 'one-page' } = Astro.props;
---

<header class="site-header" aria-label="Primary">
  <div class="container site-header__inner">
    <a class="brand" href={mode === 'blog' ? '/' : '#home'} aria-label="Go to Reeja Maharjan homepage">
      <span class="brand__mark">RM</span>
      <span class="brand__text">
        <strong>{name}</strong>
        <small>Registered Nurse</small>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      Menu
    </button>

    {
      mode === 'one-page' ? (
        <nav class="desktop-nav" aria-label="Section navigation">
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="#focus">Focus</a>
          <a href="#credentials">Credentials</a>
          <a href="#writing">Writing</a>
          <a href="/cv/">CV</a>
          <a href="#contact">Hire Reeja</a>
        </nav>
      ) : (
        <nav class="desktop-nav" aria-label="Site navigation">
          <a href="/">Home</a>
          <a href="/#experience">Experience</a>
          <a href="/#credentials">Credentials</a>
          <a href="/cv/">CV</a>
          <a href="/blog/">Writing</a>
          <a href="/#contact">Hire Reeja</a>
        </nav>
      )
    }
  </div>

  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    {
      mode === 'one-page' ? (
        <nav class="mobile-nav__panel" aria-label="Mobile section navigation">
          <button class="mobile-nav__close" type="button" data-mobile-nav-close>Close</button>
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="#focus">Focus</a>
          <a href="#credentials">Credentials</a>
          <a href="#writing">Writing</a>
          <a href="/cv/">CV</a>
          <a href="#contact">Hire Reeja</a>
        </nav>
      ) : (
        <nav class="mobile-nav__panel" aria-label="Mobile site navigation">
          <button class="mobile-nav__close" type="button" data-mobile-nav-close>Close</button>
          <a href="/">Home</a>
          <a href="/#experience">Experience</a>
          <a href="/#credentials">Credentials</a>
          <a href="/cv/">CV</a>
          <a href="/blog/">Writing</a>
          <a href="/#contact">Hire Reeja</a>
        </nav>
      )
    }
  </div>
</header>
