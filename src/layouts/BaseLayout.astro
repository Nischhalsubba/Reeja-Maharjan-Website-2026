---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../content/profile';

type Props = {
  title?: string;
  description?: string;
  image?: string;
};

const {
  title = `${profile.name} | ${profile.role}`,
  description = profile.hero.tagline,
  image = '/reeja-headshot.jpg'
} = Astro.props;
const isBlogPage = Astro.url.pathname.startsWith('/blog');
const isOnePage = Astro.url.pathname === '/';
const navigationMode = isOnePage ? 'one-page' : 'blog';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
const sameAs = [profile.contact.linkedin, profile.contact.instagram].filter(Boolean);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description,
  email: profile.contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.contact.location
  },
  knowsAbout: profile.keywords,
  sameAs
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={isBlogPage ? 'article' : 'profile'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Reeja Maharjan" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <meta name="robots" content="index, follow" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :where(a, button, input, textarea):focus-visible {
        outline: 3px solid color-mix(in srgb, var(--accent) 42%, transparent);
        outline-offset: 3px;
      }

      body {
        background: linear-gradient(180deg, #f7fffd 0%, var(--bg) 44%, #f8fbff 100%);
      }

      .site-header {
        background: color-mix(in srgb, var(--surface) 92%, transparent);
        border-bottom-color: color-mix(in srgb, var(--line) 70%, transparent);
        box-shadow: 0 8px 30px rgba(8, 63, 74, 0.05);
      }

      .site-header__inner {
        min-height: 64px;
      }

      .brand__mark,
      .desktop-nav a:last-child,
      .btn--primary {
        background: linear-gradient(135deg, var(--accent), var(--clinical-blue));
        color: var(--accent-text);
      }

      .brand__text small,
      .section-intro__eyebrow,
      .text-link,
      .hero__role {
        color: var(--accent);
      }

      .desktop-nav a:last-child,
      .btn--primary {
        box-shadow: 0 14px 34px rgba(8, 118, 111, 0.18);
      }

      .btn--secondary {
        background: var(--surface);
        border-color: var(--line-strong);
      }

      .hero {
        padding-block: clamp(28px, 8vw, 86px);
        overflow: visible;
      }

      .hero::before {
        display: none;
      }

      .hero__grid {
        grid-template-columns: 1fr;
        gap: var(--s4);
        align-items: stretch;
        padding: clamp(20px, 5vw, 54px);
        border: 1px solid color-mix(in srgb, var(--line) 78%, transparent);
        border-radius: clamp(24px, 4vw, 42px);
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(223, 245, 240, 0.68));
        box-shadow: var(--shadow-2);
      }

      .hero__content {
        max-width: 46rem;
      }

      .hero h1 {
        max-width: 11ch;
        font-size: clamp(2.35rem, 12vw, 4.25rem);
        line-height: 1.02;
        letter-spacing: -0.065em;
      }

      .badge {
        border-radius: var(--r-pill);
        border-color: color-mix(in srgb, var(--accent) 22%, var(--line));
        background: color-mix(in srgb, var(--clinical-mint) 75%, var(--surface));
        color: var(--accent);
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .hero__role {
        font-weight: 750;
      }

      .hero__tagline {
        font-size: clamp(1rem, 1.4vw, 1.15rem);
      }

      .hero__proof {
        margin-top: var(--s3);
      }

      .hero__proof li,
      .skills-chip-list li,
      .chip-list li {
        border-color: color-mix(in srgb, var(--accent) 18%, var(--line));
        background: color-mix(in srgb, var(--surface) 78%, var(--clinical-mint));
        color: var(--text);
        font-weight: 650;
      }

      .hero__actions {
        margin-top: var(--s4);
      }

      .hero__actions .btn {
        flex: 1 1 100%;
      }

      .hero__media {
        display: grid;
        align-content: end;
        min-height: 360px;
        border: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
        border-radius: 28px;
        background: linear-gradient(180deg, rgba(255,255,255,0.78), rgba(223,245,240,0.58));
        overflow: hidden;
      }

      .hero__media img {
        width: min(78%, 360px);
        max-height: 420px;
        margin: 0 auto;
        object-fit: contain;
        object-position: center bottom;
        filter: drop-shadow(0 26px 48px rgba(8, 63, 74, 0.14));
      }

      .hero-meta {
        position: static;
        width: calc(100% - 24px);
        margin: 0 auto 12px;
        padding: var(--s2);
        border-radius: 18px;
      }

      .hero-meta li {
        align-items: start;
      }

      .hero-meta strong {
        max-width: 56%;
      }

      .hero-meta,
      .section-shell,
      .card,
      .text-card,
      .timeline__item,
      .contact-cta {
        border-color: color-mix(in srgb, var(--line) 82%, transparent);
        box-shadow: var(--shadow-1);
      }

      .section-shell__head {
        background: linear-gradient(180deg, var(--surface), var(--surface-alt));
      }

      .section-shell__icon {
        color: var(--accent);
        border-color: color-mix(in srgb, var(--accent) 22%, var(--line));
        background: color-mix(in srgb, var(--clinical-mint) 58%, var(--surface));
      }

      .timeline-list::before {
        background: color-mix(in srgb, var(--accent) 34%, var(--line));
      }

      .timeline-list__dot {
        background: var(--accent);
        box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 12%, transparent);
      }

      .credential-section__body,
      .credential-section__supporting {
        display: grid;
        gap: var(--s3);
      }

      .credential-section__lead {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--s2);
      }

      .credential-tile,
      .cert-grid__item {
        transition:
          transform var(--dur-1) ease,
          border-color var(--dur-1) ease,
          box-shadow var(--dur-1) ease;
      }

      .credential-tile {
        display: grid;
        align-content: start;
        gap: var(--s2);
        min-height: 100%;
        padding: var(--s3);
        border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--line));
        border-radius: var(--r-card);
        background: linear-gradient(180deg, color-mix(in srgb, var(--clinical-mint) 46%, var(--surface)), var(--surface));
        box-shadow: var(--shadow-1);
      }

      .credential-tile:hover,
      .cert-grid__item:hover,
      .card:hover,
      .text-card:hover {
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--accent) 28%, var(--line));
        box-shadow: var(--shadow-2);
      }

      .credential-tile__label {
        width: fit-content;
        margin: 0;
        padding: 5px 9px;
        border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--line));
        border-radius: var(--r-pill);
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 9%, var(--surface));
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .credential-tile p {
        margin-top: 0;
      }

      .credential-section .note,
      #evidence .note {
        display: inline-flex;
        width: fit-content;
        padding: 7px 10px;
        border: 1px solid var(--line);
        border-radius: var(--r-pill);
        background: var(--surface-alt);
        color: var(--text);
        font-weight: 650;
      }

      @media (min-width: 560px) {
        .hero__actions .btn {
          flex: 0 1 auto;
        }
      }

      @media (min-width: 900px) {
        .hero__grid {
          grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.68fr);
          gap: clamp(32px, 5vw, 72px);
          min-height: min(680px, calc(100vh - 110px));
        }

        .hero h1 {
          max-width: 12ch;
          font-size: clamp(3.2rem, 5.8vw, 4.8rem);
        }

        .hero__media {
          min-height: 520px;
        }

        .hero__media img {
          width: min(86%, 430px);
          max-height: 560px;
        }

        .hero-meta {
          width: min(330px, calc(100% - 32px));
          justify-self: end;
          margin-right: var(--s2);
          margin-bottom: var(--s2);
        }

        .credential-section__lead {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 760px) {
        .site-header__inner {
          min-height: 60px;
        }

        .brand__text small {
          display: none;
        }

        .hero {
          padding-top: var(--s3);
        }

        .hero__grid {
          padding: var(--s3);
        }

        .hero__media {
          min-height: 330px;
        }

        .hero__media img {
          width: min(78%, 310px);
          max-height: 360px;
        }

        .badge {
          font-size: 0.68rem;
          line-height: 1.2;
        }

        .hero h1 {
          max-width: 100%;
        }

        .hero-meta {
          width: calc(100% - 20px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header
      name={profile.name}
      showAwards={profile.awards.length > 0}
      mode={navigationMode}
    />
    <main id="main-content">
      <slot />
    </main>
    <Footer profile={profile} mode={navigationMode} />

    <script>
      import { initMotion } from '../lib/motion';

      initMotion();
    </script>
  </body>
</html>
