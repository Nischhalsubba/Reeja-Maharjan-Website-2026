---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../content/profile';

type Props = {
  title?: string;
  description?: string;
  image?: string;
};

const {
  title = `${profile.name} | ${profile.role}`,
  description = profile.hero.tagline,
  image = '/reeja-headshot.jpg'
} = Astro.props;
const isBlogPage = Astro.url.pathname.startsWith('/blog');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
const sameAs = [profile.contact.linkedin, profile.contact.instagram].filter(Boolean);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description,
  email: profile.contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.contact.location
  },
  knowsAbout: profile.keywords,
  sameAs
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={isBlogPage ? 'article' : 'profile'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Reeja Maharjan" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <meta name="robots" content="index, follow" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :where(a, button, input, textarea):focus-visible {
        outline: 3px solid color-mix(in srgb, var(--accent) 42%, transparent);
        outline-offset: 3px;
      }

      .credential-section__body,
      .credential-section__supporting {
        display: grid;
        gap: var(--s3);
      }

      .credential-section__lead {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--s2);
      }

      .credential-tile,
      .cert-grid__item {
        transition:
          transform var(--dur-1) ease,
          border-color var(--dur-1) ease,
          box-shadow var(--dur-1) ease;
      }

      .credential-tile {
        display: grid;
        align-content: start;
        gap: var(--s2);
        min-height: 100%;
        padding: var(--s3);
        border: 1px solid var(--line);
        border-radius: var(--r-card);
        background: linear-gradient(180deg, color-mix(in srgb, var(--surface-alt) 72%, var(--surface)), var(--surface));
        box-shadow: 0 18px 50px rgba(20, 28, 38, 0.08);
      }

      .credential-tile:hover,
      .cert-grid__item:hover {
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--accent) 28%, var(--line));
        box-shadow: 0 24px 70px rgba(20, 28, 38, 0.12);
      }

      .credential-tile__label {
        width: fit-content;
        margin: 0;
        padding: 5px 9px;
        border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--line));
        border-radius: 999px;
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 9%, var(--surface));
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .credential-tile p {
        margin-top: 0;
      }

      .credential-section__supporting h3 {
        font-size: var(--h3);
      }

      .credential-section .note,
      #evidence .note {
        display: inline-flex;
        width: fit-content;
        padding: 7px 10px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--surface-alt);
        color: var(--text);
        font-weight: 650;
      }

      @media (max-width: 980px) {
        .credential-section__lead {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 760px) {
        .hero h1 {
          max-width: 100%;
        }

        .hero-meta {
          position: static;
          width: 100%;
          margin-top: var(--s2);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header
      name={profile.name}
      showAwards={profile.awards.length > 0}
      mode={isBlogPage ? 'blog' : 'one-page'}
    />
    <main id="main-content">
      <slot />
    </main>
    <Footer profile={profile} mode={isBlogPage ? 'blog' : 'one-page'} />

    <script>
      import { initMotion } from '../lib/motion';

      initMotion();
    </script>
  </body>
</html>
