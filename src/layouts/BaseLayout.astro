---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/500.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/pages.css';
import '../styles/site-pages.css';
import '../styles/shell.css';
import '../styles/care-practice.css';
import '../styles/care-practice-audit.css';
import '../styles/field-journal-home.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../content/profile';
import { professionalFacts } from '../content/professional-facts';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
};

const {
  title = `${professionalFacts.name} | ${professionalFacts.primaryRole}`,
  description = profile.hero.tagline,
  image = '/og-default.svg',
  robots = 'index, follow, max-image-preview:large'
} = Astro.props;

const isBlogPage = Astro.url.pathname.startsWith('/blog');
const isOnePage = Astro.url.pathname === '/';
const isProfilePage = isOnePage || Astro.url.pathname === '/hire-reeja/' || Astro.url.pathname === '/contact/';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
const sameAs = [professionalFacts.linkedin, professionalFacts.instagram].filter(Boolean);
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const searchConsoleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const personSchema = {
  '@type': 'Person',
  '@id': 'https://reejamaharjan.com.np/#person',
  name: professionalFacts.name,
  url: 'https://reejamaharjan.com.np/',
  jobTitle: professionalFacts.primaryRole,
  description: profile.profileSummary,
  email: professionalFacts.professionalEmail,
  address: {
    '@type': 'PostalAddress',
    addressLocality: professionalFacts.locationLocality,
    addressRegion: professionalFacts.locationRegion,
    addressCountry: professionalFacts.countryCode
  },
  knowsAbout: profile.keywords,
  sameAs
};

const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://reejamaharjan.com.np/#website',
      url: 'https://reejamaharjan.com.np/',
      name: professionalFacts.name,
      description: profile.hero.tagline,
      inLanguage: 'en',
      publisher: { '@id': 'https://reejamaharjan.com.np/#person' }
    },
    personSchema,
    ...(isProfilePage
      ? [{
          '@type': 'ProfilePage',
          '@id': `${canonicalUrl}#profilepage`,
          url: canonicalUrl,
          name: title,
          description,
          dateModified: professionalFacts.lastVerified,
          mainEntity: { '@id': 'https://reejamaharjan.com.np/#person' },
          isPartOf: { '@id': 'https://reejamaharjan.com.np/#website' }
        }]
      : [])
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="design-system" content={isOnePage ? 'Reeja Field Journal' : 'Care Practice'} />
    <meta name="design-release" content={isOnePage ? 'field-journal-home-1.0.0' : 'care-practice-2.0.0'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {isOnePage && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {isOnePage && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />}
    {isOnePage && (
      <link
        href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Crimson+Pro:ital,wght@0,450;0,550;0,650;1,450;1,550&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    )}

    <meta property="og:type" content={isBlogPage ? 'article' : 'profile'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={`${title} social preview`} />
    <meta property="og:site_name" content={professionalFacts.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="robots" content={robots} />
    {searchConsoleVerification && <meta name="google-site-verification" content={searchConsoleVerification} />}

    <script type="application/ld+json" set:html={JSON.stringify(graphSchema)}></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId, { anonymize_ip: true });
      </script>
    )}
  </head>
  <body
    class:list={['care-ledger', 'care-practice', { 'field-journal': isOnePage }]}
    data-design-system={isOnePage ? 'reeja-field-journal' : 'care-practice'}
    data-design-version={isOnePage ? '1.0.0-home' : '2.0.0'}
  >
    <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header name={professionalFacts.name} />
    <main id="main-content"><slot /></main>
    <Footer profile={profile} />

    <script>
      import { initMotion } from '../lib/motion';
      import { initMobileNavA11y } from '../lib/mobileNavA11y';
      import { initPortfolioMotion } from '../lib/portfolioMotion';
      import { initFieldJournalMotion } from '../lib/fieldJournalMotion';

      initMotion();
      initMobileNavA11y();
      if (document.body.classList.contains('field-journal')) initFieldJournalMotion();
      else initPortfolioMotion();

      document.querySelectorAll<HTMLElement>('[data-track]').forEach((element) => {
        element.addEventListener('click', () => {
          const eventName = element.dataset.track ?? 'site_action';
          const gtag = (window as typeof window & { gtag?: (...args: unknown[]) => void }).gtag;
          gtag?.('event', eventName, { page_path: window.location.pathname });
        });
      });
    </script>
  </body>
</html>
