---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../content/profile';

type Props = {
  title?: string;
  description?: string;
  image?: string;
};

const {
  title = `${profile.name} | ${profile.role}`,
  description = profile.hero.tagline,
  image = '/reeja-headshot.jpg',
} = Astro.props;
const isBlogPage = Astro.url.pathname.startsWith('/blog');
const isOnePage = Astro.url.pathname === '/';
const navigationMode = isOnePage ? 'one-page' : 'blog';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
const sameAs = [profile.contact.linkedin, profile.contact.instagram].filter(Boolean);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description,
  email: profile.contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.contact.location,
  },
  knowsAbout: profile.keywords,
  sameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={isBlogPage ? 'article' : 'profile'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Reeja Maharjan" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <meta name="robots" content="index, follow" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=Source+Serif+4:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --shadow-1: none;
        --shadow-2: none;
        --shadow-3: none;
        --clinical-paper: #f7fcfb;
        --clinical-panel: #eef7f5;
        --clinical-panel-2: #e4f1ee;
        --clinical-ink: #13313f;
        --clinical-border: #d6e6e2;
        --clinical-border-strong: #b6d2cb;
      }

      body {
        background: var(--clinical-paper);
        position: relative;
      }

      body::before,
      body::after {
        content: '';
        position: fixed;
        inset: auto;
        pointer-events: none;
        z-index: -1;
        border-radius: 999px;
        filter: blur(18px);
        opacity: 0.7;
      }

      body::before {
        top: -120px;
        left: -60px;
        width: 360px;
        height: 360px;
        background: radial-gradient(
          circle,
          color-mix(in srgb, var(--accent) 15%, white) 0%,
          transparent 72%
        );
      }

      body::after {
        right: -90px;
        top: 18vh;
        width: 300px;
        height: 300px;
        background: radial-gradient(
          circle,
          color-mix(in srgb, var(--clinical-blue) 16%, white) 0%,
          transparent 74%
        );
      }

      :where(a, button, input, textarea):focus-visible {
        outline: 3px solid color-mix(in srgb, var(--accent) 42%, transparent);
        outline-offset: 3px;
        box-shadow: none;
      }

      .container {
        width: min(100% - clamp(40px, 7vw, 112px), 1180px);
      }

      .site-header {
        background: color-mix(in srgb, var(--surface) 96%, transparent);
        border-bottom: 1px solid var(--clinical-border);
        box-shadow: none;
        backdrop-filter: blur(12px);
      }

      .site-header__inner {
        min-height: 64px;
      }

      .brand__mark,
      .desktop-nav a:last-child,
      .btn--primary {
        background: var(--accent);
        color: var(--accent-text);
      }

      .brand__text small,
      .section-intro__eyebrow,
      .text-link,
      .hero__role {
        color: var(--accent);
      }

      .desktop-nav a,
      .mobile-nav__panel a {
        color: var(--muted);
        font-weight: 650;
      }

      .desktop-nav a:hover,
      .desktop-nav a:focus-visible,
      .mobile-nav__panel a:hover,
      .mobile-nav__panel a:focus-visible {
        color: var(--text);
        background: var(--surface-alt);
      }

      .desktop-nav a:last-child,
      .btn,
      .btn:hover,
      .card[data-card-link]:focus-visible {
        box-shadow: none;
      }

      .btn {
        min-height: 48px;
        border-radius: var(--r-pill);
        transition:
          background-color var(--dur-1) ease,
          border-color var(--dur-1) ease,
          color var(--dur-1) ease;
      }

      .btn:hover {
        transform: none;
      }

      .btn--primary:hover,
      .desktop-nav a:last-child:hover,
      .desktop-nav a:last-child:focus-visible {
        background: var(--accent-hover);
      }

      .btn--secondary {
        background: var(--surface);
        border-color: var(--clinical-border-strong);
      }

      .section {
        padding-block: clamp(72px, 10vw, 136px);
        scroll-margin-top: 96px;
      }

      .section-stack,
      .section-shell__body,
      .credential-section__body,
      .credential-section__supporting {
        display: grid;
        gap: clamp(32px, 5vw, 56px);
      }

      .section-shell,
      .card,
      .text-card,
      .timeline__item,
      .timeline-list__content,
      .cert-grid__item,
      .credential-tile,
      .contact-cta {
        border: 1px solid var(--clinical-border);
        border-radius: 24px;
        background: var(--surface);
        box-shadow: none;
      }

      .section-shell {
        overflow: hidden;
      }

      .section-shell__head,
      .section-shell__body {
        padding: clamp(36px, 5vw, 64px);
      }

      .section-shell__head {
        background: var(--surface);
        border-bottom: 1px solid var(--clinical-border);
      }

      .section-shell__body {
        background: var(--clinical-paper);
      }

      .section-shell__icon {
        color: var(--accent);
        border-color: color-mix(in srgb, var(--accent) 20%, var(--line));
        background: var(--clinical-panel);
      }

      .section-intro h1,
      .section-intro h2,
      .section-intro h3,
      .hero h1,
      .hero__signal-title,
      .card h3,
      .card h4,
      .cert-grid__item h4,
      .credential-tile h3 {
        color: var(--clinical-ink);
        line-height: 1.18;
      }

      .section-intro p:not(.section-intro__eyebrow),
      .card p,
      .text-card p,
      .cert-grid__item p,
      .credential-tile p {
        line-height: 1.72;
      }

      .section-intro__eyebrow {
        width: fit-content;
        padding: 5px 10px;
        border-radius: var(--r-pill);
        background: var(--clinical-panel);
        border: 1px solid color-mix(in srgb, var(--accent) 14%, var(--line));
      }

      .hero {
        padding-block: clamp(48px, 9vw, 112px);
        overflow: visible;
      }

      .hero::before {
        display: none;
      }

      .hero__grid {
        position: relative;
        grid-template-columns: 1fr;
        gap: clamp(36px, 6vw, 72px);
        align-items: stretch;
        padding: clamp(32px, 6vw, 72px);
        border: 1px solid var(--clinical-border);
        border-radius: clamp(24px, 4vw, 36px);
        background:
          radial-gradient(
            circle at top left,
            color-mix(in srgb, var(--clinical-mint) 75%, white) 0%,
            transparent 38%
          ),
          linear-gradient(
            140deg,
            rgba(255, 255, 255, 0.96) 0%,
            rgba(238, 247, 245, 0.96) 58%,
            rgba(227, 241, 237, 0.98) 100%
          );
        box-shadow: none;
        overflow: hidden;
      }

      .hero__grid::before,
      .hero__grid::after {
        content: '';
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
      }

      .hero__grid::before {
        width: 320px;
        height: 320px;
        top: -140px;
        right: -80px;
        background: radial-gradient(
          circle,
          color-mix(in srgb, var(--clinical-blue) 16%, white) 0%,
          transparent 72%
        );
      }

      .hero__grid::after {
        width: 260px;
        height: 260px;
        bottom: -120px;
        left: 36%;
        background: radial-gradient(
          circle,
          color-mix(in srgb, var(--accent) 12%, white) 0%,
          transparent 72%
        );
      }

      .hero__content {
        max-width: 48rem;
        position: relative;
        z-index: 1;
        display: grid;
        align-content: start;
      }

      .hero h1 {
        max-width: 12ch;
        font-size: clamp(2.15rem, 11vw, 4rem);
        line-height: 1.04;
        letter-spacing: -0.058em;
        margin-top: 10px;
      }

      .badge {
        border-radius: var(--r-pill);
        border-color: color-mix(in srgb, var(--accent) 20%, var(--line));
        background: var(--surface);
        color: var(--accent);
        font-weight: 800;
        letter-spacing: 0.075em;
      }

      .hero__caption {
        margin-top: var(--s2);
        color: var(--clinical-blue);
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-size: 0.76rem;
      }

      .hero__role {
        font-weight: 750;
        margin-top: var(--s3);
      }

      .hero__tagline {
        font-size: clamp(1rem, 1.3vw, 1.16rem);
        max-width: 60ch;
        line-height: 1.75;
        margin-top: var(--s2);
      }

      .hero__proof {
        margin-top: var(--s4);
        gap: var(--s2);
      }

      .hero__proof li,
      .skills-chip-list li,
      .chip-list li {
        border: 1px solid color-mix(in srgb, var(--accent) 16%, var(--line));
        background: var(--surface);
        color: var(--text);
        font-weight: 650;
        line-height: 1.25;
      }

      .hero__actions {
        margin-top: var(--s5);
      }

      .hero__actions .btn {
        flex: 1 1 100%;
      }

      .hero__media {
        position: relative;
        z-index: 1;
      }

      .hero__media-stage {
        position: relative;
        min-height: 540px;
        border: 1px solid var(--clinical-border);
        border-radius: 30px;
        padding: clamp(20px, 3vw, 30px);
        background: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.94) 0%,
          rgba(234, 245, 242, 0.98) 100%
        );
        overflow: hidden;
      }

      .hero__art-frame {
        position: absolute;
        inset: 28px 24px auto;
        border-radius: 26px;
        border: 1px solid color-mix(in srgb, var(--clinical-blue) 14%, white);
        background: linear-gradient(
          180deg,
          rgba(243, 250, 248, 0.98) 0%,
          rgba(228, 241, 237, 0.98) 100%
        );
        overflow: hidden;
      }

      .hero__art {
        width: 100%;
        height: 240px;
        object-fit: cover;
        object-position: center;
        mix-blend-mode: multiply;
      }

      .hero__portrait-frame {
        position: absolute;
        right: clamp(22px, 3vw, 30px);
        bottom: clamp(22px, 3vw, 30px);
        width: min(48%, 280px);
        border-radius: 26px;
        background: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.78) 0%,
          rgba(221, 239, 235, 0.9) 100%
        );
        border: 1px solid color-mix(in srgb, var(--accent) 22%, white);
        padding: 16px 12px 0;
      }

      .hero__portrait {
        width: 100%;
        max-height: 360px;
        object-fit: contain;
        object-position: center bottom;
      }

      .hero__signal-card {
        position: absolute;
        left: clamp(22px, 3vw, 30px);
        bottom: clamp(118px, 17vw, 154px);
        width: min(62%, 300px);
        padding: 18px 18px 20px;
        border-radius: 22px;
        border: 1px solid color-mix(in srgb, var(--accent) 16%, white);
        background: color-mix(in srgb, var(--surface) 88%, transparent);
        backdrop-filter: blur(8px);
      }

      .hero__signal-label {
        color: var(--clinical-blue);
        font-size: 0.74rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
      }

      .hero__signal-title {
        margin-top: 10px;
        font-size: clamp(1.15rem, 2vw, 1.5rem);
        line-height: 1.2;
      }

      .hero__signal-text {
        margin-top: 10px;
        color: var(--muted);
        line-height: 1.62;
      }

      .hero-meta {
        position: absolute;
        left: clamp(22px, 3vw, 30px);
        right: clamp(22px, 3vw, 30px);
        bottom: clamp(22px, 3vw, 30px);
        width: auto;
        margin: 0;
        padding: 18px;
        border: 1px solid var(--clinical-border);
        border-radius: 22px;
        background: color-mix(in srgb, var(--surface) 90%, transparent);
        backdrop-filter: blur(8px);
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 18px;
      }

      .hero-meta li {
        display: grid;
        gap: 4px;
      }

      .hero-meta span {
        color: var(--muted);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .hero-meta strong {
        max-width: none;
        line-height: 1.45;
        font-size: 0.96rem;
      }

      .profile-spotlight {
        display: grid;
        gap: clamp(24px, 4vw, 32px);
      }

      .profile-spotlight__summary {
        padding: clamp(30px, 4vw, 44px);
        background: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.96) 0%,
          rgba(241, 250, 248, 0.96) 100%
        );
      }

      .profile-spotlight__panel {
        padding: clamp(28px, 4vw, 36px);
        background: linear-gradient(
          180deg,
          var(--clinical-panel) 0%,
          rgba(255, 255, 255, 0.96) 100%
        );
      }

      .profile-spotlight__panel h3 {
        margin-bottom: 8px;
      }

      .role-fit-grid {
        display: grid;
        gap: clamp(20px, 3vw, 28px);
      }

      .role-fit-card {
        padding: clamp(24px, 3vw, 34px);
        background: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.98) 0%,
          rgba(238, 247, 245, 0.94) 100%
        );
      }

      .role-fit-card__eyebrow {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        min-height: 30px;
        padding: 0 12px;
        border-radius: 999px;
        background: var(--clinical-panel);
        border: 1px solid color-mix(in srgb, var(--accent) 16%, white);
        color: var(--clinical-blue);
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 700;
      }

      .skills-groups-grid {
        display: grid;
        gap: clamp(20px, 3vw, 28px);
      }

      .skills-group {
        padding: clamp(24px, 3vw, 30px);
        border: 1px solid var(--clinical-border);
        border-radius: 22px;
        background: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.98) 0%,
          rgba(241, 250, 248, 0.95) 100%
        );
      }

      .skills-group h3 {
        margin-bottom: 14px;
      }

      .contact-cta {
        position: relative;
        overflow: hidden;
      }

      .contact-cta::before {
        content: '';
        position: absolute;
        inset: auto -48px -80px auto;
        width: 220px;
        height: 220px;
        border-radius: 999px;
        background: radial-gradient(
          circle,
          color-mix(in srgb, var(--accent) 12%, white) 0%,
          transparent 72%
        );
        pointer-events: none;
      }

      .card,
      .text-card,
      .cert-grid__item,
      .credential-tile {
        display: grid;
        align-content: start;
        gap: var(--s3);
        min-width: 0;
        padding: clamp(28px, 4vw, 44px);
      }

      .card > *,
      .text-card > *,
      .cert-grid__item > *,
      .credential-tile > * {
        margin-top: 0;
        min-width: 0;
      }

      .card-grid,
      .cert-grid,
      .credential-section__lead {
        display: grid;
        gap: clamp(28px, 4vw, 48px);
      }

      .card-grid--2,
      .card-grid--3,
      .cert-grid,
      .credential-section__lead {
        grid-template-columns: 1fr;
      }

      .cert-grid__meta {
        color: var(--muted);
        font-size: var(--small-size);
        line-height: 1.7;
      }

      .timeline-list::before {
        background: color-mix(in srgb, var(--accent) 30%, var(--line));
      }

      .timeline-list__dot {
        background: var(--accent);
        border: 4px solid var(--clinical-panel);
        box-shadow: none;
      }

      .timeline-list__date {
        background: var(--surface);
        border-color: var(--clinical-border);
      }

      .timeline-list__content {
        padding-block: var(--s4);
      }

      .check-list li::before,
      .skills-chip-list li::before {
        color: var(--accent);
      }

      .check-list,
      .skills-chip-list {
        display: grid;
        gap: var(--s2);
      }

      .credential-tile {
        border-color: color-mix(in srgb, var(--accent) 16%, var(--line));
        background: var(--clinical-panel);
      }

      .credential-tile,
      .cert-grid__item,
      .card,
      .text-card {
        transition:
          background-color var(--dur-1) ease,
          border-color var(--dur-1) ease;
      }

      .credential-tile:hover,
      .cert-grid__item:hover,
      .card:hover,
      .text-card:hover {
        transform: none;
        border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
        box-shadow: none;
      }

      .credential-tile__label,
      .credential-section .note,
      #evidence .note {
        display: inline-flex;
        width: fit-content;
        max-width: 100%;
        border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--line));
        border-radius: var(--r-pill);
        background: var(--surface);
        color: var(--accent);
        font-weight: 700;
        line-height: 1.35;
        white-space: normal;
      }

      .credential-tile__label {
        margin: 0;
        padding: 6px 11px;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .credential-section .note,
      #evidence .note {
        padding: 9px 13px;
        color: var(--text);
        margin-top: auto;
      }

      .credential-section__supporting .section-intro {
        display: grid;
        gap: var(--s3);
      }

      .contact-cta {
        padding: clamp(36px, 5vw, 64px);
        background: var(--clinical-panel);
      }

      .contact-form input,
      .contact-form textarea {
        border-color: var(--clinical-border);
      }

      .contact-form input:focus-visible,
      .contact-form textarea:focus-visible {
        border-color: var(--accent);
      }

      .site-footer {
        background: var(--surface);
        border-top-color: var(--clinical-border);
      }

      @media (min-width: 560px) {
        .hero__actions .btn {
          flex: 0 1 auto;
        }
      }

      @media (min-width: 760px) {
        .profile-spotlight,
        .card-grid--2,
        .cert-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .role-fit-grid,
        .skills-groups-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .card-grid--3 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (min-width: 1020px) {
        .hero__grid {
          grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.64fr);
          gap: clamp(48px, 6vw, 88px);
        }

        .hero h1 {
          max-width: 12ch;
          font-size: clamp(3rem, 5.4vw, 4.45rem);
        }

        .hero__media {
          min-height: 520px;
        }

        .hero__media-stage {
          min-height: 620px;
        }

        .hero__art {
          height: 290px;
        }

        .hero__portrait-frame {
          width: min(46%, 308px);
        }

        .hero-meta {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .credential-section__lead,
        .card-grid--3,
        .role-fit-grid,
        .skills-groups-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 760px) {
        .container {
          width: min(100% - 32px, 1180px);
        }

        .site-header__inner {
          min-height: 60px;
        }

        .brand__text small {
          display: none;
        }

        .section {
          padding-block: 64px;
        }

        .section-stack,
        .section-shell__body,
        .credential-section__body,
        .credential-section__supporting {
          gap: var(--s4);
        }

        .section-shell__head,
        .section-shell__body {
          padding: var(--s4);
        }

        .card,
        .text-card,
        .cert-grid__item,
        .credential-tile,
        .contact-cta {
          padding: var(--s4);
        }

        .hero {
          padding-top: var(--s4);
        }

        .hero__grid {
          padding: var(--s4);
          gap: var(--s5);
        }

        .hero__media-stage {
          min-height: 560px;
        }

        .hero__art-frame {
          inset: 20px 20px auto;
        }

        .hero__art {
          height: 210px;
        }

        .hero__portrait-frame {
          width: min(52%, 250px);
          right: 18px;
          bottom: 18px;
        }

        .hero__signal-card {
          left: 18px;
          width: min(66%, 250px);
          bottom: 146px;
        }

        .badge {
          font-size: 0.68rem;
          line-height: 1.2;
        }

        .hero h1 {
          max-width: 100%;
        }

        .hero-meta {
          left: 18px;
          right: 18px;
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header name={profile.name} showAwards={profile.awards.length > 0} mode={navigationMode} />
    <main id="main-content">
      <slot />
    </main>
    <Footer profile={profile} mode={navigationMode} />

    <script>
      import { initMotion } from '../lib/motion';

      initMotion();
    </script>
  </body>
</html>
