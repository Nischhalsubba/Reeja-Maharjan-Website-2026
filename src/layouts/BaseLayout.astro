---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../content/profile';

type Props = {
  title?: string;
  description?: string;
  image?: string;
};

const {
  title = `${profile.name} | ${profile.role}`,
  description = profile.hero.tagline,
  image = '/reeja-headshot.jpg'
} = Astro.props;
const isBlogPage = Astro.url.pathname.startsWith('/blog');
const isOnePage = Astro.url.pathname === '/';
const navigationMode = isOnePage ? 'one-page' : 'blog';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
const sameAs = [profile.contact.linkedin, profile.contact.instagram].filter(Boolean);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description,
  email: profile.contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.contact.location
  },
  knowsAbout: profile.keywords,
  sameAs
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={isBlogPage ? 'article' : 'profile'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Reeja Maharjan" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <meta name="robots" content="index, follow" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :where(a, button, input, textarea):focus-visible {
        outline: 3px solid color-mix(in srgb, var(--accent) 42%, transparent);
        outline-offset: 3px;
      }

      body {
        background: linear-gradient(180deg, #f7fffd 0%, var(--bg) 44%, #f8fbff 100%);
      }

      .site-header {
        background: color-mix(in srgb, var(--surface) 82%, transparent);
        border-bottom-color: color-mix(in srgb, var(--line) 72%, transparent);
        box-shadow: 0 8px 30px rgba(8, 63, 74, 0.05);
      }

      .brand__mark {
        background: linear-gradient(135deg, var(--accent), var(--clinical-blue));
        color: var(--accent-text);
      }

      .brand__text small {
        color: var(--accent);
        font-weight: 700;
      }

      .desktop-nav a:last-child,
      .btn--primary {
        background: linear-gradient(135deg, var(--accent), var(--clinical-blue));
        color: var(--accent-text);
        box-shadow: 0 14px 34px rgba(8, 118, 111, 0.18);
      }

      .btn--secondary {
        background: var(--surface);
        border-color: var(--line-strong);
      }

      .hero {
        position: relative;
        overflow: hidden;
      }

      .hero::before {
        content: '';
        position: absolute;
        inset: 24px var(--gutter) auto var(--gutter);
        height: min(68vh, 720px);
        border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
        border-radius: 40px;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.86), rgba(223, 245, 240, 0.58));
        box-shadow: var(--shadow-2);
        z-index: -1;
      }

      .badge {
        border-radius: var(--r-pill);
        border-color: color-mix(in srgb, var(--accent) 22%, var(--line));
        background: color-mix(in srgb, var(--clinical-mint) 75%, var(--surface));
        color: var(--accent);
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .hero__role {
        color: var(--accent);
        font-weight: 750;
      }

      .hero__tagline {
        font-size: clamp(1rem, 1.3vw, 1.15rem);
      }

      .hero__proof li,
      .skills-chip-list li,
      .chip-list li {
        border-color: color-mix(in srgb, var(--accent) 18%, var(--line));
        background: color-mix(in srgb, var(--surface) 78%, var(--clinical-mint));
        color: var(--text);
        font-weight: 650;
      }

      .hero__media {
        border-radius: 36px;
        background: linear-gradient(180deg, rgba(255,255,255,0.72), rgba(223,245,240,0.5));
      }

      .hero__media img {
        filter: drop-shadow(0 26px 48px rgba(8, 63, 74, 0.14));
      }

      .hero-meta,
      .section-shell,
      .card,
      .text-card,
      .timeline__item,
      .contact-cta {
        border-color: color-mix(in srgb, var(--line) 82%, transparent);
        box-shadow: var(--shadow-1);
      }

      .section-shell__head {
        background: linear-gradient(180deg, var(--surface), var(--surface-alt));
      }

      .section-shell__icon {
        color: var(--accent);
        border-color: color-mix(in srgb, var(--accent) 22%, var(--line));
        background: color-mix(in srgb, var(--clinical-mint) 58%, var(--surface));
      }

      .section-intro__eyebrow,
      .text-link {
        color: var(--accent);
      }

      .timeline-list::before {
        background: color-mix(in srgb, var(--accent) 34%, var(--line));
      }

      .timeline-list__dot {
        background: var(--accent);
        box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 12%, transparent);
      }

      .credential-section__body,
      .credential-section__supporting {
        display: grid;
        gap: var(--s3);
      }

      .credential-section__lead {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--s2);
      }

      .credential-tile,
      .cert-grid__item {
        transition:
          transform var(--dur-1) ease,
          border-color var(--dur-1) ease,
          box-shadow var(--dur-1) ease;
      }

      .credential-tile {
        display: grid;
        align-content: start;
        gap: var(--s2);
        min-height: 100%;
        padding: var(--s3);
        border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--line));
        border-radius: var(--r-card);
        background: linear-gradient(180deg, color-mix(in srgb, var(--clinical-mint) 46%, var(--surface)), var(--surface));
        box-shadow: var(--shadow-1);
      }

      .credential-tile:hover,
      .cert-grid__item:hover,
      .card:hover,
      .text-card:hover {
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--accent) 28%, var(--line));
        box-shadow: var(--shadow-2);
      }

      .credential-tile__label {
        width: fit-content;
        margin: 0;
        padding: 5px 9px;
        border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--line));
        border-radius: var(--r-pill);
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 9%, var(--surface));
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .credential-tile p {
        margin-top: 0;
      }

      .credential-section__supporting h3 {
        font-size: var(--h3);
      }

      .credential-section .note,
      #evidence .note {
        display: inline-flex;
        width: fit-content;
        padding: 7px 10px;
        border: 1px solid var(--line);
        border-radius: var(--r-pill);
        background: var(--surface-alt);
        color: var(--text);
        font-weight: 650;
      }

      @media (max-width: 980px) {
        .credential-section__lead {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 760px) {
        .hero::before {
          inset: 8px 10px auto 10px;
          height: 84%;
          border-radius: 28px;
        }

        .hero h1 {
          max-width: 100%;
        }

        .hero-meta {
          position: static;
          width: 100%;
          margin-top: var(--s2);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header
      name={profile.name}
      showAwards={profile.awards.length > 0}
      mode={navigationMode}
    />
    <main id="main-content">
      <slot />
    </main>
    <Footer profile={profile} mode={navigationMode} />

    <script>
      import { initMotion } from '../lib/motion';

      initMotion();
    </script>
  </body>
</html>
