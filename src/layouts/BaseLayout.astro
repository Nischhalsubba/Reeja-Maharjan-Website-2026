---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../content/profile';

type Props = {
  title?: string;
  description?: string;
  image?: string;
};

const {
  title = `${profile.name} | ${profile.role}`,
  description = profile.hero.tagline,
  image = '/reeja-headshot.jpg'
} = Astro.props;
const isBlogPage = Astro.url.pathname.startsWith('/blog');
const isOnePage = Astro.url.pathname === '/';
const navigationMode = isOnePage ? 'one-page' : 'blog';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
const sameAs = [profile.contact.linkedin, profile.contact.instagram].filter(Boolean);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description,
  email: profile.contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.contact.location
  },
  knowsAbout: profile.keywords,
  sameAs
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={isBlogPage ? 'article' : 'profile'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Reeja Maharjan" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <meta name="robots" content="index, follow" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --shadow-1: none;
        --shadow-2: none;
        --shadow-3: none;
        --clinical-paper: #fbfefd;
        --clinical-panel: #f1faf8;
        --clinical-panel-2: #eaf7f4;
        --clinical-ink: #102a35;
        --clinical-border: #d7e9e6;
        --clinical-border-strong: #b9d8d3;
      }

      body {
        background: var(--clinical-paper);
      }

      :where(a, button, input, textarea):focus-visible {
        outline: 3px solid color-mix(in srgb, var(--accent) 42%, transparent);
        outline-offset: 3px;
        box-shadow: none;
      }

      .container {
        width: min(100% - clamp(32px, 6vw, 80px), 1120px);
      }

      .site-header {
        background: color-mix(in srgb, var(--surface) 96%, transparent);
        border-bottom: 1px solid var(--clinical-border);
        box-shadow: none;
        backdrop-filter: blur(12px);
      }

      .site-header__inner {
        min-height: 64px;
      }

      .brand__mark,
      .desktop-nav a:last-child,
      .btn--primary {
        background: var(--accent);
        color: var(--accent-text);
      }

      .brand__text small,
      .section-intro__eyebrow,
      .text-link,
      .hero__role {
        color: var(--accent);
      }

      .desktop-nav a,
      .mobile-nav__panel a {
        color: var(--muted);
        font-weight: 650;
      }

      .desktop-nav a:hover,
      .desktop-nav a:focus-visible,
      .mobile-nav__panel a:hover,
      .mobile-nav__panel a:focus-visible {
        color: var(--text);
        background: var(--surface-alt);
      }

      .desktop-nav a:last-child,
      .btn,
      .btn:hover,
      .card[data-card-link]:focus-visible {
        box-shadow: none;
      }

      .btn {
        min-height: 46px;
        border-radius: var(--r-pill);
        transition: background-color var(--dur-1) ease, border-color var(--dur-1) ease, color var(--dur-1) ease;
      }

      .btn:hover {
        transform: none;
      }

      .btn--primary:hover,
      .desktop-nav a:last-child:hover,
      .desktop-nav a:last-child:focus-visible {
        background: var(--accent-hover);
      }

      .btn--secondary {
        background: var(--surface);
        border-color: var(--clinical-border-strong);
      }

      .section {
        padding-block: clamp(48px, 8vw, 96px);
        scroll-margin-top: 88px;
      }

      .section-stack,
      .section-shell__body,
      .credential-section__body,
      .credential-section__supporting {
        display: grid;
        gap: clamp(20px, 3vw, 32px);
      }

      .section-shell,
      .card,
      .text-card,
      .timeline__item,
      .timeline-list__content,
      .cert-grid__item,
      .credential-tile,
      .contact-cta {
        border: 1px solid var(--clinical-border);
        border-radius: 22px;
        background: var(--surface);
        box-shadow: none;
      }

      .section-shell {
        overflow: hidden;
      }

      .section-shell__head,
      .section-shell__body {
        padding: clamp(24px, 4vw, 40px);
      }

      .section-shell__head {
        background: var(--surface);
        border-bottom: 1px solid var(--clinical-border);
      }

      .section-shell__body {
        background: var(--clinical-paper);
      }

      .section-shell__icon {
        color: var(--accent);
        border-color: color-mix(in srgb, var(--accent) 20%, var(--line));
        background: var(--clinical-panel);
      }

      .section-intro h1,
      .section-intro h2,
      .section-intro h3,
      .hero h1,
      .card h3,
      .card h4,
      .cert-grid__item h4,
      .credential-tile h3 {
        color: var(--clinical-ink);
        line-height: 1.18;
      }

      .section-intro__eyebrow {
        width: fit-content;
        padding: 4px 9px;
        border-radius: var(--r-pill);
        background: var(--clinical-panel);
        border: 1px solid color-mix(in srgb, var(--accent) 14%, var(--line));
      }

      .hero {
        padding-block: clamp(24px, 7vw, 76px);
        overflow: visible;
      }

      .hero::before {
        display: none;
      }

      .hero__grid {
        grid-template-columns: 1fr;
        gap: clamp(24px, 5vw, 48px);
        align-items: stretch;
        padding: clamp(20px, 5vw, 48px);
        border: 1px solid var(--clinical-border);
        border-radius: clamp(20px, 4vw, 32px);
        background: linear-gradient(180deg, var(--surface) 0%, var(--clinical-panel) 100%);
        box-shadow: none;
      }

      .hero__content {
        max-width: 46rem;
      }

      .hero h1 {
        max-width: 12ch;
        font-size: clamp(2.15rem, 11vw, 4rem);
        line-height: 1.04;
        letter-spacing: -0.058em;
      }

      .badge {
        border-radius: var(--r-pill);
        border-color: color-mix(in srgb, var(--accent) 20%, var(--line));
        background: var(--surface);
        color: var(--accent);
        font-weight: 800;
        letter-spacing: 0.075em;
      }

      .hero__role {
        font-weight: 750;
      }

      .hero__tagline {
        font-size: clamp(0.98rem, 1.25vw, 1.1rem);
        max-width: 58ch;
      }

      .hero__proof {
        margin-top: var(--s3);
      }

      .hero__proof li,
      .skills-chip-list li,
      .chip-list li {
        border: 1px solid color-mix(in srgb, var(--accent) 16%, var(--line));
        background: var(--surface);
        color: var(--text);
        font-weight: 650;
        line-height: 1.25;
      }

      .hero__actions {
        margin-top: var(--s4);
      }

      .hero__actions .btn {
        flex: 1 1 100%;
      }

      .hero__media {
        display: grid;
        align-content: end;
        min-height: 320px;
        border: 1px solid var(--clinical-border);
        border-radius: 24px;
        background: var(--surface);
        overflow: hidden;
        box-shadow: none;
      }

      .hero__media img {
        width: min(74%, 320px);
        max-height: 360px;
        margin: 0 auto;
        object-fit: contain;
        object-position: center bottom;
        filter: none;
      }

      .hero-meta {
        position: static;
        width: calc(100% - 24px);
        margin: 0 auto 12px;
        padding: var(--s2);
        border: 1px solid var(--clinical-border);
        border-radius: 16px;
        background: var(--clinical-panel);
        box-shadow: none;
      }

      .hero-meta li {
        align-items: start;
      }

      .hero-meta strong {
        max-width: 56%;
      }

      .card,
      .text-card,
      .cert-grid__item,
      .credential-tile {
        display: grid;
        align-content: start;
        gap: var(--s2);
        min-width: 0;
        padding: clamp(20px, 3vw, 28px);
      }

      .card > *,
      .text-card > *,
      .cert-grid__item > *,
      .credential-tile > * {
        margin-top: 0;
        min-width: 0;
      }

      .card-grid,
      .cert-grid,
      .credential-section__lead {
        display: grid;
        gap: clamp(18px, 3vw, 28px);
      }

      .card-grid--2,
      .card-grid--3,
      .cert-grid,
      .credential-section__lead {
        grid-template-columns: 1fr;
      }

      .cert-grid__meta {
        color: var(--muted);
        font-size: var(--small-size);
        line-height: 1.55;
      }

      .timeline-list::before {
        background: color-mix(in srgb, var(--accent) 30%, var(--line));
      }

      .timeline-list__dot {
        background: var(--accent);
        border: 4px solid var(--clinical-panel);
        box-shadow: none;
      }

      .timeline-list__date {
        background: var(--surface);
        border-color: var(--clinical-border);
      }

      .timeline-list__content {
        padding-block: var(--s3);
      }

      .check-list li::before,
      .skills-chip-list li::before {
        color: var(--accent);
      }

      .credential-tile {
        border-color: color-mix(in srgb, var(--accent) 16%, var(--line));
        background: var(--clinical-panel);
      }

      .credential-tile,
      .cert-grid__item,
      .card,
      .text-card {
        transition: background-color var(--dur-1) ease, border-color var(--dur-1) ease;
      }

      .credential-tile:hover,
      .cert-grid__item:hover,
      .card:hover,
      .text-card:hover {
        transform: none;
        border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
        box-shadow: none;
      }

      .credential-tile__label,
      .credential-section .note,
      #evidence .note {
        display: inline-flex;
        width: fit-content;
        max-width: 100%;
        border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--line));
        border-radius: var(--r-pill);
        background: var(--surface);
        color: var(--accent);
        font-weight: 700;
        line-height: 1.25;
        white-space: normal;
      }

      .credential-tile__label {
        margin: 0;
        padding: 5px 9px;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .credential-section .note,
      #evidence .note {
        padding: 8px 11px;
        color: var(--text);
      }

      .credential-section__supporting .section-intro {
        display: grid;
        gap: var(--s2);
      }

      .contact-cta {
        padding: clamp(24px, 4vw, 40px);
        background: var(--clinical-panel);
      }

      .contact-form input,
      .contact-form textarea {
        border-color: var(--clinical-border);
      }

      .contact-form input:focus-visible,
      .contact-form textarea:focus-visible {
        border-color: var(--accent);
      }

      .site-footer {
        background: var(--surface);
        border-top-color: var(--clinical-border);
      }

      @media (min-width: 560px) {
        .hero__actions .btn {
          flex: 0 1 auto;
        }
      }

      @media (min-width: 760px) {
        .card-grid--2,
        .cert-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .card-grid--3 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (min-width: 980px) {
        .hero__grid {
          grid-template-columns: minmax(0, 0.95fr) minmax(300px, 0.64fr);
          gap: clamp(32px, 5vw, 64px);
        }

        .hero h1 {
          max-width: 12ch;
          font-size: clamp(3rem, 5.4vw, 4.45rem);
        }

        .hero__media {
          min-height: 480px;
        }

        .hero__media img {
          width: min(82%, 390px);
          max-height: 500px;
        }

        .hero-meta {
          width: min(320px, calc(100% - 32px));
          justify-self: end;
          margin-right: var(--s2);
          margin-bottom: var(--s2);
        }

        .credential-section__lead,
        .card-grid--3 {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 760px) {
        .container {
          width: min(100% - 28px, 1120px);
        }

        .site-header__inner {
          min-height: 60px;
        }

        .brand__text small {
          display: none;
        }

        .section {
          padding-block: 44px;
        }

        .section-shell__head,
        .section-shell__body {
          padding: var(--s3);
        }

        .hero {
          padding-top: var(--s3);
        }

        .hero__grid {
          padding: var(--s3);
        }

        .hero__media {
          min-height: 300px;
        }

        .hero__media img {
          width: min(76%, 290px);
          max-height: 330px;
        }

        .badge {
          font-size: 0.68rem;
          line-height: 1.2;
        }

        .hero h1 {
          max-width: 100%;
        }

        .hero-meta {
          width: calc(100% - 20px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header
      name={profile.name}
      showAwards={profile.awards.length > 0}
      mode={navigationMode}
    />
    <main id="main-content">
      <slot />
    </main>
    <Footer profile={profile} mode={navigationMode} />

    <script>
      import { initMotion } from '../lib/motion';

      initMotion();
    </script>
  </body>
</html>
