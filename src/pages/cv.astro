---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../content/profile';
---

<BaseLayout title={`${profile.name} | Nursing CV`} description={profile.profileSummary}>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">Professional CV</p>
          <h1>{profile.name}</h1>
          <p class="site-page__lede">NNC-licensed Registered Nurse, active Texas RN, and maternal-health Research Assistant based in Biratnagar, Nepal.</p>
          <div class="site-actions">
            <a class="site-button site-button--primary" href={`mailto:${profile.contact.email}`}>Email Reeja</a>
            <button class="site-button" type="button" onclick="window.print()">Print / Save PDF</button>
          </div>
        </div>
        <dl class="site-page__summary">
          <div><dt>Current role</dt><dd>Research Assistant, IISH MOM-HD</dd></div>
          <div><dt>Clinical background</dt><dd>TUTH, MMTH, and Sindhuli Hospital</dd></div>
          <div><dt>Education</dt><dd>B.Sc. Nursing</dd></div>
          <div><dt>Location</dt><dd>Biratnagar, Nepal</dd></div>
        </dl>
      </div>
    </section>

    <section class="site-section">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Profile</p><h2>Clinical care with research discipline.</h2></div>
        <p>{profile.profileSummary}</p>
      </div>
    </section>

    <section class="site-section site-section--soft">
      <div class="container">
        <div class="site-section__head"><div><p class="site-eyebrow">Experience</p><h2>Clinical and research roles.</h2></div></div>
        <div class="site-list">
          {profile.experience.map((item) => (
            <article class="site-list__item">
              <div><h3>{item.role}</h3><p>{item.organization}</p></div>
              <div><ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul></div>
              <p class="site-list__meta">{item.period}<br />{item.location}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head"><div><p class="site-eyebrow">Credentials</p><h2>Licenses and training.</h2></div><p>Verification documents are available privately to legitimate employers.</p></div>
        <div class="site-grid">
          {profile.certifications.map((item) => (
            <article class="site-card"><h3>{item.title}</h3><p><strong>{item.issuer}</strong><br />{item.date}</p><p>{item.note}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--soft">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Education</p><h2>Academic background.</h2></div>
        <dl class="site-page__summary">
          {profile.education.map((item) => <div><dt>{item.period}</dt><dd>{item.level}<br />{item.institution}<br />{item.result}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Contact</p><h2>Discuss a nursing or research opportunity.</h2><p>Share the role, organisation, location, start date, and responsibilities.</p></div>
        <div class="site-actions"><a class="site-button" href={`mailto:${profile.contact.email}`}>Email Reeja</a><a class="site-button" href="/hire-reeja/">Recruiter profile</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
