---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../content/profile';
import { professionalFacts } from '../content/professional-facts';
import '../styles/home-redesign.css';
import '../styles/home-seo.css';

const focusAreas = [
  {
    number: '01',
    title: 'Maternal health research',
    copy: 'Participant screening, BP/BG monitoring education, tele-follow-up, study documentation, and protocol-based escalation.'
  },
  {
    number: '02',
    title: 'Clinical nursing',
    copy: 'Hospital experience in maternal-newborn care, general wards, surgery, gynaecology and obstetrics, documentation, and handover.'
  },
  {
    number: '03',
    title: 'Patient education',
    copy: 'Clear counselling on home monitoring, warning signs, treatment adherence, follow-up, and family support.'
  },
  {
    number: '04',
    title: 'Care coordination',
    copy: 'Reliable documentation, data review, device logistics, confidentiality, and multidisciplinary communication.'
  }
];

const hiringStrengths = [
  professionalFacts.nepalLicense,
  professionalFacts.texasLicense,
  'Hospital experience in Nepal',
  `${professionalFacts.currentEmployerShort} ${professionalFacts.currentProjectShort} ${professionalFacts.currentRole}`,
  'Maternal-newborn and telemonitoring experience',
  'Nepali, Newari, English, and Hindi communication'
];

const featuredWriting = [
  {
    category: 'Maternal care',
    title: 'Essential maternal and newborn care guide',
    href: '/blog/essential-maternal-newborn-care-guide-2026/'
  },
  {
    category: 'Clinical practice',
    title: 'SBAR handover and nursing documentation',
    href: '/blog/mastering-nursing-documentation-sbar-handover/'
  },
  {
    category: 'Digital health',
    title: 'Telehealth and community nursing in Nepal',
    href: '/blog/future-of-nursing-in-nepal-telehealth-community-care-post-covid/'
  }
];

const emailSubject = encodeURIComponent(`Nursing or research opportunity for ${professionalFacts.name}`);
---

<BaseLayout
  title={`${professionalFacts.name} | ${professionalFacts.primaryRole}`}
  description={`${professionalFacts.name} is a ${professionalFacts.nepalLicense}, ${professionalFacts.texasLicense}, and ${professionalFacts.currentRole} with hospital, telemonitoring, patient education, and clinical research experience.`}
>
  <div class="home-v2">
    <section class="home-hero" id="home" aria-labelledby="home-title">
      <div class="container home-hero__grid">
        <div class="home-hero__content">
          <p class="home-kicker">Registered Nurse in Nepal · Maternal Health Research</p>
          <p class="home-hero__name">{professionalFacts.name}, {professionalFacts.credential}</p>
          <h1 id="home-title">
            <span>Registered nurse.</span>
            <span>Research ready.</span>
          </h1>
          <p class="home-hero__intro">
            {professionalFacts.nepalLicense} and {professionalFacts.texasLicense}, with hospital experience and current work on the {professionalFacts.currentProject} in {professionalFacts.locationLocality}.
          </p>

          <div class="home-actions" aria-label="Primary actions">
            <a class="home-button home-button--dark" href="/hire-reeja/" data-track="home-hire">Hire Reeja</a>
            <a class="home-button home-button--light" href={professionalFacts.publicCvPath} data-track="home-cv">View CV</a>
          </div>

          <ul class="home-proof" aria-label="Professional highlights">
            <li>{professionalFacts.nepalLicenseShort}</li>
            <li>{professionalFacts.texasLicenseShort}</li>
            <li>{professionalFacts.currentEmployerShort} research assistant</li>
          </ul>
        </div>

        <dl class="home-hero__summary" aria-label="Professional summary">
          <div><dt>Current role</dt><dd>{professionalFacts.currentRole}, {professionalFacts.currentEmployerShort} {professionalFacts.currentProjectShort}</dd></div>
          <div><dt>Experience</dt><dd>TUTH, MMTH, and Sindhuli Hospital</dd></div>
          <div><dt>Focus</dt><dd>Maternal health, clinical nursing, patient education, and research</dd></div>
          <div><dt>Location</dt><dd>{professionalFacts.currentLocation}</dd></div>
        </dl>
      </div>
    </section>

    <section class="home-marquee" aria-label="Professional expertise">
      <div class="container home-marquee__inner">
        <span>Registered nursing</span>
        <span>Maternal-newborn care</span>
        <span>HDP/GDM monitoring</span>
        <span>Patient education</span>
        <span>Clinical research</span>
      </div>
    </section>

    <section class="home-section" id="about" aria-labelledby="about-title">
      <div class="container home-two-column">
        <div class="home-section__heading">
          <p class="home-kicker">Profile</p>
          <h2 id="about-title">Clinical experience with research discipline.</h2>
        </div>

        <div class="home-about-copy">
          <p>
            {professionalFacts.name} is a {professionalFacts.credential} graduate, {professionalFacts.nepalLicense}, and {professionalFacts.texasLicense}. Her background includes maternal-newborn care, general ward nursing, patient counselling, documentation, structured handover, BP/BG telemonitoring, and clinical research coordination.
          </p>
          <dl class="home-facts">
            <div><dt>Current role</dt><dd>{professionalFacts.currentRole}, {professionalFacts.currentEmployer}</dd></div>
            <div><dt>Based in</dt><dd>{professionalFacts.currentLocation}</dd></div>
            <div><dt>Open to</dt><dd>{professionalFacts.availability}</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="home-section home-section--soft" id="experience" aria-labelledby="experience-title">
      <div class="container">
        <div class="home-section__topline">
          <div>
            <p class="home-kicker">Experience</p>
            <h2 id="experience-title">Hospital nursing and maternal-health research.</h2>
          </div>
          <a class="home-text-link" href={professionalFacts.publicCvPath}>View full CV <span aria-hidden="true">-&gt;</span></a>
        </div>

        <ol class="home-experience-list">
          {profile.experience.map((item, index) => (
            <li class="home-experience-item">
              <div class="home-experience-item__index">{String(index + 1).padStart(2, '0')}</div>
              <div class="home-experience-item__role">
                <h3>{item.role}</h3>
                <p>{item.organization}</p>
              </div>
              <div class="home-experience-item__details">
                <p>{item.bullets[0]}</p>
                <ul>{item.tags?.slice(0, 4).map((tag) => <li>{tag}</li>)}</ul>
              </div>
              <div class="home-experience-item__meta">
                <span>{item.period}</span>
                <span>{item.location}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="home-section" id="focus" aria-labelledby="focus-title">
      <div class="container">
        <div class="home-section__topline">
          <div>
            <p class="home-kicker">Core strengths</p>
            <h2 id="focus-title">Skills for care, research, and health programmes.</h2>
          </div>
          <p class="home-section__summary">Direct care, participant support, documentation, telemonitoring, and coordination.</p>
        </div>

        <div class="home-focus-grid">
          {focusAreas.map((area) => (
            <article class="home-focus-card">
              <span>{area.number}</span>
              <h3>{area.title}</h3>
              <p>{area.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section home-section--black" aria-labelledby="strengths-title">
      <div class="container home-strengths">
        <div>
          <p class="home-kicker home-kicker--inverse">Why hire Reeja</p>
          <h2 id="strengths-title">Qualified, careful, and dependable.</h2>
        </div>
        <ul class="home-strengths-list">{hiringStrengths.map((strength) => <li>{strength}</li>)}</ul>
      </div>
    </section>

    <section class="home-section" id="credentials" aria-labelledby="credentials-title">
      <div class="container">
        <div class="home-section__topline">
          <div>
            <p class="home-kicker">Credentials</p>
            <h2 id="credentials-title">Licenses and clinical training.</h2>
          </div>
          <p class="home-section__summary">Verification documents are shared privately with legitimate employers and recruiters.</p>
        </div>

        <div class="home-credential-list">
          {profile.certifications.slice(0, 6).map((credential) => (
            <article class="home-credential-item">
              <div><p>{credential.issuer}</p><h3>{credential.title}</h3></div>
              <div><p>{credential.date}</p><span>{credential.credentialLabel ?? 'Verification available on request'}</span></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section home-section--soft" id="writing" aria-labelledby="writing-title">
      <div class="container">
        <div class="home-section__topline">
          <div>
            <p class="home-kicker">Nursing resources</p>
            <h2 id="writing-title">Practical guides for patients, families, and nurses.</h2>
          </div>
          <a class="home-text-link" href="/blog/">Browse articles <span aria-hidden="true">-&gt;</span></a>
        </div>

        <div class="home-writing-grid">
          {featuredWriting.map((article) => (
            <a class="home-writing-card" href={article.href}>
              <span>{article.category}</span>
              <h3>{article.title}</h3>
              <small>Read guide <span aria-hidden="true">-&gt;</span></small>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-contact" id="contact" aria-labelledby="contact-title">
      <div class="container home-contact__grid">
        <div>
          <p class="home-kicker home-kicker--inverse">Recruitment</p>
          <h2 id="contact-title">Hiring a nurse or research professional?</h2>
        </div>

        <div class="home-contact__content">
          <p>Send the role, organisation, location, start date, and a short description of the work.</p>
          <div class="home-contact__actions">
            <a class="home-button home-button--white" href={`mailto:${professionalFacts.professionalEmail}?subject=${emailSubject}`} data-track="contact-email">Email Reeja</a>
            <a class="home-button home-button--outline" href={professionalFacts.linkedin} target="_blank" rel="noopener noreferrer" data-track="contact-linkedin">LinkedIn</a>
          </div>
          <a class="home-contact__email" href={`mailto:${professionalFacts.professionalEmail}`}>{professionalFacts.professionalEmail}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
