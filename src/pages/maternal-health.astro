---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPosts } from '../content/blog';
import '../styles/traffic-pages.css';

const posts = blogPosts.filter((post) =>
  [post.primaryKeyword, ...post.supportingKeywords, ...post.tags]
    .join(' ')
    .toLowerCase()
    .match(/maternal|newborn|postnatal|breastfeeding|pregnan|mother/)
);
---

<BaseLayout
  title="Maternal Health and Newborn Care Guides | Nurse-Led Resources"
  description="Read nurse-led maternal health and newborn care guides covering postnatal care, breastfeeding support, maternal and newborn warning signs, family education, and when to seek urgent medical help."
>
  <div class="traffic-page">
    <section class="traffic-hero">
      <div class="container traffic-hero__grid">
        <div>
          <p class="traffic-eyebrow">Maternal health and newborn care resources</p>
          <h1>Practical maternal and newborn care guidance for families.</h1>
          <p class="traffic-lede">Nurse-led educational resources on postnatal recovery, breastfeeding, newborn care, maternal warning signs, newborn danger signs, and safe decisions about when to contact a qualified healthcare professional.</p>
        </div>
        <aside class="traffic-summary">
          <h2>Topics covered</h2>
          <ul>
            <li>Maternal recovery and postnatal care</li>
            <li>Newborn feeding, warmth, hygiene, and observation</li>
            <li>Breastfeeding support and common early concerns</li>
            <li>Maternal and newborn danger signs requiring urgent care</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="traffic-section">
      <div class="container">
        <div class="traffic-section__heading">
          <p class="traffic-eyebrow">Nurse-led educational articles</p>
          <h2>Maternal health and newborn care guides</h2>
          <p>Each article is written for education and general awareness. The guidance does not diagnose illness or replace direct assessment by a doctor, nurse, midwife, or emergency service.</p>
        </div>
        <div class="traffic-grid">
          {posts.map((post) => (
            <article class="traffic-card">
              <p class="traffic-eyebrow">{post.readMinutes} minute guide</p>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <a href={`/blog/${post.slug}/`}>Read maternal-health guide</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="traffic-section traffic-dark">
      <div class="container traffic-split">
        <div>
          <p class="traffic-eyebrow">Maternal-health nursing and research</p>
          <h2>Looking for a registered nurse with maternal-health experience?</h2>
          <p>Review Reeja Maharjan's hospital nursing background, IISH MOM-HD research experience, professional licenses, CV, and recruiter contact information.</p>
        </div>
        <div class="traffic-actions">
          <a class="traffic-button" href="/hire-reeja/">View recruiter profile</a>
          <a class="traffic-button" href="/clinical-research/">Explore maternal-health research work</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
