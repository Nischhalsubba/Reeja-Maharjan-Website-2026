---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPosts } from '../content/blog';

const posts = blogPosts.filter((post) =>
  [post.primaryKeyword, ...post.supportingKeywords, ...post.tags]
    .join(' ')
    .toLowerCase()
    .match(/maternal|newborn|postnatal|breastfeeding|pregnan|mother/)
);
---

<BaseLayout
  title="Maternal Health and Newborn Care Guides | Reeja Maharjan"
  description="Nurse-led maternal health and newborn care guides on postnatal recovery, breastfeeding, warning signs, family education, and when to seek clinical care."
>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">Maternal health</p>
          <h1>Clear guidance for mothers and newborns.</h1>
          <p class="site-page__lede">Practical, nurse-led education on postnatal recovery, breastfeeding, newborn care, warning signs, and safe decisions about seeking help.</p>
        </div>
        <dl class="site-page__summary">
          <div><dt>Audience</dt><dd>Pregnant women, new mothers, families, and caregivers</dd></div>
          <div><dt>Focus</dt><dd>Maternal recovery, newborn care, feeding, and danger signs</dd></div>
          <div><dt>Safety</dt><dd>Education only, not diagnosis or emergency care</dd></div>
        </dl>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Featured guides</p><h2>Maternal and newborn care resources.</h2></div>
          <p>Each guide is written for general education and should be used alongside advice from qualified healthcare professionals.</p>
        </div>
        <div class="site-grid">
          {posts.map((post) => (
            <article class="site-card">
              <p class="site-eyebrow">{post.readMinutes} min read</p>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <p><a href={`/blog/${post.slug}/`}>Read guide</a></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Professional profile</p><h2>Maternal-health nursing and research experience.</h2><p>Review Reeja's hospital background, MOM-HD research work, licenses, and availability.</p></div>
        <div class="site-actions"><a class="site-button" href="/clinical-research/">Research experience</a><a class="site-button" href="/hire-reeja/">Hire Reeja</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
