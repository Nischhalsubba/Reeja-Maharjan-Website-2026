---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../content/profile';
import { professionalFacts } from '../content/professional-facts';

const emailSubject = encodeURIComponent(`Nursing or Research Opportunity for ${professionalFacts.name}`);
const hiringSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: professionalFacts.lastVerified,
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://reejamaharjan.com.np/#person',
    name: professionalFacts.name,
    jobTitle: professionalFacts.primaryRole,
    description: profile.profileSummary,
    email: professionalFacts.professionalEmail,
    url: 'https://reejamaharjan.com.np/hire-reeja/',
    sameAs: [professionalFacts.linkedin, professionalFacts.instagram].filter(Boolean)
  }
};
---

<BaseLayout
  title={`${professionalFacts.name} | Nursing and Research Opportunities`}
  description={`Review ${professionalFacts.name}'s fit for nursing, maternal-health research, and health-programme opportunities. ${professionalFacts.nepalLicense}, ${professionalFacts.texasLicenseShort}, and current ${professionalFacts.currentRole} experience.`}
>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">Professional opportunities</p>
          <h1>Discuss a nursing or research opportunity with {professionalFacts.name}.</h1>
          <p class="site-page__lede">{professionalFacts.nepalLicense}, {professionalFacts.texasLicenseShort}, and {professionalFacts.currentEmployerShort} {professionalFacts.currentProjectShort} {professionalFacts.currentRole} with hospital, maternal-health, documentation, and telemonitoring experience.</p>
          <div class="site-actions">
            <a class="site-button site-button--primary" href={`mailto:${professionalFacts.professionalEmail}?subject=${emailSubject}`} data-track="hire-email">Share opportunity details</a>
            <a class="site-button" href={professionalFacts.publicCvPath} data-track="hire-cv">View CV</a>
            <a class="site-button" href={professionalFacts.linkedin} target="_blank" rel="noopener noreferrer" data-track="hire-linkedin">LinkedIn</a>
          </div>
        </div>
        <dl class="site-page__summary">
          <div><dt>Registration</dt><dd>{professionalFacts.nepalLicenseShort}</dd></div>
          <div><dt>International license</dt><dd>{professionalFacts.texasLicenseShort}</dd></div>
          <div><dt>Current role</dt><dd>{professionalFacts.currentRole}, {professionalFacts.currentEmployerShort} {professionalFacts.currentProjectShort}</dd></div>
          <div><dt>Based in</dt><dd>{professionalFacts.currentLocation}</dd></div>
        </dl>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Role fit</p><h2>Clinical care, research, and health programmes.</h2></div>
          <p>Best suited to roles where patient safety, communication, documentation, participant support, and dependable coordination matter.</p>
        </div>
        <div class="site-grid">
          {profile.roleFit.map((item) => (
            <article class="site-card"><h3>{item.title}</h3><p>{item.summary}</p><ul>{item.evidence.map((evidence) => <li>{evidence}</li>)}</ul></article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--soft">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Experience</p><h2>Hospital nursing and implementation research.</h2></div>
          <p>Experience includes patient care, counselling, documentation, handover, screening, home-monitoring education, follow-up, and escalation support.</p>
        </div>
        <div class="site-list">
          {profile.experience.map((item) => (
            <article class="site-list__item">
              <div><h3>{item.role}</h3><p>{item.organization}</p></div>
              <p>{item.bullets[0]}</p>
              <p class="site-list__meta">{item.period}<br />{item.location}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Credentials</p><h2>Licenses and clinical training.</h2></div>
          <p>Sensitive documents are not published. Verification can be shared privately with legitimate employers.</p>
        </div>
        <div class="site-grid">
          {profile.certifications.slice(0, 6).map((item) => (
            <article class="site-card"><h3>{item.title}</h3><p><strong>{item.issuer}</strong><br />{item.date}</p><p>{item.note}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Contact</p><h2>Share the opportunity details.</h2><p>Include the organisation, location, start date, employment type, and responsibilities.</p></div>
        <div class="site-actions"><a class="site-button" href={`mailto:${professionalFacts.professionalEmail}?subject=${emailSubject}`} data-track="hire-bottom-email">Share opportunity details</a><a class="site-button" href={professionalFacts.publicCvPath}>View CV</a></div>
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(hiringSchema)}></script>
</BaseLayout>
