---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../content/profile';
import { professionalFacts } from '../content/professional-facts';
import { siteCopy } from '../content/site-copy';

const copy = siteCopy.hire;
const hiringSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: siteCopy.updatedAt,
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://reejamaharjan.com.np/#person',
    name: professionalFacts.name,
    jobTitle: professionalFacts.primaryRole,
    description: siteCopy.profileSummary,
    email: professionalFacts.professionalEmail,
    url: 'https://reejamaharjan.com.np/',
    sameAs: [professionalFacts.linkedin, professionalFacts.instagram].filter(Boolean)
  }
};
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">{copy.eyebrow}</p>
          <h1>{copy.heading}</h1>
          <p class="site-page__lede">{copy.lede}</p>
          <div class="site-actions">
            <a class="site-button site-button--primary" href="/contact/" data-track="hire-contact">Contact Reeja</a>
            <a class="site-button" href={professionalFacts.publicCvPath} data-track="hire-cv">View Reeja’s CV</a>
            <a class="site-button" href={professionalFacts.linkedin} target="_blank" rel="noopener noreferrer" data-track="hire-linkedin">LinkedIn profile</a>
          </div>
        </div>
        <dl class="site-page__summary">
          <div><dt>Nepal registration</dt><dd>{professionalFacts.nepalLicenseShort}</dd></div>
          <div><dt>Texas license</dt><dd>{professionalFacts.texasLicenseShort}</dd></div>
          <div><dt>Current work</dt><dd>{professionalFacts.currentRole}, {professionalFacts.currentEmployerShort} · {professionalFacts.currentProjectShort}</dd></div>
          <div><dt>Based in</dt><dd>{professionalFacts.currentLocation}</dd></div>
        </dl>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">{copy.roleFitEyebrow}</p><h2>{copy.roleFitHeading}</h2></div>
          <p>{copy.roleFitSummary}</p>
        </div>
        <div class="site-grid">
          {siteCopy.home.focus.areas.map((item) => (
            <article class="site-card">
              <p class="site-eyebrow">{item.label}</p>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <ul>{item.evidence.map((evidence) => <li>{evidence}</li>)}</ul>
              <p><a href={item.href}>{item.cta}</a></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--soft">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">{copy.experienceEyebrow}</p><h2>{copy.experienceHeading}</h2></div>
          <p>{copy.experienceSummary}</p>
        </div>
        <div class="site-list">
          {profile.experience.map((item) => (
            <article class="site-list__item">
              <div><h3>{item.role}</h3><p>{item.organization}</p></div>
              <p>{item.bullets[0]}</p>
              <p class="site-list__meta">{item.period}<br />{item.location}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">{copy.credentialsEyebrow}</p><h2>{copy.credentialsHeading}</h2></div>
          <p>{copy.credentialsSummary}</p>
        </div>
        <div class="site-grid">
          {profile.certifications.slice(0, 6).map((item) => (
            <article class="site-card"><h3>{item.title}</h3><p><strong>{item.issuer}</strong><br />{item.date}</p><p>{item.note}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">{copy.closingEyebrow}</p><h2>{copy.closingHeading}</h2><p>{copy.closingSummary}</p></div>
        <div class="site-actions"><a class="site-button" href="/contact/" data-track="hire-bottom-contact">Send Reeja a message</a><a class="site-button" href={professionalFacts.publicCvPath}>View Reeja’s CV</a></div>
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(hiringSchema)}></script>
</BaseLayout>
