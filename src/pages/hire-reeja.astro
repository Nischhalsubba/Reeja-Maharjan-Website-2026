---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../content/profile';
import '../styles/traffic-pages.css';

const emailSubject = encodeURIComponent('Registered Nurse or Clinical Research Opportunity for Reeja Maharjan');
const hiringSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: '2026-07-12',
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://reejamaharjan.com.np/#person',
    name: profile.name,
    jobTitle: profile.role,
    description: profile.profileSummary,
    email: profile.contact.email,
    url: 'https://reejamaharjan.com.np/hire-reeja/',
    sameAs: [profile.contact.linkedin, profile.contact.instagram].filter(Boolean)
  }
};
---

<BaseLayout
  title="Hire Reeja Maharjan | Registered Nurse in Nepal"
  description="Hire Reeja Maharjan, an NNC-licensed Registered Nurse in Nepal, active Texas RN, and maternal-health Research Assistant with hospital and clinical research experience."
>
  <div class="traffic-page">
    <section class="traffic-hero">
      <div class="container traffic-hero__grid">
        <div>
          <p class="traffic-eyebrow">Recruiter profile</p>
          <h1>Hire Reeja Maharjan.</h1>
          <p class="traffic-lede">Registered Nurse in Nepal, active Texas RN, and IISH MOM-HD Research Assistant with hospital, maternal-health, telemonitoring, and documentation experience.</p>
          <div class="traffic-actions">
            <a class="traffic-button traffic-button--primary" href={`mailto:${profile.contact.email}?subject=${emailSubject}`} data-track="hire-email">Email Reeja</a>
            <a class="traffic-button" href={profile.contact.resumeUrl} download data-track="hire-cv">Download CV</a>
            <a class="traffic-button" href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer" data-track="hire-linkedin">LinkedIn</a>
          </div>
        </div>
        <aside class="traffic-summary">
          <h2>At a glance</h2>
          <ul>
            <li>NNC-licensed Registered Nurse</li>
            <li>Active Texas RN</li>
            <li>IISH MOM-HD Research Assistant</li>
            <li>Hospital experience at TUTH, MMTH, and Sindhuli Hospital</li>
            <li>Based in Biratnagar, Nepal</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="traffic-section">
      <div class="container">
        <div class="traffic-section__heading">
          <p class="traffic-eyebrow">Role fit</p>
          <h2>Best suited to nursing and health-research roles.</h2>
          <p>Strongest where patient safety, communication, documentation, participant support, and dependable coordination matter.</p>
        </div>
        <div class="traffic-grid">
          {profile.roleFit.map((item) => (
            <article class="traffic-card">
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <ul class="traffic-list">{item.evidence.map((evidence) => <li>{evidence}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="traffic-section">
      <div class="container traffic-split">
        <div class="traffic-section__heading">
          <p class="traffic-eyebrow">Experience</p>
          <h2>Clinical care and implementation research.</h2>
          <p>Experience includes direct patient care, participant screening, home-monitoring education, tele-follow-up, documentation, and escalation support.</p>
        </div>
        <dl class="traffic-facts">
          {profile.experience.map((item) => (
            <div>
              <dt>{item.role}</dt>
              <dd><strong>{item.organization}</strong><br />{item.period}<br />{item.location}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="traffic-section">
      <div class="container">
        <div class="traffic-section__heading">
          <p class="traffic-eyebrow">Credentials</p>
          <h2>Licenses and clinical training.</h2>
          <p>Verification documents are available privately to legitimate employers and recruiters.</p>
        </div>
        <div class="traffic-grid">
          {profile.certifications.slice(0, 6).map((item) => (
            <article class="traffic-card">
              <h3>{item.title}</h3>
              <p><strong>{item.issuer}</strong><br />{item.date}</p>
              <p>{item.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="traffic-section traffic-dark">
      <div class="container traffic-split">
        <div>
          <p class="traffic-eyebrow">Contact</p>
          <h2>Share the role details.</h2>
          <p>Include the organisation, location, start date, employment type, and responsibilities.</p>
        </div>
        <div class="traffic-actions">
          <a class="traffic-button" href={`mailto:${profile.contact.email}?subject=${emailSubject}`} data-track="hire-bottom-email">Email Reeja</a>
          <a class="traffic-button" href="/clinical-research/">Research experience</a>
        </div>
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(hiringSchema)}></script>
</BaseLayout>
