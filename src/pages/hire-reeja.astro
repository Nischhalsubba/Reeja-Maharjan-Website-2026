---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../content/profile';

const emailSubject = encodeURIComponent('Nursing or Research Opportunity for Reeja Maharjan');
const hiringSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: '2026-07-12',
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://reejamaharjan.com.np/#person',
    name: profile.name,
    jobTitle: profile.role,
    description: profile.profileSummary,
    email: profile.contact.email,
    url: 'https://reejamaharjan.com.np/hire-reeja/',
    sameAs: [profile.contact.linkedin, profile.contact.instagram].filter(Boolean)
  }
};
---

<BaseLayout
  title="Hire Reeja Maharjan | Registered Nurse in Nepal"
  description="Hire Reeja Maharjan, an NNC-licensed Registered Nurse, active Texas RN, and maternal-health Research Assistant with hospital and clinical research experience."
>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">Recruiter profile</p>
          <h1>Hire Reeja Maharjan.</h1>
          <p class="site-page__lede">Registered Nurse in Nepal, active Texas RN, and IISH MOM-HD Research Assistant with hospital, maternal-health, documentation, and telemonitoring experience.</p>
          <div class="site-actions">
            <a class="site-button site-button--primary" href={`mailto:${profile.contact.email}?subject=${emailSubject}`} data-track="hire-email">Email Reeja</a>
            <a class="site-button" href={profile.contact.resumeUrl} download data-track="hire-cv">Download CV</a>
            <a class="site-button" href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer" data-track="hire-linkedin">LinkedIn</a>
          </div>
        </div>
        <dl class="site-page__summary">
          <div><dt>Registration</dt><dd>Nepal Nursing Council RN</dd></div>
          <div><dt>International license</dt><dd>Active Texas RN</dd></div>
          <div><dt>Current role</dt><dd>Research Assistant, IISH MOM-HD</dd></div>
          <div><dt>Based in</dt><dd>Biratnagar, Nepal</dd></div>
        </dl>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Role fit</p><h2>Clinical care, research, and health programmes.</h2></div>
          <p>Best suited to roles where patient safety, communication, documentation, participant support, and dependable coordination matter.</p>
        </div>
        <div class="site-grid">
          {profile.roleFit.map((item) => (
            <article class="site-card"><h3>{item.title}</h3><p>{item.summary}</p><ul>{item.evidence.map((evidence) => <li>{evidence}</li>)}</ul></article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--soft">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Experience</p><h2>Hospital nursing and implementation research.</h2></div>
          <p>Experience includes patient care, counselling, documentation, handover, screening, home-monitoring education, follow-up, and escalation support.</p>
        </div>
        <div class="site-list">
          {profile.experience.map((item) => (
            <article class="site-list__item">
              <div><h3>{item.role}</h3><p>{item.organization}</p></div>
              <p>{item.bullets[0]}</p>
              <p class="site-list__meta">{item.period}<br />{item.location}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Credentials</p><h2>Licenses and clinical training.</h2></div>
          <p>Sensitive documents are not published. Verification can be shared privately with legitimate employers.</p>
        </div>
        <div class="site-grid">
          {profile.certifications.slice(0, 6).map((item) => (
            <article class="site-card"><h3>{item.title}</h3><p><strong>{item.issuer}</strong><br />{item.date}</p><p>{item.note}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Contact</p><h2>Share the role details.</h2><p>Include the organisation, location, start date, employment type, and responsibilities.</p></div>
        <div class="site-actions"><a class="site-button" href={`mailto:${profile.contact.email}?subject=${emailSubject}`} data-track="hire-bottom-email">Email Reeja</a><a class="site-button" href="/cv/">View CV</a></div>
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(hiringSchema)}></script>
</BaseLayout>
