---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../content/profile';
import '../styles/traffic-pages.css';

const emailSubject = encodeURIComponent('Registered Nurse or Clinical Research Opportunity for Reeja Maharjan');
const hiringSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: '2026-07-12',
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://reejamaharjan.com.np/#person',
    name: profile.name,
    jobTitle: profile.role,
    description: profile.profileSummary,
    email: profile.contact.email,
    url: 'https://reejamaharjan.com.np/hire-reeja/',
    sameAs: [profile.contact.linkedin, profile.contact.instagram].filter(Boolean)
  }
};
---

<BaseLayout
  title="Hire Reeja Maharjan | Registered Nurse and Clinical Research Assistant"
  description="Recruit Reeja Maharjan, an NNC-licensed Registered Nurse, active Texas RN, and maternal-health Research Assistant with hospital nursing, telemonitoring, patient education, documentation, and clinical research experience."
>
  <div class="traffic-page">
    <section class="traffic-hero">
      <div class="container traffic-hero__grid">
        <div>
          <p class="traffic-eyebrow">Registered nurse recruitment profile</p>
          <h1>Hire a registered nurse with hospital and maternal-health research experience.</h1>
          <p class="traffic-lede">Reeja Maharjan is an NNC-licensed Registered Nurse, active Texas RN, and IISH MOM-HD Research Assistant. Her experience includes maternal-newborn care, general ward nursing, patient and family education, BP/BG telemonitoring, clinical documentation, study coordination, and protocol-based escalation.</p>
          <div class="traffic-actions">
            <a class="traffic-button traffic-button--primary" href={`mailto:${profile.contact.email}?subject=${emailSubject}`} data-track="hire-email">Contact Reeja about a role</a>
            <a class="traffic-button" href={profile.contact.resumeUrl} download data-track="hire-cv">Download nursing CV</a>
            <a class="traffic-button" href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer" data-track="hire-linkedin">View LinkedIn profile</a>
          </div>
        </div>
        <aside class="traffic-summary">
          <h2>Recruiter summary</h2>
          <ul>
            <li>Nepal Nursing Council-licensed Registered Nurse</li>
            <li>Active Texas RN license and NCLEX-RN pathway experience</li>
            <li>Current Research Assistant on the IISH MOM-HD maternal telemonitoring trial</li>
            <li>Hospital experience at TUTH, MMTH, and Sindhuli Hospital</li>
            <li>Based in Biratnagar, Nepal</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="traffic-section">
      <div class="container">
        <div class="traffic-section__heading">
          <p class="traffic-eyebrow">Suitable nursing and health roles</p>
          <h2>Roles aligned with Reeja's clinical and research background</h2>
          <p>Her strongest fit is in work requiring patient safety, clear communication, accurate documentation, participant support, multidisciplinary coordination, and dependable follow-through.</p>
        </div>
        <div class="traffic-grid">
          {profile.roleFit.map((item) => (
            <article class="traffic-card">
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <ul class="traffic-list">{item.evidence.map((evidence) => <li>{evidence}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="traffic-section">
      <div class="container traffic-split">
        <div class="traffic-section__heading">
          <p class="traffic-eyebrow">Clinical and research experience</p>
          <h2>Registered nursing experience across hospitals and implementation research</h2>
          <p>Reeja combines direct patient-care experience with current maternal-health research responsibilities involving participant screening, home monitoring education, tele-follow-up, clinical documentation, data-quality review, and escalation coordination.</p>
        </div>
        <dl class="traffic-facts">
          {profile.experience.map((item) => (
            <div>
              <dt>{item.role}</dt>
              <dd><strong>{item.organization}</strong><br />{item.period}<br />{item.location}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="traffic-section">
      <div class="container">
        <div class="traffic-section__heading">
          <p class="traffic-eyebrow">Licenses, education, and clinical preparation</p>
          <h2>Professional credentials available for employer verification</h2>
          <p>Sensitive license documents are not published on the website. Verification records can be shared privately with legitimate hospitals, research organisations, NGOs, INGOs, and recruiters after initial screening.</p>
        </div>
        <div class="traffic-grid">
          {profile.certifications.slice(0, 6).map((item) => (
            <article class="traffic-card">
              <h3>{item.title}</h3>
              <p><strong>{item.issuer}</strong><br />{item.date}</p>
              <p>{item.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="traffic-section traffic-dark">
      <div class="container traffic-split">
        <div>
          <p class="traffic-eyebrow">Contact for recruitment</p>
          <h2>Discuss a registered nurse, maternal-health, or clinical-research opportunity.</h2>
          <p>Include the organisation, role title, work location, expected start date, employment type, and a short description of the responsibilities. This makes the first conversation useful, a surprisingly ambitious standard for recruitment messages.</p>
        </div>
        <div class="traffic-actions">
          <a class="traffic-button" href={`mailto:${profile.contact.email}?subject=${emailSubject}`} data-track="hire-bottom-email">Email role details</a>
          <a class="traffic-button" href="/clinical-research/">Review research experience</a>
        </div>
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(hiringSchema)}></script>
</BaseLayout>
