---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts } from '../../content/blog';
import '../../styles/blog.css';

const formatDate = (value: string) =>
  new Date(value).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const featuredPost = blogPosts[0];
const articleList = featuredPost ? blogPosts.filter((post) => post.slug !== featuredPost.slug) : blogPosts;
const topicGroups = [
  {
    label: 'Maternal health',
    href: '/maternal-health/',
    summary: 'Pregnancy, postnatal care, breastfeeding, newborn support, and warning signs.',
    pattern: /maternal|newborn|postnatal|breastfeeding|pregnan|mother/i
  },
  {
    label: 'Nursing practice',
    href: '/nursing-practice/',
    summary: 'Documentation, SBAR, confidentiality, clinical communication, and care continuity.',
    pattern: /nursing|documentation|sbar|handover|confidential|clinical communication/i
  },
  {
    label: 'Career and digital health',
    href: '/clinical-research/',
    summary: 'Licensure, telehealth, community nursing, research support, and programme readiness.',
    pattern: /career|license|licensure|telehealth|digital|research|community/i
  }
].map((topic) => ({
  ...topic,
  count: blogPosts.filter((post) => [post.primaryKeyword, ...post.supportingKeywords, ...post.tags, post.title].join(' ').match(topic.pattern)).length
}));
---

<BaseLayout
  title="Nursing and Maternal Health Articles | Reeja Maharjan"
  description="Nurse-led articles on maternal and newborn care, documentation, SBAR handover, confidentiality, telehealth, and nursing careers in Nepal."
>
  <div class="site-page blog-index">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">Articles</p>
          <h1>Practical nursing knowledge.</h1>
          <p class="site-page__lede">Evidence-informed guides for patients, families, nurses, students, and healthcare teams, organised for safer reading and clearer next steps.</p>
        </div>
        <dl class="site-page__summary">
          <div><dt>Maternal health</dt><dd>Pregnancy, postnatal care, breastfeeding, and newborn support</dd></div>
          <div><dt>Nursing practice</dt><dd>Documentation, SBAR, confidentiality, and communication</dd></div>
          <div><dt>Professional growth</dt><dd>Licensure, careers, digital health, and research readiness</dd></div>
        </dl>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Reading hub</p><h2>Start with the most useful guide, then browse by topic.</h2></div>
          <p>Each article keeps source links, review dates, and safety notes visible where clinical decisions are involved.</p>
        </div>

        <div class="blog-index__featured" data-reveal-group>
          {featuredPost && (
            <a class="blog-index__lead-card" href={`/blog/${featuredPost.slug}/`} data-reveal>
              <p class="site-eyebrow">Featured guide</p>
              <h3>{featuredPost.title}</h3>
              <p>{featuredPost.excerpt}</p>
              <p class="blog-card__meta"><span>{formatDate(featuredPost.publishedAt)}</span><span>{featuredPost.readMinutes} min read</span></p>
            </a>
          )}

          <aside class="blog-topic-panel" aria-labelledby="blog-topic-title" data-reveal>
            <p class="site-eyebrow">Topics</p>
            <h3 id="blog-topic-title">Find the right reading path.</h3>
            {topicGroups.map((topic) => (
              <div class="blog-topic-panel__item">
                <span class="blog-topic-panel__count">{String(topic.count).padStart(2, '0')}</span>
                <div>
                  <h4><a href={topic.href}>{topic.label}</a></h4>
                  <p>{topic.summary}</p>
                </div>
              </div>
            ))}
          </aside>
        </div>

        <div class="site-section__head">
          <div><p class="site-eyebrow">All articles</p><h2>Browse the full library.</h2></div>
        </div>

        <div class="blog-grid" data-reveal-group>
          {articleList.map((post) => (
            <article class="blog-card" data-reveal>
              <div>
                <p class="site-eyebrow">{post.tags[0]}</p>
                <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
                <p>{post.excerpt}</p>
              </div>
              <p class="blog-card__meta"><span>{formatDate(post.publishedAt)}</span><span>{post.readMinutes} min read</span></p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
