---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts } from '../../content/blog';

const posts = blogPosts;

const formatDate = (value: string) =>
  new Date(value).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="Nursing Articles on Maternal Health, Documentation and Careers"
  description="Read nurse-led articles on maternal and newborn care, nursing documentation, SBAR handover, patient confidentiality, clinical practice, telehealth, and nursing careers in Nepal."
>
  <section class="section blog-list">
    <div class="container section-stack">
      <div class="section-intro">
        <p class="section-intro__eyebrow">Nursing knowledge centre</p>
        <h1>Practical nursing and maternal-health articles</h1>
        <p>
          Evidence-informed guides for parents, nurses, nursing students, healthcare teams, and recruiters. Topics include maternal-newborn care, postnatal support, clinical documentation, SBAR handover, confidentiality, telehealth, and nursing career development.
        </p>
      </div>

      <div class="card-grid card-grid--1">
        {posts.map((post) => (
          <article class="card blog-card" data-card-link data-card-href={`/blog/${post.slug}/`}>
            <p class="blog-card__meta">
              <span>Published {formatDate(post.publishedAt)}</span>
              <span>{post.readMinutes} minute read</span>
            </p>
            <h2>{post.title}</h2>
            <p>{post.excerpt}</p>
            <ul class="chip-list">
              {post.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <p class="blog-card__keyword">
              <strong>Main topic:</strong> {post.primaryKeyword}
            </p>
            <a class="text-link" href={`/blog/${post.slug}/`}>Read the complete guide</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
