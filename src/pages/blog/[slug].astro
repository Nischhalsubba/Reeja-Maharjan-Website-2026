---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts, getBlogPost } from '../../content/blog';
import { profile } from '../../content/profile';

export const getStaticPaths = () =>
  blogPosts.map((post) => ({ params: { slug: post.slug } }));

const { slug } = Astro.params;
const post = slug ? getBlogPost(slug) : undefined;
if (!post) return Astro.redirect('/404');

const published = new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const updated = new Date(post.updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const articleUrl = new URL(`/blog/${post.slug}/`, Astro.site ?? Astro.url.origin).toString();
const articleImage = new URL('/reeja-headshot.jpg', Astro.site ?? Astro.url.origin).toString();
const authorUrl = new URL('/hire-reeja/', Astro.site ?? Astro.url.origin).toString();
const relatedPosts = post.relatedSlugs.map((relatedSlug) => blogPosts.find((candidate) => candidate.slug === relatedSlug)).filter(Boolean);
const topicText = [post.primaryKeyword, ...post.supportingKeywords, ...post.tags].join(' ').toLowerCase();
const topicHub = topicText.match(/maternal|newborn|postnatal|breastfeeding|pregnan|mother/)
  ? { href: '/maternal-health/', label: 'Maternal health resources' }
  : { href: '/nursing-practice/', label: 'Nursing practice resources' };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  url: articleUrl,
  headline: post.title,
  description: post.metaDescription,
  image: [articleImage],
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    '@id': 'https://reejamaharjan.com.np/#person',
    name: profile.name,
    jobTitle: profile.role,
    url: authorUrl,
    sameAs: [profile.contact.linkedin, profile.contact.instagram].filter(Boolean)
  },
  publisher: { '@id': 'https://reejamaharjan.com.np/#person' },
  keywords: [post.primaryKeyword, ...post.supportingKeywords]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: new URL('/blog/', Astro.site ?? Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 3, name: post.title, item: articleUrl }
  ]
};
---

<BaseLayout title={`${post.title} | Reeja Maharjan`} description={post.metaDescription} image="/reeja-headshot.jpg">
  <article class="section blog-post">
    <div class="container section-stack">
      <nav aria-label="Breadcrumb"><a class="text-link blog-post__back" href="/blog/">Back to writing</a></nav>

      <header class="section-intro">
        <p class="section-intro__eyebrow">Clinical Nursing Article</p>
        <h1>{post.title}</h1>
        <p>{post.excerpt}</p>
        <p class="blog-card__meta">
          <span>{published}</span><span>Reviewed {updated}</span><span>{post.readMinutes} min read</span>
        </p>
        <ul class="chip-list">{post.tags.map((tag) => <li>{tag}</li>)}</ul>
      </header>

      <div class="blog-post__layout">
        <aside class="card blog-post__aside">
          <div class="blog-post__quick-answer">
            <p class="section-intro__eyebrow">Quick answer</p>
            <ul>{post.quickAnswer.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div class="blog-post__toc">
            <p class="section-intro__eyebrow">On this page</p>
            <ol>{post.sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol>
          </div>
          <div class="blog-post__cta card">
            <h2>{post.cta.title}</h2>
            <p>{post.cta.text}</p>
            <a class="button button--primary" href={post.cta.href} data-track="article-cta">{post.cta.label}</a>
          </div>
        </aside>

        <div class="blog-post__main">
          <div class="card blog-post__content">{post.intro.map((paragraph) => <p>{paragraph}</p>)}</div>

          {post.sections.map((section) => (
            <section class="card blog-post__section" id={section.id}>
              <h2>{section.title}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets && <ul class="blog-post__list">{section.bullets.map((item) => <li>{item}</li>)}</ul>}
            </section>
          ))}

          <section class="card blog-post__author">
            <p class="section-intro__eyebrow">Author and review note</p>
            <h2>{profile.name}, {profile.role}</h2>
            <p>Reeja Maharjan is a registered nurse with experience in maternal-newborn support, general ward care, counselling, clinical documentation, research workflows, and safe handover. This article is educational and does not replace direct clinical assessment.</p>
            <p><a class="text-link" href="/hire-reeja/">View Reeja's professional profile</a></p>
            <ul class="chip-list"><li>NNC Licensed RN</li><li>Texas RN License Active</li><li>NCLEX-RN Cleared</li></ul>
            <p class="note">Last reviewed: {updated}</p>
          </section>

          <section class="card blog-post__related">
            <p class="section-intro__eyebrow">Explore the topic</p>
            <h2>{topicHub.label}</h2>
            <p>Browse connected guidance and professional resources instead of treating this article as an isolated page.</p>
            <a class="text-link" href={topicHub.href}>View topic hub</a>
          </section>

          <section class="card blog-post__faq">
            <p class="section-intro__eyebrow">FAQ</p>
            <h2>Frequently Asked Questions</h2>
            <div class="blog-post__faq-list">{post.faq.map((item) => <div class="blog-post__faq-item"><h3>{item.question}</h3><p>{item.answer}</p></div>)}</div>
          </section>

          <section class="card blog-post__sources">
            <p class="section-intro__eyebrow">Sources</p>
            <h2>Reputable References</h2>
            <ul class="blog-post__list">{post.sources.map((source) => <li><a href={source.href} target="_blank" rel="noreferrer">{source.label}</a></li>)}</ul>
          </section>

          <section class="card blog-post__disclaimer"><p class="section-intro__eyebrow">Safety note</p><p>{post.disclaimer}</p></section>

          {relatedPosts.length > 0 && (
            <section class="card blog-post__related">
              <p class="section-intro__eyebrow">Read next</p><h2>Related Articles</h2>
              <div class="card-grid card-grid--2">
                {relatedPosts.map((relatedPost) => relatedPost && (
                  <article class="card blog-card" data-card-link data-card-href={`/blog/${relatedPost.slug}/`}>
                    <h3>{relatedPost.title}</h3><p>{relatedPost.excerpt}</p><a class="text-link" href={`/blog/${relatedPost.slug}/`}>Read article</a>
                  </article>
                ))}
              </div>
            </section>
          )}
        </div>
      </div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </article>
</BaseLayout>
