---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleGovernance from '../../components/ArticleGovernance.astro';
import { blogPosts, getBlogPost } from '../../content/blog';
import { getBlogGovernance } from '../../content/blog/governance';
import { professionalFacts } from '../../content/professional-facts';

export const getStaticPaths = () =>
  blogPosts.map((post) => ({ params: { slug: post.slug } }));

const { slug } = Astro.params;
const post = slug ? getBlogPost(slug) : undefined;
if (!post) return Astro.redirect('/404');

const governance = getBlogGovernance(post.slug);
const articleUrl = new URL(`/blog/${post.slug}/`, Astro.site ?? Astro.url.origin).toString();
const articleImagePath = `/og/articles/${post.slug}.svg`;
const articleImage = new URL(articleImagePath, Astro.site ?? Astro.url.origin).toString();
const authorUrl = new URL('/hire-reeja/', Astro.site ?? Astro.url.origin).toString();
const relatedPosts = post.relatedSlugs
  .map((relatedSlug) => blogPosts.find((candidate) => candidate.slug === relatedSlug))
  .filter(Boolean);
const topicText = [post.primaryKeyword, ...post.supportingKeywords, ...post.tags].join(' ').toLowerCase();
const topicHub = topicText.match(/maternal|newborn|postnatal|breastfeeding|pregnan|mother/)
  ? { href: '/maternal-health/', label: 'Maternal health resources' }
  : { href: '/nursing-practice/', label: 'Nursing practice resources' };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  url: articleUrl,
  headline: post.title,
  description: post.metaDescription,
  image: {
    '@type': 'ImageObject',
    url: articleImage,
    width: 1200,
    height: 630
  },
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    '@id': 'https://reejamaharjan.com.np/#person',
    name: professionalFacts.name,
    jobTitle: professionalFacts.primaryRole,
    url: authorUrl,
    sameAs: [professionalFacts.linkedin, professionalFacts.instagram].filter(Boolean)
  },
  publisher: { '@id': 'https://reejamaharjan.com.np/#person' },
  keywords: [post.primaryKeyword, ...post.supportingKeywords]
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: new URL('/blog/', Astro.site ?? Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 3, name: post.title, item: articleUrl }
  ]
};
---

<BaseLayout title={`${post.title} | Reeja Maharjan`} description={post.metaDescription} image={articleImagePath}>
  <div class="site-page">
    <article class="site-article">
      <header class="site-article__header">
        <a class="site-back" href="/blog/">← Back to articles</a>
        <p class="site-eyebrow">Nurse-led education</p>
        <h1>{post.title}</h1>
        <p>{post.excerpt}</p>
        <div class="site-article__meta">
          <span>Published {post.publishedAt}</span>
          <span>Last updated {post.updatedAt}</span>
          <span>{post.readMinutes} min read</span>
        </div>
      </header>

      <div class="site-article__body">
        <ArticleGovernance publishedAt={post.publishedAt} updatedAt={post.updatedAt} governance={governance} />

        <section class="site-note">
          <p class="site-eyebrow">Key points</p>
          <ul>{post.quickAnswer.map((item) => <li>{item}</li>)}</ul>
        </section>

        <section>{post.intro.map((paragraph) => <p>{paragraph}</p>)}</section>

        {post.sections.map((section) => (
          <section id={section.id}>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
          </section>
        ))}

        <section>
          <p class="site-eyebrow">Frequently asked questions</p>
          <h2>Common questions</h2>
          {post.faq.map((item) => <div><h3>{item.question}</h3><p>{item.answer}</p></div>)}
        </section>

        <section>
          <p class="site-eyebrow">Sources</p>
          <h2>References and further reading</h2>
          <ul>{post.sources.map((source) => <li><a href={source.href} target="_blank" rel="noreferrer">{source.label}</a></li>)}</ul>
        </section>

        <section class="site-note">
          <p class="site-eyebrow">Medical safety note</p>
          <p>{post.disclaimer}</p>
        </section>

        <section>
          <p class="site-eyebrow">Author</p>
          <h2>{professionalFacts.name}</h2>
          <p>Registered Nurse with hospital and maternal-health research experience in patient education, documentation, telemonitoring, and care coordination.</p>
          <p><a href="/hire-reeja/">View professional profile</a> · <a href={topicHub.href}>{topicHub.label}</a></p>
        </section>

        {relatedPosts.length > 0 && (
          <section>
            <p class="site-eyebrow">Read next</p>
            <h2>Related articles</h2>
            <div class="site-grid">
              {relatedPosts.map((relatedPost) => relatedPost && (
                <article class="site-card"><h3>{relatedPost.title}</h3><p>{relatedPost.excerpt}</p><p><a href={`/blog/${relatedPost.slug}/`}>Read article</a></p></article>
              ))}
            </div>
          </section>
        )}
      </div>
    </article>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
</BaseLayout>
