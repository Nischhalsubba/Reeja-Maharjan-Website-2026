---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Reeja Maharjan"
  description="The requested page could not be found."
  robots="noindex, nofollow"
>
  <div class="site-page">
    <section class="site-page__hero site-empty">
      <div class="container">
        <p class="site-eyebrow">404</p>
        <h1>Page not found.</h1>
        <p class="site-page__lede">The page may have moved, changed, or never existed.</p>
        <div class="site-actions"><a class="site-button site-button--primary" href="/">Return home</a><a class="site-button" href="/blog/">Browse articles</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
