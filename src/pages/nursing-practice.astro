---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPosts } from '../content/blog';
import '../styles/traffic-pages.css';

const posts = blogPosts.filter((post) =>
  [post.primaryKeyword, ...post.supportingKeywords, ...post.tags]
    .join(' ')
    .toLowerCase()
    .match(/nursing|documentation|sbar|handover|confidential|licensure|student|general care/)
);
---

<BaseLayout
  title="Nursing Practice, Documentation and Career Resources | Reeja Maharjan"
  description="Practical nursing resources on documentation, SBAR handover, confidentiality, clinical practice, licensure, and professional development."
>
  <div class="traffic-page">
    <section class="traffic-hero">
      <div class="container traffic-hero__grid">
        <div>
          <p class="traffic-eyebrow">Nursing practice hub</p>
          <h1>Practical nursing knowledge for safer, clearer care.</h1>
          <p class="traffic-lede">Resources for nurses, students, and healthcare teams on documentation, handover, confidentiality, clinical routines, and career development.</p>
        </div>
        <aside class="traffic-summary">
          <h2>Core topics</h2>
          <ul>
            <li>SBAR and shift handover</li>
            <li>Clinical documentation</li>
            <li>Patient confidentiality</li>
            <li>Nursing careers and licensure</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="traffic-section">
      <div class="container">
        <div class="traffic-section__heading">
          <p class="traffic-eyebrow">Professional resources</p>
          <h2>Nursing practice articles</h2>
          <p>Grounded guidance focused on real clinical communication, patient safety, and professional readiness.</p>
        </div>
        <div class="traffic-grid">
          {posts.map((post) => (
            <article class="traffic-card">
              <p class="traffic-eyebrow">{post.readMinutes} min read</p>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <a href={`/blog/${post.slug}/`}>Read article</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="traffic-section traffic-dark">
      <div class="container traffic-split">
        <div>
          <p class="traffic-eyebrow">Work with Reeja</p>
          <h2>Hospital, research, NGO, and care-coordination roles.</h2>
          <p>See the experience and credentials most relevant to nursing and health-programme recruiters.</p>
        </div>
        <div class="traffic-actions">
          <a class="traffic-button" href="/hire-reeja/">Recruiter overview</a>
          <a class="traffic-button" href="/cv/">View CV</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
