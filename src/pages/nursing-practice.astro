---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPosts } from '../content/blog';
import '../styles/traffic-pages.css';

const posts = blogPosts.filter((post) =>
  [post.primaryKeyword, ...post.supportingKeywords, ...post.tags]
    .join(' ')
    .toLowerCase()
    .match(/nursing|documentation|sbar|handover|confidential|licensure|student|general care/)
);
---

<BaseLayout
  title="Nursing Practice Guides: Documentation, SBAR, Handover and Careers"
  description="Explore practical nursing guides on clinical documentation, SBAR handover, patient confidentiality, general care nursing, licensure, career development, and safer communication."
>
  <div class="traffic-page">
    <section class="traffic-hero">
      <div class="container traffic-hero__grid">
        <div>
          <p class="traffic-eyebrow">Nursing practice and professional development</p>
          <h1>Practical nursing guides for safer care and clearer communication.</h1>
          <p class="traffic-lede">Resources for nurses, nursing students, and healthcare teams covering clinical documentation, SBAR handover, patient confidentiality, general ward routines, licensure, and professional readiness.</p>
        </div>
        <aside class="traffic-summary">
          <h2>Core nursing topics</h2>
          <ul>
            <li>SBAR communication and shift handover</li>
            <li>Accurate and defensible clinical documentation</li>
            <li>Patient confidentiality and professional ethics</li>
            <li>Nursing careers, licensure, and continuing development</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="traffic-section">
      <div class="container">
        <div class="traffic-section__heading">
          <p class="traffic-eyebrow">Nursing education resources</p>
          <h2>Clinical nursing and career articles</h2>
          <p>These guides focus on practical communication, documentation, patient safety, professional accountability, and realistic nursing career preparation.</p>
        </div>
        <div class="traffic-grid">
          {posts.map((post) => (
            <article class="traffic-card">
              <p class="traffic-eyebrow">{post.readMinutes} minute guide</p>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <a href={`/blog/${post.slug}/`}>Read nursing practice guide</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="traffic-section traffic-dark">
      <div class="container traffic-split">
        <div>
          <p class="traffic-eyebrow">Registered nurse recruitment</p>
          <h2>Recruit for hospital nursing, research, or health-programme support.</h2>
          <p>Review Reeja Maharjan's clinical experience, nursing licenses, maternal-health research responsibilities, professional CV, and availability for relevant roles.</p>
        </div>
        <div class="traffic-actions">
          <a class="traffic-button" href="/hire-reeja/">View recruiter profile</a>
          <a class="traffic-button" href="/cv/">Download nursing CV</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
