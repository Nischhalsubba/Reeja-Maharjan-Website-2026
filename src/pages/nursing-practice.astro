---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPosts } from '../content/blog';
import { siteCopy } from '../content/site-copy';

const copy = siteCopy.nursing;
const posts = blogPosts.filter((post) =>
  [post.primaryKeyword, ...post.supportingKeywords, ...post.tags]
    .join(' ')
    .toLowerCase()
    .match(/nursing|documentation|sbar|handover|confidential|licensure|student|general care/)
);
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">{copy.eyebrow}</p>
          <h1>{copy.heading}</h1>
          <p class="site-page__lede">{copy.lede}</p>
        </div>
        <dl class="site-page__summary">
          {copy.summary.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">{copy.guidesEyebrow}</p><h2>{copy.guidesHeading}</h2></div>
          <p>{copy.guidesSummary}</p>
        </div>
        <div class="site-grid">
          {posts.map((post) => (
            <article class="site-card">
              <p class="site-eyebrow">By Reeja Maharjan · {post.readMinutes} min read</p>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <p><a href={`/blog/${post.slug}/`}>Read Reeja’s article</a></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">{copy.closingEyebrow}</p><h2>{copy.closingHeading}</h2><p>{copy.closingSummary}</p></div>
        <div class="site-actions"><a class="site-button" href="/cv/">View Reeja’s CV</a><a class="site-button" href="/contact/">Contact Reeja</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
