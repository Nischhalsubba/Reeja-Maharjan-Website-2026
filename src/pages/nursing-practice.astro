---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPosts } from '../content/blog';

const posts = blogPosts.filter((post) =>
  [post.primaryKeyword, ...post.supportingKeywords, ...post.tags]
    .join(' ')
    .toLowerCase()
    .match(/nursing|documentation|sbar|handover|confidential|licensure|student|general care/)
);
---

<BaseLayout
  title="Nursing Practice Guides | Documentation, SBAR and Careers"
  description="Practical nursing guides on documentation, SBAR handover, confidentiality, clinical communication, licensure, and professional development."
>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">Nursing practice</p>
          <h1>Safer care starts with clear practice.</h1>
          <p class="site-page__lede">Practical resources for nurses and students on documentation, SBAR handover, confidentiality, clinical communication, and career readiness.</p>
        </div>
        <dl class="site-page__summary">
          <div><dt>Communication</dt><dd>SBAR, shift handover, referrals, and escalation</dd></div>
          <div><dt>Documentation</dt><dd>Accurate, timely, and defensible clinical records</dd></div>
          <div><dt>Professional growth</dt><dd>Licensure, ethics, and career preparation</dd></div>
        </dl>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">Nursing resources</p><h2>Guides for clinical work and career growth.</h2></div>
          <p>Focused on practical habits that improve communication, continuity of care, professional accountability, and patient safety.</p>
        </div>
        <div class="site-grid">
          {posts.map((post) => (
            <article class="site-card">
              <p class="site-eyebrow">{post.readMinutes} min read</p>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <p><a href={`/blog/${post.slug}/`}>Read guide</a></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">Professional opportunities</p><h2>Planning a clinical, research, or health-programme role?</h2><p>Review Reeja's experience, credentials, and availability, then share the role details through the dedicated contact page.</p></div>
        <div class="site-actions"><a class="site-button" href="/cv/">View CV</a><a class="site-button" href="/contact/">Contact Reeja</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
