---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteCopy } from '../content/site-copy';

const copy = siteCopy.research;
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="site-page">
    <section class="site-page__hero">
      <div class="container site-page__hero-grid">
        <div>
          <p class="site-eyebrow">{copy.eyebrow}</p>
          <h1>{copy.heading}</h1>
          <p class="site-page__lede">{copy.lede}</p>
        </div>
        <dl class="site-page__summary">
          {copy.summary.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
        <div class="site-section__head">
          <div><p class="site-eyebrow">{copy.responsibilitiesEyebrow}</p><h2>{copy.responsibilitiesHeading}</h2></div>
          <p>{copy.responsibilitiesSummary}</p>
        </div>
        <div class="site-grid">
          {copy.responsibilities.map(([title, description]) => (
            <article class="site-card"><h3>{title}</h3><p>{description}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--soft">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">{copy.relevanceEyebrow}</p><h2>{copy.relevanceHeading}</h2><p>{copy.relevanceSummary}</p></div>
        <dl class="site-page__summary">
          <div><dt>Maternal health</dt><dd>HDP and GDM research workflows</dd></div>
          <div><dt>Digital health</dt><dd>Home monitoring, tele-follow-up, and mobile reporting</dd></div>
          <div><dt>Research support</dt><dd>Participant communication, records, logistics, and coordination</dd></div>
        </dl>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container site-page__split">
        <div><p class="site-eyebrow">{copy.closingEyebrow}</p><h2>{copy.closingHeading}</h2><p>{copy.closingSummary}</p></div>
        <div class="site-actions"><a class="site-button" href="/cv/">View Reeja’s CV</a><a class="site-button" href="/contact/">Contact Reeja</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
